// Written by scripts/page-html.mjs from ui/index.html and ui/favicon.svg: edit those, then
// run it. The gate fails when this is not what they say.

const PAGE_HTML: string = "<!doctype html>\n<html lang=\"en\">\n<head>\n<meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>bead-loop</title>\n<link rel=\"icon\" type=\"image/svg+xml\" href=\"favicon.svg\">\n<style>\n  /* Solarized dark (Ethan Schoonover), the whole page. The 16 names are kept so a\n     colour choice reads as the palette's own: base03 canvas, base02 panels, base01\n     for what can be dim, base0 for text, base1 for what must be read first. */\n  :root {\n    --base03: #002b36; --base02: #073642; --base01: #586e75; --base00: #657b83;\n    --base0: #839496; --base1: #93a1a1; --base2: #eee8d5; --base3: #fdf6e3;\n    --yellow: #b58900; --orange: #cb4b16; --red: #dc322f; --magenta: #d33682;\n    --violet: #6c71c4; --blue: #268bd2; --cyan: #2aa198; --green: #859900;\n    --bg: var(--base03); --panel: var(--base02); --ink: var(--base0); --bright: var(--base1); --muted: var(--base01);\n    --line: rgba(147, 161, 161, .14); --line-strong: rgba(147, 161, 161, .28);\n    --accent: var(--blue); --ok: var(--green); --warn: var(--yellow); --bad: var(--red); --busy: var(--cyan);\n    --worker: var(--cyan); --reviewer: var(--violet);\n    --mono: ui-monospace, \"JetBrains Mono\", SFMono-Regular, Menlo, Consolas, monospace;\n    --sans: system-ui, -apple-system, \"Segoe UI\", sans-serif;\n    --quick: .15s ease-out;\n  }\n  * { box-sizing: border-box; }\n  html { color-scheme: dark; scrollbar-color: var(--base01) transparent; }\n  body { margin: 0; background: var(--bg); color: var(--ink); font: 14.5px/1.5 var(--sans); }\n  a { color: var(--accent); text-decoration: none; } a:hover { text-decoration: underline; }\n  b, strong { color: var(--bright); font-weight: 600; }\n  :focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }\n  @media (prefers-reduced-motion: reduce) { *, *::before, *::after { animation: none !important; transition: none !important; } }\n\n  /* header: one bar, the units separated by rules */\n  header { position: sticky; top: 0; z-index: 2; background: var(--panel); border-bottom: 1px solid var(--line-strong);\n           padding: 10px 20px; display: flex; flex-wrap: wrap; gap: 8px 0; align-items: center; }\n  header h1 { font-size: 15px; margin: 0 20px 0 0; letter-spacing: .04em; color: var(--base2); font-weight: 600; }\n  .unit { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; padding: 0 18px; border-left: 1px solid var(--line-strong); color: var(--bright); }\n  .unit:empty { display: none; }\n  .unit .muted { color: var(--muted); }\n  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--base01); display: inline-block; flex: none; transition: background-color var(--quick); }\n  .dot.on { background: var(--ok); } .dot.warn { background: var(--orange); } .dot.bad { background: var(--bad); }\n  .dot.busy { background: var(--busy); animation: pulse 1.6s infinite; }\n  @keyframes pulse { 50% { opacity: .3; } }\n\n  button { font: inherit; font-size: 13px; padding: 4px 11px; border-radius: 5px; border: 1px solid var(--line-strong);\n           background: transparent; color: var(--bright); cursor: pointer; line-height: 1.3; position: relative;\n           transition: border-color var(--quick), color var(--quick), background-color var(--quick), opacity var(--quick); }\n  button:hover { border-color: var(--accent); color: var(--accent); }\n  button.danger:hover { border-color: var(--bad); color: var(--bad); }\n  button:disabled { opacity: .45; cursor: default; }\n  button:disabled:hover { border-color: var(--line-strong); color: var(--bright); }\n  button.primary { background: var(--accent); border-color: var(--accent); color: var(--base03); font-weight: 600; }\n  button.primary:hover { background: #3a9be0; border-color: #3a9be0; color: var(--base03); }\n  /* the lever that is pulling now: its label gives way to a spinner, in place */\n  button.busy, button.busy:disabled { color: transparent; opacity: 1; }\n  button.busy::after { content: ''; position: absolute; inset: 0; margin: auto; width: 12px; height: 12px; border-radius: 50%;\n                       border: 2px solid var(--line-strong); border-top-color: var(--accent); animation: spin .7s linear infinite; }\n  button.primary.busy::after { border-color: rgba(0, 43, 54, .35); border-top-color: var(--base03); }\n  @keyframes spin { to { transform: rotate(360deg); } }\n  .seg { display: inline-flex; border: 1px solid var(--line-strong); border-radius: 5px; overflow: hidden; }\n  .seg button { border: 0; border-radius: 0; } .seg button + button { border-left: 1px solid var(--line-strong); }\n  .seg button.cur, .seg button.cur:hover { background: var(--accent); color: var(--base03); }\n  .seg button.cur.game { background: var(--orange); }\n  /* a lever that asks first: the button gives way to its question and a yes, in place;\n     Escape or Cancel puts the button back */\n  .confirm { display: inline-flex; align-items: center; gap: 6px; flex-wrap: wrap; padding: 3px 4px 3px 10px; border-radius: 6px;\n             border: 1px solid var(--yellow); background: rgba(181, 137, 0, .1); color: var(--base2); font-size: 13px;\n             white-space: normal; text-align: left; vertical-align: middle; animation: rise var(--quick); }\n  .confirm .q { max-width: 52ch; line-height: 1.35; }\n  .confirm .yes { background: var(--yellow); border-color: var(--yellow); color: var(--base03); font-weight: 600; }\n  .confirm .yes:hover { background: #c99a0a; border-color: #c99a0a; color: var(--base03); }\n  .confirm .yes.danger { background: var(--bad); border-color: var(--bad); color: var(--base3); }\n  .confirm .yes.danger:hover { background: #e8433f; border-color: #e8433f; color: var(--base3); }\n  .confirm .no { border-color: transparent; color: var(--muted); }\n  @keyframes rise { from { opacity: 0; transform: translateY(3px); } }\n  /* what a lever said, at the bottom right for a moment: an error stays longer */\n  #toasts { position: fixed; right: 16px; bottom: 16px; z-index: 5; display: grid; gap: 8px; max-width: min(440px, calc(100vw - 32px)); }\n  .toast { display: flex; gap: 10px; align-items: flex-start; padding: 9px 10px 9px 12px; border-radius: 8px; background: var(--panel);\n           border: 1px solid var(--line-strong); border-left: 3px solid var(--accent); color: var(--base2); font-size: 13px; line-height: 1.4;\n           box-shadow: 0 8px 24px rgba(0, 0, 0, .35); animation: rise .18s ease-out; }\n  .toast.ok { border-left-color: var(--ok); } .toast.bad { border-left-color: var(--bad); } .toast.warn { border-left-color: var(--yellow); }\n  .toast .x { margin-left: auto; border: 0; padding: 0 4px; color: var(--muted); font-size: 16px; line-height: 1; flex: none; }\n  .toast .x:hover { color: var(--bright); }\n\n  main { padding: 20px; max-width: 1400px; margin: 0 auto; display: grid; gap: 18px; transition: opacity .4s; }\n  body.stale main { opacity: .55; }  /* the stream is down: what is shown is as of the footer's time */\n  .card { background: var(--panel); border: 1px solid var(--line); border-radius: 10px; padding: 16px 20px; }\n  .card h2 { margin: 0; font-size: 17px; color: var(--base2); font-weight: 600; display: flex; gap: 12px; align-items: baseline; flex-wrap: wrap; }\n  .card h3 { margin: 18px 0 8px; font-size: 11.5px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); font-weight: 600; }\n  .card h3:first-child { margin-top: 0; }\n  .card h3 .n { color: var(--bright); margin-left: 4px; }\n  .card h3 .note { text-transform: none; letter-spacing: 0; font-weight: 400; margin-left: 8px; }\n  .cfg { color: var(--muted); font-size: 13px; font-weight: 400; }\n  .cfg .mono { color: var(--base00); }\n\n  .chip { display: inline-block; padding: 0 7px; border-radius: 4px; font-size: 11.5px; line-height: 18px; font-weight: 600;\n          letter-spacing: .02em; color: var(--base1); background: rgba(147, 161, 161, .12); vertical-align: 1px; white-space: nowrap; }\n  .chip.ok { color: var(--base03); background: var(--ok); } .chip.warn { color: var(--base03); background: var(--warn); }\n  .chip.bad { color: var(--base3); background: var(--bad); } .chip.busy { color: var(--base03); background: var(--busy); }\n  .chip.worker { color: var(--worker); background: rgba(42, 161, 152, .14); }\n  .chip.reviewer { color: var(--reviewer); background: rgba(108, 113, 196, .18); }\n  .chip.n { min-width: 22px; text-align: center; color: var(--bright); }\n  /* a bead's round history: the toggle sits by the failures chip; the list is quiet, monospace */\n  button.hist { font: 500 12px var(--mono); padding: 0 5px; border: 0; color: var(--muted); line-height: 18px; vertical-align: 1px; white-space: nowrap; }\n  button.hist:hover, button.hist.on { color: var(--accent); }\n  pre.hist { margin: 2px 0 8px; font: 12px/1.55 var(--mono); color: var(--muted); white-space: pre-wrap; }\n  tr.sub td { border-top: 0; padding-top: 0; } tr.sub td pre.hist { margin-top: 0; }\n  /* the rounds: one block each — who, when, what stopped it in full, and its logs to open in place */\n  .rounds { margin: 2px 0 8px; display: grid; gap: 8px; max-width: 900px; animation: rise var(--quick); }\n  .round { border-left: 2px solid var(--line-strong); padding: 2px 0 2px 10px; }\n  .round .head { font: 500 12px var(--mono); color: var(--bright); display: flex; gap: 10px; flex-wrap: wrap; align-items: baseline; }\n  .round .head .muted { font-weight: 400; }\n  .round pre.note { margin: 3px 0 4px; font: 12px/1.5 var(--mono); color: var(--ink); white-space: pre-wrap; }\n  .round .logs { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; font-size: 12px; color: var(--muted); }\n  button.link { font: 500 12px var(--mono); padding: 0 6px; border-color: var(--line); color: var(--muted); line-height: 18px; }\n  button.link:hover, button.link.on { color: var(--accent); border-color: var(--accent); }\n  pre.logview { margin: 4px 0 2px; font: 11.5px/1.5 var(--mono); color: var(--ink); white-space: pre-wrap; max-height: 40vh; overflow: auto;\n                background: var(--base03); padding: 8px 10px; border-radius: 6px; scrollbar-width: thin; animation: rise var(--quick); }\n  pre.logview .t { color: var(--muted); } pre.logview .tool { color: var(--blue); } pre.logview .said { color: var(--base1); }\n  /* the question a parked bead stops on: the one thing on the page that is yours to answer */\n  .ask { border-left: 3px solid var(--yellow); padding: 6px 12px; margin: 4px 0 8px; background: rgba(181, 137, 0, .07); border-radius: 0 6px 6px 0; max-width: 900px; }\n  .ask .head { font-size: 11.5px; text-transform: uppercase; letter-spacing: .1em; color: var(--yellow); font-weight: 600; }\n  .ask .head .muted { text-transform: none; letter-spacing: 0; font-weight: 400; margin-left: 8px; }\n  .ask pre.text { margin: 4px 0 2px; color: var(--base2); font-size: 13px; }\n  .fold { margin: 2px 0; } .fold > pre { animation: rise var(--quick); }\n\n  table { border-collapse: collapse; width: 100%; }\n  td, th { text-align: left; padding: 7px 12px 7px 0; vertical-align: top; border-top: 1px solid var(--line); }\n  td:last-child, th:last-child { padding-right: 0; }\n  tr:first-child td { border-top: 0; }\n  th { border-top: 0; padding-top: 0; font-size: 11.5px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); font-weight: 600; }\n  .id, .mono { font-family: var(--mono); font-size: 13px; }\n  td.id { color: var(--accent); white-space: nowrap; }\n  .muted { color: var(--muted); }\n  td.act { text-align: right; white-space: nowrap; }\n  td.act .confirm { white-space: normal; }\n  td.title { color: var(--ink); max-width: 0; width: 100%; }\n  td.title .t { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n  td.fit { white-space: nowrap; }\n\n  /* the flow: the workflow as one graph — a band per stage, a round's steps left to right,\n     CI and landed shared on the right, parked under the last stage — each node listing the\n     beads at it. The nodes are laid out by the grid; the edges are drawn over them once\n     they are, from where they landed (drawEdges). Wider than a phone: it scrolls sideways. */\n  #flow { min-width: 0; }  /* the graph scrolls inside the card, not the page */\n  .flow-wrap { overflow-x: auto; margin-top: 10px; scrollbar-width: thin; }\n  .flow { position: relative; display: grid; min-width: 1120px; padding: 2px 12px 4px; column-gap: 52px; row-gap: 12px;\n          grid-template-columns: 22px repeat(4, minmax(150px, 1fr)) minmax(180px, 1.15fr) minmax(160px, 1fr); }\n  .band { border-radius: 10px; background: rgba(147, 161, 161, .035); border: 1px solid var(--line); margin: 0 -10px; z-index: 0; }\n  .slabel { writing-mode: vertical-rl; transform: rotate(180deg); align-self: center; justify-self: center; z-index: 2; white-space: nowrap;\n            font-size: 11px; text-transform: uppercase; letter-spacing: .12em; color: var(--muted); font-weight: 600; }\n  .slabel.metered { color: var(--blue); }\n  svg.edges { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; z-index: 1; overflow: visible; }\n  svg.edges path { fill: none; stroke: var(--base00); stroke-width: 1.5; }\n  svg.edges path.head { fill: var(--base00); stroke: none; }\n  svg.edges text { font: 11px var(--sans); fill: var(--muted); }\n  svg.edges .back path { stroke: var(--orange); stroke-dasharray: 4 4; opacity: .75; } svg.edges .back path.head { fill: var(--orange); stroke: none; stroke-dasharray: none; }\n  svg.edges .back text { fill: var(--orange); }\n  svg.edges .esc path { stroke: var(--yellow); } svg.edges .esc path.head { fill: var(--yellow); } svg.edges .esc text { fill: var(--yellow); }\n  svg.edges .park path { stroke: var(--red); } svg.edges .park path.head { fill: var(--red); } svg.edges .park text { fill: var(--red); }\n  svg.edges .res path { stroke: var(--blue); stroke-dasharray: 4 4; } svg.edges .res path.head { fill: var(--blue); stroke-dasharray: none; } svg.edges .res text { fill: var(--blue); }\n  .node { position: relative; z-index: 2; align-self: start; min-width: 0; margin: 12px 0 48px; padding: 8px 10px; border-radius: 8px;\n          background: var(--base03); border: 1px solid var(--line-strong); }\n  .node.queue { border-style: dashed; }\n  .node.work { border-top: 3px solid var(--worker); } .node.review { border-top: 3px solid var(--reviewer); }\n  .node.research { border-top: 3px solid var(--blue); margin-bottom: 12px; }\n  .node.ci { border-top: 3px solid var(--green); }\n  .node.landed { border-top: 3px solid rgba(133, 153, 0, .45); }\n  /* CI and landed span the bands and take their height from them, not the other way\n     round (contain: size): a long list scrolls inside instead of stretching a band */\n  .node.ci, .node.landed { contain: size; align-self: stretch; min-height: 190px; margin-bottom: 8px; display: flex; flex-direction: column; }\n  .node.ci ul.beads, .node.landed ul.beads { flex: 1 1 0; min-height: 0; max-height: none; }\n  .node.parked { border-top: 3px solid var(--yellow); margin-bottom: 4px; }\n  .node.parked ul.beads { grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); column-gap: 8px; }\n  .node .nh { display: flex; align-items: center; gap: 6px; height: 18px; font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); font-weight: 600; }\n  .node .nh .c { margin-left: auto; font: 600 12px var(--mono); letter-spacing: 0; color: var(--bright); }\n  .node .nm { font: 500 13px var(--mono); color: var(--base2); margin-top: 2px; overflow-wrap: anywhere; }\n  .node .nm.no { color: var(--muted); font-style: italic; }\n  .node .ns { font-size: 11.5px; color: var(--muted); line-height: 1.35; margin-top: 2px; }\n  .node .chips { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }\n  .node .none { color: var(--base01); font-size: 12px; margin-top: 8px; font-style: italic; }\n  .node .more { font-size: 12px; margin: 4px 0 0 2px; display: block; }\n  .chip.metered { color: var(--blue); background: rgba(38, 139, 210, .16); }\n  ul.beads { list-style: none; margin: 7px -5px 0; padding: 0; display: grid; grid-template-columns: minmax(0, 1fr); align-content: start; gap: 1px; max-height: 330px; overflow-y: auto; scrollbar-width: thin; }\n  .bead-row { display: block; width: 100%; text-align: left; padding: 3px 5px; border: 1px solid transparent; border-radius: 5px;\n              font: inherit; font-size: 12px; line-height: 1.35; color: var(--ink); background: transparent; }\n  .bead-row:hover { border-color: var(--line-strong); color: var(--ink); background: rgba(147, 161, 161, .05); text-decoration: none; }\n  .bead-row.sel, .bead-row.sel:hover { border-color: var(--accent); background: rgba(38, 139, 210, .13); }\n  .bead-row .l1 { display: flex; align-items: center; gap: 5px; flex-wrap: wrap; }\n  .bead-row .bid { font: 600 12px var(--mono); color: var(--accent); white-space: nowrap; }\n  .bead-row .l1 .chip { font-size: 10.5px; line-height: 16px; padding: 0 5px; vertical-align: 0; }\n  .bead-row .l1 .muted { font-size: 11px; }\n  .bead-row .bt { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: var(--base0); }\n  .bead-row .on { display: flex; align-items: center; gap: 5px; color: var(--busy); font-size: 11.5px; }\n  .bead-row .by { display: block; font: 11px var(--mono); color: var(--muted); }\n  /* the bead you pressed, floating over the page's corner so the graph stays in view: where\n     it is, what it carries, its levers; × or Escape puts it away */\n  .insp { position: fixed; z-index: 4; right: 16px; bottom: 16px; width: min(480px, calc(100vw - 32px)); max-height: min(75vh, calc(100vh - 120px));\n          overflow-y: auto; scrollbar-width: thin; padding: 12px 16px; border-radius: 10px; background: var(--base03); border: 1px solid var(--line-strong);\n          border-left: 4px solid var(--accent); box-shadow: 0 12px 32px rgba(0, 0, 0, .45); animation: rise var(--quick); }\n  .insp .ih { display: flex; align-items: baseline; gap: 4px 10px; flex-wrap: wrap; padding-right: 24px; }\n  .insp .ih .bid { font: 600 20px var(--mono); color: var(--accent); }\n  .insp .ih .where { color: var(--bright); font-size: 13px; }\n  .insp .ih .x { position: absolute; top: 8px; right: 8px; border: 0; font-size: 18px; line-height: 1; padding: 2px 6px; color: var(--muted); }\n  .insp .it { font-size: 15px; color: var(--base2); margin-top: 2px; line-height: 1.4; }\n  .insp .row { margin-top: 8px; display: flex; gap: 8px; align-items: center; flex-wrap: wrap; color: var(--muted); }\n  .insp .levers { margin-left: auto; display: flex; gap: 6px; flex-wrap: wrap; }\n  .insp .ask { margin-top: 8px; }\n  /* who runs the rounds: a lane each, the bead it is on and what its session last said */\n  .lanes { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 10px; }\n  .lane { padding: 8px 12px; border-radius: 8px; background: var(--base03); border-left: 3px solid var(--base01); min-width: 0; transition: border-color .3s; }\n  .lane.busy { border-left-color: var(--busy); } .lane.paused { border-left-style: dashed; }\n  .lane .lh { display: flex; align-items: center; gap: 8px; }\n  .lane .lh b { font: 600 13px var(--mono); }\n  .lane .lh .act { margin-left: auto; } .lane .lh button { font-size: 12px; padding: 2px 9px; }\n  .lane .what { font-size: 12.5px; color: var(--muted); margin-top: 3px; line-height: 1.4; }\n  button.bref { border: 0; padding: 0; font: 600 12.5px var(--mono); color: var(--accent); vertical-align: 0; }\n  button.bref:hover { text-decoration: underline; }\n  pre.tail { font: 11px/1.45 var(--mono); margin: 6px 0 0; white-space: pre-wrap; max-height: 7.5em; overflow: hidden; color: var(--muted); }\n  tr.sub td.why { border-top: 0; padding-top: 0; padding-bottom: 10px; font-size: 13px; color: var(--ink); white-space: normal; line-height: 1.5; max-width: 900px; }\n  tr.sub td.why code { font-size: 12px; }\n  h3.human { color: var(--yellow); }\n  /* the box you write in: full width, grows with the text, keeps what you typed across\n     every push (the page is patched, not rebuilt) and across a reload (a draft per box) */\n  .reply { display: grid; gap: 8px; margin-top: 8px; max-width: 900px; animation: rise var(--quick); }\n  .reply textarea, .reply input[type=text] { width: 100%; font: 13px/1.45 var(--sans); padding: 7px 9px; border: 1px solid var(--line-strong); border-radius: 6px;\n                    background: var(--base03); color: var(--bright); resize: vertical; field-sizing: content; min-height: calc(2 * 1.45em + 16px); max-height: 40vh;\n                    transition: border-color var(--quick); }\n  .reply input[type=text] { min-height: 0; }\n  .reply textarea:focus, .reply input[type=text]:focus { border-color: var(--accent); outline: none; }\n  .reply textarea::placeholder { color: var(--base01); }\n  .reply .actions { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }\n  .reply .actions .alt { margin-left: auto; display: flex; gap: 6px; align-items: center; flex-wrap: wrap; color: var(--muted); font-size: 12.5px; }\n  .reply .hint { color: var(--muted); font-size: 12px; }\n  .reply code.cmd { font: 12px var(--mono); color: var(--bright); background: var(--base03); padding: 3px 7px; border-radius: 4px; user-select: all; }\n\n\n  /* the scoreboard: a row of tiles, the one number each in the bright ink, its reading\n     under it; below, three columns — where rounds go back (bars in one hue, the count\n     beside each), what each model landed and lost, and the model cost. */\n  #score h2 .seg { margin-left: auto; font-size: 12.5px; }\n  #score h2 .seg button { padding: 2px 10px; }\n  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin-top: 14px; }\n  .tile { padding: 12px 14px; border-radius: 8px; background: var(--base03); }\n  .tile .label { font-size: 11.5px; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); font-weight: 600; }\n  .tile .value { font-size: 30px; line-height: 1.15; font-weight: 600; color: var(--base2); margin-top: 4px; }\n  .tile .value small { font-size: 14px; font-weight: 400; color: var(--muted); margin-left: 4px; }\n  .tile .value.warn { color: var(--yellow); }\n  .tile .sub { font-size: 12.5px; color: var(--muted); margin-top: 3px; line-height: 1.4; }\n  .score-cols { display: grid; grid-template-columns: 1fr 1.3fr 1fr; gap: 0 28px; margin-top: 4px; }\n  @media (max-width: 1000px) { .score-cols { grid-template-columns: 1fr; } }\n  .bars { display: grid; grid-template-columns: max-content 1fr max-content; gap: 5px 10px; align-items: center; font-size: 13px; }\n  .bars .k { color: var(--ink); white-space: nowrap; } .bars .n { color: var(--bright); font: 500 12.5px var(--mono); text-align: right; }\n  .bars .bar { height: 10px; border-radius: 3px; background: rgba(38, 139, 210, .18); overflow: hidden; }\n  .bars .bar i { display: block; height: 100%; background: var(--blue); border-radius: 3px; transition: width .4s; }\n  .score-cols .note { font-size: 12.5px; color: var(--muted); margin-top: 8px; line-height: 1.5; }\n  .score-cols .avoid { display: flex; flex-wrap: wrap; align-items: baseline; gap: 4px 8px; margin-top: 14px; font-size: 13px; }\n  .score-cols .avoid .n { color: var(--bright); font: 500 18px var(--mono); }\n  td.num { text-align: right; font: 500 13px var(--mono); white-space: nowrap; color: var(--bright); }\n  th.num { text-align: right; white-space: nowrap; }\n  td.reasons { color: var(--muted); font-size: 12.5px; white-space: nowrap; }\n  .chip.hand { color: var(--base03); background: var(--base1); }\n\n  /* the log's heading carries its one option, at the right */\n  .card h3.log { display: flex; align-items: center; }\n  .card h3.log .opt { margin-left: auto; display: flex; align-items: center; gap: 6px; text-transform: none; letter-spacing: 0; font-weight: 400; font-size: 12.5px; cursor: pointer; }\n  .card h3.log .opt input { margin: 0; accent-color: var(--accent); }\n  pre.log { margin: 0; font: 12.5px/1.6 var(--mono); white-space: pre-wrap; max-height: 44vh; overflow: auto; color: var(--ink); scrollbar-width: thin; }\n  pre.log .t { color: var(--muted); }\n  pre.log .good { color: var(--green); } pre.log .warn { color: var(--yellow); } pre.log .bad { color: var(--orange); }\n  pre.log .pick { color: var(--blue); } pre.log .rev { color: var(--violet); } pre.log .sys { color: var(--muted); }\n  .banner { background: rgba(220, 50, 47, .12); border: 1px solid var(--bad); color: var(--bright); padding: 10px 14px; border-radius: 8px; }\n  .banner.signin { margin: 16px 20px 0; background: rgba(181, 137, 0, .12); border-color: var(--warn); animation: rise var(--quick); }\n  .banner.signin ol { margin: 6px 0 0; padding-left: 22px; } .banner.signin li { margin: 4px 0; }\n  .banner.signin input { font: 13px var(--mono); padding: 4px 8px; border: 1px solid var(--line-strong); border-radius: 5px; background: var(--base03); color: var(--bright); }\n  h2 .prio { font-size: 12px; font-weight: 400; margin-left: 8px; vertical-align: middle; }\n  h2 .prio.on { color: var(--yellow); border-color: var(--yellow); }\n  .why pre.text { margin: 4px 0 8px; white-space: pre-wrap; font: 12.5px/1.55 var(--mono); color: var(--ink); }\n  footer { color: var(--muted); font-size: 12px; text-align: right; padding: 0 20px 20px; }\n  .empty { color: var(--muted); font-style: italic; }\n  main > .empty { text-align: center; padding: 40px 0; }\n</style>\n</head>\n<body>\n<header>\n  <h1>bead-loop</h1>\n  <div class=\"unit\" id=\"timer\"></div>\n  <div class=\"unit\" id=\"tick\"></div>\n  <div class=\"unit\" id=\"gpu\"></div>\n  <div class=\"unit\" id=\"claude\"></div>\n  <div class=\"unit\" id=\"live\" style=\"margin-left:auto\"></div>\n</header>\n<div id=\"doctor\" class=\"banner\" hidden></div>\n<div id=\"signin\" class=\"banner signin\" hidden></div>\n<main id=\"main\"><div class=\"empty\">loading…</div></main>\n<footer id=\"foot\"></footer>\n<div id=\"toasts\"></div>\n<script>\n'use strict';\nconst $ = (id) => document.getElementById(id);\n// js(v): a JavaScript literal for use inside an onclick=\"…\" attribute: JSON, then the\n// quotes HTML-escaped, so the attribute is not cut short at the first inner \".\nconst js = (v) => esc(JSON.stringify(v));\n// lit(o): an object literal for the same place, the keys bare — {repo:\"…\",id:\"…\"}.\nconst lit = (o) => `{${Object.entries(o || {}).map(([k, v]) => `${k}:${js(v)}`).join(',')}}`;\nconst esc = (s) => String(s ?? '').replace(/[&<>\"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', \"'\": '&#39;' }[c]));\nconst ago = (t, now) => { const d = Math.max(0, now - t); return d < 90 ? `${d}s` : d < 5400 ? `${Math.floor(d / 60)}m` : `${Math.floor(d / 3600)}h${String(Math.floor((d % 3600) / 60)).padStart(2, '0')}`; };\n// merge = \"external\": awaiting the maintainer, counted in days (hours under a day) —\n// their queue, not ours to nag about in minutes.\nconst awaiting = (since, now) => { const d = Math.max(0, now - since); return d < 86400 ? `${Math.floor(d / 3600)} h` : `${Math.floor(d / 86400)} days`; };\nconst clock = (t) => new Date(t * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });\n// systemd prints \"Sat 2026-09-19 03:50:00 UTC\"; Date.parse wants the weekday gone.\nconst systemdTime = (s) => { if (!s) return null; const d = Date.parse(s.replace(/^\\w+ /, '')); return Number.isNaN(d) ? null : Math.floor(d / 1000); };\n\n// ---- the DOM: patched, never replaced ---------------------------------------------------\n// Every render writes the page as one string — simple to write, simple to test — but the\n// browser is not told to throw the old tree away: the string is parsed off-screen and\n// the live tree patched to match it, node by node. What the string does not describe\n// stays as it was: the text in a box you are typing in and the cursor in it, a hover, a\n// button waiting on your yes, how far down a log you have read. Children match by their\n// data-key or id when they carry one (a row for a bead, a lane, a toast), else by tag and\n// position. A textarea's or input's value is yours, never the markup's. Under the test\n// stub there is no DOM, and the string is the element's innerHTML.\nfunction patch(el, html) {\n  if (typeof document.createElement !== 'function') { el.innerHTML = html; return; }\n  const t = document.createElement('template'); t.innerHTML = html;\n  morphChildren(el, t.content);\n}\nconst keyOf = (n) => n.nodeType === 1 ? (n.getAttribute('data-key') || n.id || '') : '';\nconst alike = (a, b) => a.nodeType === b.nodeType && (a.nodeType !== 1 || (a.tagName === b.tagName && !keyOf(a) && !keyOf(b)));\nfunction morph(a, b) {\n  if (a.nodeType !== 1) { if (a.nodeValue !== b.nodeValue) a.nodeValue = b.nodeValue; return; }\n  for (const { name } of [...a.attributes]) if (!b.hasAttribute(name)) a.removeAttribute(name);\n  for (const { name, value } of [...b.attributes]) if (a.getAttribute(name) !== value) a.setAttribute(name, value);\n  if (a.tagName === 'TEXTAREA' || a.tagName === 'INPUT') return;\n  morphChildren(a, b);\n}\nfunction morphChildren(a, b) {\n  const wanted = new Set([...b.childNodes].map(keyOf).filter(Boolean));\n  const drop = (n) => { const next = n.nextSibling; a.removeChild(n); return next; };\n  let cur = a.firstChild;\n  for (const want of [...b.childNodes]) {\n    const k = keyOf(want);\n    // a keyed node at the cursor that the new page no longer names is gone, now, so the\n    // node behind it can meet its match without being moved\n    while (cur && keyOf(cur) && !wanted.has(keyOf(cur))) cur = drop(cur);\n    let have = null;\n    if (k) { for (let x = cur; x; x = x.nextSibling) if (keyOf(x) === k) { have = x; break; } }\n    else if (cur && alike(cur, want)) have = cur;\n    if (!have) { a.insertBefore(want, cur); continue; }\n    if (have !== cur) {\n      // the match is further down: what lies before it is stale unless a wanted key,\n      // in which case the match moves up instead (a moved node loses its focus)\n      let stale = true;\n      for (let x = cur; x !== have; x = x.nextSibling) if (keyOf(x) && wanted.has(keyOf(x))) { stale = false; break; }\n      if (stale) { while (cur !== have) cur = drop(cur); } else a.insertBefore(have, cur);\n    }\n    if (have === cur) cur = cur.nextSibling;\n    morph(have, want);\n  }\n  while (cur) cur = drop(cur);\n}\n\n// ---- the levers -------------------------------------------------------------------------\n// One POST each. A lever that asks first (Stop, Off, Game, Abort, Work with Claude) is\n// not a dialog: the button gives way to its question and a yes, in place, until you\n// answer or press Escape. While a lever is pulling, its label gives way to a spinner and\n// the others wait. What it said comes back as a toast; an error stays until dismissed.\n// `text` is not part of a lever's identity: the note and the box it came from are one.\n// This run's token, which the server writes into the page: every lever carries it.\nconst TOKEN = (document.querySelector && (document.querySelector('meta[name=\"bead-loop-token\"]') || {}).content) || '';\nlet last = null, busy = null, pending = null;\nconst key = (name, body) => { const { text, ...rest } = body || {}; return `${name} ${JSON.stringify(rest)}`; };\nwindow.act = async function act(name, body, ask) {\n  const k = key(name, body);\n  if (ask && pending !== k) { pending = k; render(); focus('.confirm .yes'); return false; }\n  pending = null; busy = k; render();\n  let ok = false;\n  try {\n    const r = await fetch(`/api/${name}`, { method: 'POST', headers: { 'content-type': 'application/json', 'x-bead-loop-token': TOKEN }, body: JSON.stringify(body || {}) });\n    const j = await r.json().catch(() => ({}));\n    if (!r.ok) toast(j.error || r.statusText, 'bad');\n    else {\n      ok = true;\n      if (name === 'claude_login' && j.url && last) last.login = { url: j.url };\n      // What the loop did, as the server says it; else the lever's own words.\n      if (j.said && !/^systemctl /.test(j.said)) toast(j.said, 'ok');\n      else if (SAID[name]) toast(SAID[name](body || {}), 'ok');\n      if (typeof poll === 'function') poll();\n    }\n  } catch (e) { toast(e.message, 'bad'); }\n  busy = null; render();\n  return ok;\n};\nwindow.unask = () => { pending = null; render(); };\nconst focus = (sel) => { const el = document.querySelector && document.querySelector(sel); if (el) el.focus(); };\n// What a lever leaves that the next push does not show by itself.\nconst SAID = {\n  note: (b) => `noted on ${b.id} — its next round reads it`,\n  answer: (b) => `${b.id} answered — back to the dev queue on the loop's next look`,\n  decide: (b) => `${b.id} closed with your answer; what waited on it is ready`,\n  wake: () => 'the lanes look at their queues now',\n  claude_code: () => 'Claude is signed in; the beads waiting on it can go',\n  ready: (b) => `${b.id}: pushing its branch; Open PR appears under Needs you`,\n  publish: (b) => `${b.id}: the PR opens on the loop's next tick`,\n  reopen: (b) => `${b.id} reopened — back in the dev queue on the loop's next tick`,\n  escalate: (b) => `${b.id} to the last stage on the loop's next tick`,\n  abort: (b) => `${b.id}: round stopped; the loop starts it again`,\n};\n// lever(label, name, body, {ask, cls, title, off, send}): the button for one POST, in\n// every state it has — plain, asking, pulling, or off with the reason as its title. With\n// `send`, the id of the box whose text goes along, and Ctrl+Enter in the box presses it.\nfunction lever(label, name, body, o = {}) {\n  const k = key(name, body);\n  if (o.ask && pending === k) return confirmStrip(label, name, body, o.ask, o.cls);\n  const cls = [o.cls, busy === k ? 'busy' : ''].filter(Boolean).join(' ');\n  const on = o.send ? `send('${name}',${lit(body)},${js(o.send)})` : `act('${name}',${lit(body)}${o.ask ? `,${js(o.ask)}` : ''})`;\n  return `<button${cls ? ` class=\"${cls}\"` : ''}${busy || o.off ? ' disabled' : ''}${o.title ? ` title=\"${esc(o.title)}\"` : ''} onclick=\"${on}\">${label}</button>`;\n}\nconst confirmStrip = (label, name, body, ask, cls) => `<span class=\"confirm\" data-key=\"confirm\"><span class=\"q\">${esc(ask)}</span><button class=\"yes ${cls || ''}\" onclick=\"act('${name}',${lit(body)})\">${label}</button><button class=\"no\" onclick=\"unask()\">Cancel</button></span>`;\n// send(name, body, boxId): the box's text with the lever; an empty box is told so here,\n// not by the server. Sent, the box is cleared and its draft forgotten; a note's box closes.\nwindow.send = async (name, body, boxId) => {\n  const box = $(boxId), text = ((box && box.value) || '').trim();\n  if (!text) { toast(name === 'note' ? 'write the note first' : 'write the answer first', 'warn'); if (box && box.focus) box.focus(); return; }\n  if (await act(name, { ...body, text })) { forgetDraft(boxId); if (box) box.value = ''; if (name === 'note') openNote.delete(body.id); render(); }\n};\n// A draft per box, in the browser: what you typed survives a reload of the page, not\n// only a push. Kept as you type, dropped when sent or cleared.\nconst draftKey = (id) => `draft:${id}`;\nwindow.draft = (el) => { try { if (el.value) localStorage.setItem(draftKey(el.id), el.value); else localStorage.removeItem(draftKey(el.id)); } catch { /* no storage: kept across pushes all the same */ } };\nconst savedDraft = (id) => { try { return localStorage.getItem(draftKey(id)) || ''; } catch { return ''; } };\nconst forgetDraft = (id) => { try { localStorage.removeItem(draftKey(id)); } catch { /* nothing to forget */ } };\nconst box = (id, placeholder) => `<textarea id=\"${esc(id)}\" rows=\"2\" placeholder=\"${esc(placeholder)}\" oninput=\"draft(this)\">${esc(savedDraft(id))}</textarea>`;\nwindow.copy = async (text) => { try { await navigator.clipboard.writeText(text); toast('copied', 'ok'); } catch (e) { toast(`could not copy: ${e.message}`, 'bad'); } };\n// Toasts: what a lever said, bottom right, gone by themselves — an error waits longer.\nconst toasts = []; let toastN = 0;\nfunction toast(text, kind) {\n  const t = { id: ++toastN, text, kind }; toasts.push(t); renderToasts();\n  setTimeout(() => { const i = toasts.indexOf(t); if (i >= 0) { toasts.splice(i, 1); renderToasts(); } }, kind === 'bad' ? 15000 : 5000);\n}\nwindow.dismiss = (id) => { const i = toasts.findIndex((t) => t.id === id); if (i >= 0) toasts.splice(i, 1); renderToasts(); };\nconst renderToasts = () => patch($('toasts'), toasts.map((t) => `<div class=\"toast ${t.kind}\" data-key=\"${t.id}\"><span>${esc(t.text)}</span><button class=\"x\" onclick=\"dismiss(${t.id})\" title=\"dismiss\">×</button></div>`).join(''));\n// Escape puts a waiting button back; Ctrl+Enter (⌘⏎) in a box presses its lever.\ndocument.addEventListener('keydown', (e) => {\n  if (e.key === 'Escape' && pending) return unask();\n  if (e.key === 'Escape' && picked && !(e.target && /^(TEXTAREA|INPUT)$/.test(e.target.tagName))) return pick();\n  if (e.key === 'Enter' && (e.ctrlKey || e.metaKey) && e.target && e.target.tagName === 'TEXTAREA') {\n    const b = e.target.closest('.reply') && e.target.closest('.reply').querySelector('button.primary');\n    if (b) { e.preventDefault(); b.click(); }\n  }\n});\n\nfunction gpu(s) {\n  const g = s.gpu;\n  if (!g || !g.available) { patch($('gpu'), ''); return; }\n  // game: the loop and the model server are stopped for the GPU; work: running, and the\n  // guard may flip to game by itself when it sees one (then `by` says auto).\n  const ask = 'Game mode stops the loop (aborting its sessions) and the local model server, to free the GPU.';\n  const game = pending === key('gpu', { mode: 'game' });\n  patch($('gpu'), `<span class=\"dot ${g.mode === 'game' ? 'warn' : 'on'}\"></span>GPU ${esc(g.mode)}<span class=\"muted\"> (${esc(g.by)})</span>\n    <span class=\"seg\"><button class=\"${g.mode === 'work' ? 'cur' : ''}\" ${busy ? 'disabled' : ''} onclick=\"act('gpu',{mode:'work'})\">Work</button><button class=\"${g.mode === 'game' ? 'cur game' : ''}\" ${busy ? 'disabled' : ''} onclick=\"act('gpu',{mode:'game'},${js(ask)})\">Game</button></span>${game ? confirmStrip('Game', 'gpu', { mode: 'game' }, ask, 'danger') : ''}`);\n}\n// The last stage is Claude on this box; the header's Claude unit is where its sign-in\n// lever always lives — the doctor banner below says when it, or anything else, is red.\nfunction claude(s) {\n  const c = s.claude;\n  patch($('claude'), !c ? '' : c.loggedIn ? `<span class=\"dot on\"></span>Claude <span class=\"muted\">signed in${c.method ? ' · ' + esc(c.method) : ''}</span>`\n    : `<span class=\"dot bad\"></span>Claude <span class=\"chip bad\">signed out</span> ${lever('Sign in', 'claude_login', {})}`);\n  // The sign-in in progress, as a banner: the link to open, the box for the code. Built\n  // once per url — the code you are typing is not the markup's to touch.\n  const b = $('signin');\n  if (!s.login) { b.hidden = true; delete b.dataset.url; return; }\n  b.hidden = false;\n  if (b.dataset.url !== s.login.url) {\n    b.dataset.url = s.login.url;\n    b.innerHTML = `<b>Sign Claude in</b> — the Claude Code stage fails until this is done.\n      <ol><li><a href=\"${esc(s.login.url)}\" target=\"_blank\" rel=\"noopener\">Open the sign-in page ↗</a> and sign in with the account that has the subscription.</li>\n      <li>Paste the code it shows: <input id=\"code\" class=\"mono\" size=\"44\" placeholder=\"code\" autocomplete=\"off\"> <button class=\"primary\" onclick=\"act('claude_code',{code:document.getElementById('code').value})\">Finish sign-in</button> <button class=\"danger\" onclick=\"act('claude_cancel')\">Cancel</button></li></ol>`;\n  }\n}\n// `bead-supervisor doctor --json`, once a minute (bead-loop-ui's own cache): every\n// dependency the loop needs, red or green. Anything red is a banner at the top — bd, git,\n// gh, Claude, an opencode provider's server down, the attach server, disk, a unit — in\n// place of the old banner that only ever said so for Claude.\nfunction doctorBanner(s) {\n  const out = $('doctor'), bad = (s.doctor || []).filter((p) => !p.ok);\n  if (!bad.length) { out.hidden = true; return; }\n  out.hidden = false;\n  patch(out, `<b>${bad.length} check${bad.length > 1 ? 's' : ''} red.</b> ` + bad.map((p) => `${esc(p.name)}: ${esc(p.detail)}`).join(' · '));\n}\n// The loop is resident: bead-supervisor.service stays up, its lanes on the bell when\n// idle; bead-supervisor.timer is its keeper (starts it now, and again a minute after it\n// stops). So the header says whether the loop is up and what it is on, and offers Stop\n// (the keeper brings it back in a minute — a breather) or Off (keeper too), and Wake.\nfunction header(s) {\n  gpu(s); claude(s); doctorBanner(s);\n  const t = s.timer, v = s.service;\n  const running = v.available && (v.active === 'active' || v.active === 'activating');\n  const since = systemdTime(v.since);\n  const working = s.repos.flatMap((r) => Object.entries(r.lanes).map(([k, l]) => `${k} ${l.id}`)).join(' · ');\n  patch($('timer'), !v.available ? `<span class=\"dot\"></span><span class=\"muted\">no systemd here</span>` : running\n    ? `<span class=\"dot on\"></span>loop up${since ? ` ${ago(since, s.now)}` : ''}${working ? ` — ${esc(working)}` : ' — lanes idle'} ${lever('Stop', 'stop', {}, { cls: 'danger', ask: 'Stop the loop? Rounds in flight keep running and are taken when it is back: in a minute, unless you turn it off.' })}`\n    : `<span class=\"dot ${v.result && v.result !== 'success' ? 'bad' : ''}\"></span>loop down${v.result && v.result !== 'success' ? ` (last: ${esc(v.result)})` : ''} ${lever('Start', 'loop', { on: true })}`);\n  patch($('tick'), !t.available ? '' : t.active === 'active'\n    ? `<span class=\"dot on\"></span>keeper on ${lever('Off', 'loop', { on: false }, { title: 'stop the loop and its keeper', ask: 'Turn the loop off? It stops now and stays down until you start it.' })}`\n    : `<span class=\"dot\"></span>keeper off${running ? ' — the loop will not come back if it stops' : ''} ${lever('Keeper on', 'timer', { on: true })}`);\n}\n\n// 'rejoin': a restart found this session still running and the loop is already polling\n// it (rejoin/ID, harness.rs rejoin_session) — no client is expected, unlike a genuine\n// 'orphan' (something else killed the client; nothing is coming back for it).\nconst stateChip = (st) => st === 'busy' ? '<span class=\"chip busy\">busy</span>'\n  : st === 'rejoin' ? '<span class=\"chip busy\" title=\"the loop restarted and is already waiting on this session\">rejoining</span>'\n  : st === 'orphan' ? '<span class=\"chip bad\">orphan</span>' : '<span class=\"chip\">idle</span>';\n// The agent as its role: the worker implements, the reviewer judges; colour tells them apart.\nconst roleChip = (agent) => `<span class=\"chip ${/review/.test(agent) ? 'reviewer' : 'worker'}\">${esc((agent || '?').replace(/^bead-/, ''))}</span>`;\n// A session's name: opencode's, unless it is the \"????\" a busy model has answered with.\nconst titleOf = (s, w) => (s.title && !/^[\\s?.…]*$/.test(s.title)) ? s.title : `${w.id} · ${(s.agent || '').replace(/^bead-/, '')}`;\n// How often the bead has been sent back to dev, and the stage that count puts it on:\n// stage 1 is the fast local pair; a later stage is a stronger model, the last one Opus.\n// research_model on: the bead waits for its brief (\"research\"), or has one (\"researched\")\nconst researchChip = (b) => b.research === 'pending' ? ' <span class=\"chip\" title=\"the researcher writes a brief before the worker round; a free worker lane goes without\">research</span>'\n  : b.research === 'done' ? ' <span class=\"muted\" title=\"the worker prompt carries the researcher\\u2019s brief\">researched</span>' : '';\nconst failChip = (n) => n ? `<span class=\"chip n\" title=\"sent back to dev ${n} time${n > 1 ? 's' : ''}\">${n}×</span>` : '';\n// The bead's round history — what each round left, \"round N (model): note\" — behind a\n// toggle, closed by default. Which are open lives in a Set by bead id, so the re-render\n// on every push (and every 10 s) leaves them as they were.\nconst openHist = new Set();\nwindow.toggleHist = (id) => { if (!openHist.delete(id)) openHist.add(id); render(); };\nconst histToggle = (b) => !b.failures ? '' : ` <button class=\"hist${openHist.has(b.id) ? ' on' : ''}\" onclick=\"toggleHist('${esc(b.id)}')\" title=\"what each round left\">${openHist.has(b.id) ? '▾' : '▸'} ${b.failures} round${b.failures > 1 ? 's' : ''}</button>`;\n// Each round as the loop recorded it: who ran it, on which stage, when, the whole note\n// (the BLOCKED line, the rejection with its work order, the gate's output) and the\n// round's log files — each opens in place, fetched from the server once. Rounds from\n// before the record are one line each (round, model, note).\nconst logLabel = (f) => /\\.worker-gate\\.jsonl$/.test(f) ? 'worker · gate fix' : /\\.worker\\.jsonl$/.test(f) ? 'worker' : /\\.review\\.jsonl$/.test(f) ? 'reviewer' : /\\.brief\\.jsonl$/.test(f) ? 'brief' : /\\.gate-2$/.test(f) ? 'gate, again' : /\\.gate$/.test(f) ? 'gate' : /\\.setup$/.test(f) ? 'setup' : f.replace(/^[^.]*\\.[0-9T]*\\./, '');\nconst openLog = new Set(), logText = new Map();\nwindow.toggleLog = async (repo, file) => {\n  const k = `${repo}\\n${file}`;\n  if (openLog.delete(k)) return render();\n  openLog.add(k); render();\n  if (!logText.has(k)) {\n    try { const r = await fetch(`/api/log?${new URLSearchParams({ repo, file })}`); logText.set(k, r.ok ? await r.text() : `(${(await r.json()).error || r.statusText})`); }\n    catch (e) { logText.set(k, `(${e.message})`); }\n    render();\n  }\n};\n// An opencode session log is JSON lines; shown as the supervisor's `log` shows it — one\n// line per tool call or text. A Claude Code log is one JSON object with the result. The\n// gate's and setup's output is text as it came.\nfunction renderLog(text, file) {\n  if (!/\\.jsonl$/.test(file)) return esc(text);\n  try { const v = JSON.parse(text); if (v && typeof v.result === 'string') return `<span class=\"said\">${esc(v.result)}</span>`; } catch { /* lines, then */ }\n  return text.split('\\n').map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean).map((v) => {\n    if (v.name && v.args !== undefined) { const a = typeof v.args === 'string' ? v.args : JSON.stringify(v.args); return `<span class=\"tool\">[${esc(v.name)}]</span> ${esc(a.slice(0, 300))}`; }\n    if (v.type === 'assistant' && v.message) return (v.message.content || []).map((c) => c.type === 'tool_use' ? (c.name === 'StructuredOutput' ? '' : `<span class=\"tool\">[${esc(c.name)}]</span> ${esc(JSON.stringify(c.input || {}).slice(0, 300))}`) : c.type === 'text' ? `<span class=\"said\">&gt; ${esc(c.text || '')}</span>` : '').filter(Boolean).join('\\n') || null;\n    if (v.type === 'result' && typeof v.result === 'string') return `<span class=\"said\">${esc(v.result.slice(0, 2000))}</span>`;\n    if (v.content && Array.isArray(v.content)) return v.content.filter((c) => c && typeof c.text === 'string').map((c) => `<span class=\"said\">&gt; ${esc(c.text.slice(0, 600))}</span>`).join('\\n') || null;\n    const p = v.part || {};\n    if (v.type === 'tool_use') { const i = (p.state && p.state.input) || {}; const a = ['command', 'filePath', 'path', 'pattern', 'description'].map((k) => i[k]).find((x) => typeof x === 'string') || ''; return `<span class=\"tool\">[${esc(p.tool || '')}]</span> ${esc(a.slice(0, 300))}`; }\n    if (v.type === 'text') return `<span class=\"said\">&gt; ${esc(p.text || '')}</span>`;\n    if (v.type === 'step_finish') return `<span class=\"t\">-- step: ${esc(p.reason || '')}  tokens in=${esc(p.tokens && p.tokens.input)} out=${esc(p.tokens && p.tokens.output)}</span>`;\n    return null;\n  }).filter(Boolean).join('\\n') || '(nothing the log renders)';\n}\nconst logBtns = (r, files) => (files || []).map((f) => { const k = `${r.repo}\\n${f}`; return `<button class=\"link ${openLog.has(k) ? 'on' : ''}\" onclick=\"toggleLog(${js(r.repo)},${js(f)})\" title=\"${esc(f)}\">${openLog.has(k) ? '▾' : '▸'} ${esc(logLabel(f))}</button>`; }).join('');\nconst logViews = (r, files) => (files || []).filter((f) => openLog.has(`${r.repo}\\n${f}`)).map((f) => { const t = logText.get(`${r.repo}\\n${f}`); return `<pre class=\"logview\" data-key=\"${esc(f)}\">${t == null ? '<span class=\"t\">loading…</span>' : renderLog(t, f)}</pre>`; }).join('');\nconst roundBlock = (r, x, i) => `<div class=\"round\" data-key=\"${x.round != null ? esc(x.round) : `r${i}`}\"><div class=\"head\">${x.round != null ? `round ${esc(x.round)}` : ''}${x.model ? ` <span class=\"chip worker\">${esc(x.model)}</span>` : ''}${x.stage ? `<span class=\"muted\">stage ${esc(x.stage)}</span>` : ''}${x.when ? `<span class=\"muted\">${esc(String(x.when).replace('T', ' ').slice(0, 16))}</span>` : ''}</div><pre class=\"note\">${esc(x.note || '')}</pre>${(x.logs || []).length ? `<div class=\"logs\">logs: ${logBtns(r, x.logs)}</div>${logViews(r, x.logs)}` : ''}</div>`;\nconst histList = (b, r) => !openHist.has(b.id) ? '' : (b.history || []).length ? `<div class=\"rounds\">${b.history.map((x, i) => roundBlock(r, x, i)).join('')}</div>` : '<pre class=\"hist\">no notes kept for these rounds</pre>';\n// Folds: the brief and the bead's notes under a parked bead, closed by default, remembered per bead.\nconst openFold = new Set();\nwindow.toggleFold = (k) => { if (!openFold.delete(k)) openFold.add(k); render(); };\n// A note to a bead in the flow, from the bead opened under the graph: the box opens under\n// it, the text goes on the bead as an operator note, and the next round reads it — the\n// way to hand a bead what it lacked before it fails again, without waiting for it to park.\nconst openNote = new Set();\nwindow.toggleNote = (id) => { if (!openNote.delete(id)) openNote.add(id); render(); const b = openNote.has(id) && $(`note-${id}`); if (b && b.focus) b.focus(); };\nconst noteToggle = (b) => ` <button class=\"hist${openNote.has(b.id) ? ' on' : ''}\" onclick=\"toggleNote(${js(b.id)})\" title=\"a note on the bead; its next round reads it\">✎ note</button>`;\nconst noteBox = (b, r) => !openNote.has(b.id) ? '' : `<div class=\"reply\" data-key=\"note\">${box(`note-${b.id}`, 'Context it lacked, a claim that changed — goes on the bead as an operator note; its next round reads it')}<div class=\"actions\">${lever('Add note', 'note', { repo: r.repo, id: b.id }, { cls: 'primary', send: `note-${b.id}` })}<span class=\"hint\">Ctrl+Enter sends</span></div></div>`;\nconst fold = (k, label, body) => `<div class=\"fold\"><button class=\"hist${openFold.has(k) ? ' on' : ''}\" onclick=\"toggleFold(${js(k)})\">${openFold.has(k) ? '▾' : '▸'} ${esc(label)}</button>${openFold.has(k) ? body : ''}</div>`;\nconst providerOf = (m) => (m || '').replace(/^aider:/, '').split('/')[0];\nconst probeFails = (r, m) => !!(m && r && r.probes && r.probes[providerOf(m)] && r.probes[providerOf(m)].ok === false);\n// stageChip and claudeBtn below both gate on probeFails, not on a per-provider signed-in flag.\nconst stageChip = (st, r) => !st ? '<span class=\"chip bad\" title=\"stages exhausted\">exhausted</span>'\n  : `<span class=\"chip ${st.index > 1 ? 'warn' : ''}\" title=\"stage ${st.index}: worker ${esc(st.worker)}${st.reviewer ? ', reviewer ' + esc(st.reviewer) : ''}\">${st.index > 1 ? `S${st.index} · ` : ''}${esc(st.worker)}</span>`\n    + ((probeFails(r, st.worker) || probeFails(r, st.reviewer)) ? ' <span class=\"chip bad\" title=\"a claude/* round cannot run while Claude is signed out; the lane takes other beads meanwhile\">waits for Claude sign-in</span>' : '');\n// \"Work with Claude\": the bead to the last stage and back in the dev queue, now. Shown\n// wherever a bead is not already on that stage.\nconst lastStage = (r) => r.stages[r.stages.length - 1];\nconst claudeBtn = (r, b) => {\n  const st = lastStage(r);\n  if (!st || (b.stage && b.stage.index === r.stages.length)) return '';\n  const label = `Work with ${esc(st.worker.replace(/^claude\\//, 'Claude '))}`;\n  if (probeFails(r, st.worker)) return lever(label, 'escalate', { repo: r.repo, id: b.id }, { off: true, title: 'Claude is signed out on this box — Sign in at the top first' });\n  return lever(label, 'escalate', { repo: r.repo, id: b.id }, { title: `to the last stage (${st.worker}) and back into the dev queue now`, ask: `Work ${b.id} with ${st.worker} now? It goes to the last stage and back into the dev queue, ahead of its failure count.` });\n};\nconst abortBtn = (r, id, label) => lever('Abort', 'abort', { repo: r.repo, id }, { cls: 'danger', ask: `Abort ${label}? The loop starts it again with no failure.` });\n\n// A PR in the merge queue: what GitHub says now (p.pr, a minute old at most), then the\n// loop's own markers. Merged or closed on GitHub means the next reconcile finishes it.\nfunction prChips(p, now, r) {\n  const g = p.pr, out = [];\n  if (g && g.state === 'MERGED') out.push(`<span class=\"chip ok\">merged${g.mergedAt ? ` ${ago(g.mergedAt, now)} ago` : ''}</span> <span class=\"muted\">bead closes on the watcher's next look</span>`);\n  else if (g && g.state === 'CLOSED') out.push('<span class=\"chip warn\">closed unmerged</span> <span class=\"muted\">parked on the watcher\\'s next look</span>');\n  else if (g && g.mergeable === 'CONFLICTING' && !p.adopted) out.push(`<span class=\"chip warn\">conflicts with base</span> <span class=\"muted\">back to dev on the watcher's next look for a rebase by ${esc(r.conflict_worker || (lastStage(r) ? lastStage(r).worker : 'the last stage'))}</span>`);\n  else if (g && g.mergeable === 'CONFLICTING') out.push('<span class=\"chip warn\">conflicts with base</span> <span class=\"muted\">adopted: whoever opened it rebases</span>');\n  else if (g) {\n    const bad = g.checks.filter((c) => /FAIL|ERROR|CANCEL/i.test(c.state)), pending = g.checks.filter((c) => /PENDING|IN_PROGRESS|QUEUED|EXPECTED/i.test(c.state));\n    out.push(bad.length ? `<span class=\"chip bad\">CI red</span> <span class=\"muted\">${esc(bad.map((c) => c.name).join(', '))} · back to dev on the watcher's next look</span>`\n      : p.merge_mode === 'external' ? `<span class=\"chip\">awaiting the maintainer, ${awaiting(p.awaiting_since, now)}</span>`\n      : g.checks.length === 0 ? '<span class=\"chip\">no checks yet</span>'\n      : pending.length ? `<span class=\"chip busy\">CI running</span> <span class=\"muted\">${pending.length}/${g.checks.length} pending</span>`\n      : `<span class=\"chip ok\">CI green</span> <span class=\"muted\">${r.merge === 'auto' ? 'merges on the watcher\\'s next look' : r.merge === 'pipeline' ? 'the pipeline merges it' : 'yours to merge'}</span>`);\n  } else out.push(p.red ? '<span class=\"chip bad\">CI red</span>' : p.merge_mode === 'external' ? `<span class=\"chip\">awaiting the maintainer, ${awaiting(p.awaiting_since, now)}</span>` : '<span class=\"chip\">waiting on CI</span>');\n  if (p.adopted) out.push('<span class=\"chip warn\" title=\"opened by someone else, adopted by the loop\">adopted</span>');\n  if (p.held) out.push(`<span class=\"chip warn\" title=\"${esc(p.held.why)}\">held · ${esc(p.held.why.slice(0, 80))}</span>`);\n  return out.join(' ');\n}\n\n// ---- the flow ---------------------------------------------------------------------------\n// The workflow as one graph, every bead listed at the node it is at. A band per stage —\n// the worker and reviewer a bead's failure count puts it on — with a round's steps left\n// to right: ready, the worker (then the gate), the review queue, the reviewer; then CI,\n// which every stage shares, and what landed. Under each band, the rail every send-back\n// takes to that band's ready (+1 failure); down the left, the failures a stage takes\n// before the next one, and after the last, parked. Press a bead to open it under the\n// graph: where it is, its rounds, a note to it, its session, its levers. Repos with the\n// same stages share a graph; the lanes — who runs the rounds — are a strip under it.\nconst stageOf = (r, b) => (b.stage && b.stage.index) || r.stages.length;\nconst costOf = (r, m) => { const p = m && r.providers && r.providers[providerOf(m)]; return p ? p.cost : null; };\nconst stepOf = (l) => l.step || (l.role === 'research' ? 'research' : 'work');\n// The lane a slot belongs to: NAME.K is slot K of NAME (config.rs LaneSpec::slots).\nfunction laneOf(name) { return name.replace(/\\.\\d+$/, ''); }\nlet picked = null;  // {repo, id}: the bead open under the graph; pressed again, closed\nwindow.pick = (repo, id) => { picked = !repo || (picked && picked.repo === repo && picked.id === id) ? null : { repo, id }; render(); };\nconst isPicked = (r, id) => !!picked && picked.repo === r.repo && picked.id === id;\n\n// Where each bead of these repos sits, by node: ready:K, work:K, rq:K (the review queue),\n// review:K, research, ci, parked.\nfunction flowItems(repos) {\n  const at = {}, put = (k, x) => (at[k] ||= []).push(x);\n  for (const r of repos) {\n    for (const [lane, l] of Object.entries(r.lanes)) put(stepOf(l) === 'research' ? 'research' : `${stepOf(l)}:${stageOf(r, l)}`, { r, b: l, lane });\n    r.queues.dev.forEach((b) => put(`ready:${stageOf(r, b)}`, { r, b }));\n    r.queues.review.forEach((b) => put(`rq:${stageOf(r, b)}`, { r, b, waited: true }));\n    for (const b of r.queues.merge) put('ci', { r, b, pr: true });\n    for (const b of r.ready_to_publish || []) put('ci', { r, b, publish: true });\n    for (const b of r.parked) put('parked', { r, b, parked: true });\n  }\n  return at;\n}\n// A PR's state in a word, for its row in the CI node; opened, prChips says it in full.\nfunction prWord(p) {\n  const g = p.pr;\n  if (p.held) return ['warn', 'held'];\n  if (g && g.state === 'MERGED') return ['ok', 'merged'];\n  if (g && g.state === 'CLOSED') return ['warn', 'closed'];\n  if (g && g.mergeable === 'CONFLICTING') return ['warn', 'conflicts'];\n  if (!g) return p.red ? ['bad', 'CI red'] : ['', 'waiting'];\n  if (g.checks.some((c) => /FAIL|ERROR|CANCEL/i.test(c.state))) return ['bad', 'CI red'];\n  if (p.merge_mode === 'external') return ['', 'maintainer'];\n  if (g.checks.length === 0) return ['', 'no checks'];\n  if (g.checks.some((c) => /PENDING|IN_PROGRESS|QUEUED|EXPECTED/i.test(c.state))) return ['busy', 'CI running'];\n  return ['ok', 'CI green'];\n}\nconst PARKED_WORD = { blocked: ['warn', 'question'], exhausted: ['bad', 'exhausted'], pr_closed: ['warn', 'PR closed'] };\nconst word = ([cls, text], title) => `<span class=\"chip ${cls}\"${title ? ` title=\"${esc(title)}\"` : ''}>${esc(text)}</span>`;\n// One bead at its node: id and what marks it on the first line, the title under it, and\n// the lane on it, live, when one is.\nfunction beadRow(x, now) {\n  const { r, b } = x;\n  const marks = [failChip(b.failures)];\n  if (x.pr) marks.push(word(prWord(b), b.held && b.held.why));\n  else if (x.publish) marks.push(word(['warn', 'Open PR?'], 'approved and pushed; the PR waits for your Open PR under Needs you'));\n  else if (x.parked) marks.push(word(b.parked ? PARKED_WORD[b.parked.reason] || ['', b.parked.reason] : b.question ? ['warn', 'question'] : ['', 'stopped']));\n  else if (b.held) marks.push(word(['warn', 'held'], b.held.why));\n  if (x.lane == null && b.research === 'pending') marks.push(word(['', 'brief first'], 'the researcher writes a brief before the worker round; a free worker lane goes without'));\n  if (x.waited && b.since) marks.push(`<span class=\"muted\">${ago(b.since, now)}</span>`);\n  const pr = x.pr && (b.url.match(/\\/pull\\/(\\d+)/) || [])[1];\n  return `<li data-key=\"${esc(r.repo)}#${esc(b.id)}\"><button class=\"bead-row${isPicked(r, b.id) ? ' sel' : ''}\" onclick=\"pick(${js(r.repo)},${js(b.id)})\" title=\"${esc(`${b.id} · ${r.slug}${b.title ? `\\n${b.title}` : ''}`)}\"><span class=\"l1\"><span class=\"bid\">${esc(b.id)}</span>${pr ? `<span class=\"muted\">#${esc(pr)}</span>` : ''}${marks.filter(Boolean).join('')}</span><span class=\"bt\">${esc(b.title || '')}</span>${x.lane != null ? `<span class=\"on\"><span class=\"dot busy\"></span>${esc(x.lane)} lane · ${ago(b.since, now)}</span>` : ''}</button></li>`;\n}\n// A bead that landed: to its PR, with who landed it.\nconst landedRow = (f, now) => `<li data-key=\"landed#${esc(f.slug)}#${esc(f.id)}\"><a class=\"bead-row\" ${f.url ? `href=\"${esc(f.url)}\" target=\"_blank\" rel=\"noopener\"` : ''} title=\"${esc(`${f.id} · ${f.slug}\\n${f.title || ''}`)}\"><span class=\"l1\"><span class=\"bid\">${esc(f.id)}</span></span><span class=\"bt\">${esc(f.title || '')}</span><span class=\"by\">${esc(f.worker || '')} · ${ago(f.closed, now)} ago · ${f.rounds} round${f.rounds === 1 ? '' : 's'}</span></a></li>`;\n// The model a step runs, with what the page knows of its provider: paid, or its probe failing.\nfunction modelHead(repos, m, what) {\n  if (!m) return `<div class=\"nm no\">no reviewer</div><div class=\"ns\">${what}</div>`;\n  const chips = [];\n  if (costOf(repos[0], m) === 'metered') chips.push('<span class=\"chip metered\" title=\"a paid provider: every round costs\">metered</span>');\n  const fail = repos.map((r) => r.probes && r.probes[providerOf(m)]).find((p) => p && p.ok === false);\n  if (fail) chips.push(`<span class=\"chip bad\" title=\"${esc(fail.why)}\">probe fails: ${esc(String(fail.why).slice(0, 40))}</span>`);\n  return `<div class=\"nm\">${esc(m)}</div><div class=\"ns\">${what}</div>${chips.length ? `<div class=\"chips\">${chips.join('')}</div>` : ''}`;\n}\nfunction flowNode(key, cls, row, col, head, sub, items, rowOf, empty, total) {\n  const live = items.some((x) => x.lane != null);\n  const n = total == null ? items.length : total;\n  const list = items.length ? `<ul class=\"beads\">${items.map(rowOf).join('')}</ul>` : `<div class=\"none\">${empty || 'none'}</div>`;\n  return `<div class=\"node ${cls}\" data-node=\"${key}\" data-key=\"${key}\" style=\"grid-row:${row};grid-column:${col}\"><div class=\"nh\">${live ? '<span class=\"dot busy\"></span>' : ''}${head}<span class=\"c\">${n}</span></div>${sub}${list}${total > items.length ? `<a class=\"more\" href=\"#score\">+${total - items.length} more · the scoreboard</a>` : ''}</div>`;\n}\nconst LANDED_SHOWN = 6;\nfunction flowGraph(s, repos, gi) {\n  const r0 = repos[0], n = r0.stages.length, at = flowItems(repos), items = (k) => at[k] || [];\n  // the research step: when a repo has a researcher, or a lane is on a research round\n  const research = repos.map((r) => r.research_model).find(Boolean) || (items('research').length ? 'the researcher' : null);\n  const precheck = repos.map((r) => r.precheck_model).find(Boolean);\n  const off = research ? 1 : 0, row = (x) => beadRow(x, s.now);\n  const parts = [];\n  if (research) parts.push(flowNode('research', 'research', 1, 2, 'Research', modelHead(repos, research, 'a brief for the worker, then back to ready'), items('research'), row, 'no brief being written'));\n  let lo = 0;\n  r0.stages.forEach((st, i) => {\n    const k = i + 1, gr = off + k, hi = lo + st.failures - 1;\n    const metered = [st.worker, st.reviewer].some((m) => costOf(r0, m) === 'metered');\n    parts.push(`<div class=\"band\" data-band=\"${k}\" data-key=\"band:${k}\" style=\"grid-row:${gr};grid-column:1 / 6\"></div>`);\n    parts.push(`<div class=\"slabel${metered ? ' metered' : ''}\" data-key=\"slabel:${k}\" style=\"grid-row:${gr};grid-column:1\">stage ${k} · ${metered ? 'metered' : 'local'}</div>`);\n    parts.push(flowNode(`ready:${k}`, 'queue', gr, 2, 'Ready', `<div class=\"ns\">${lo === hi ? `${lo} failure${lo === 1 ? '' : 's'}` : `${lo}–${hi} failures`} so far${k === 1 ? ' · fewest first' : ''}</div>`, items(`ready:${k}`), row, 'nothing ready'));\n    parts.push(flowNode(`work:${k}`, 'work', gr, 3, 'Work', modelHead(repos, st.worker, precheck ? `then the gate, and the pre-check (${esc(precheck)})` : 'then the gate'), items(`work:${k}`), row, 'idle'));\n    parts.push(flowNode(`rq:${k}`, 'queue', gr, 4, 'Review queue', '<div class=\"ns\">gate passed, waiting for the reviewer</div>', items(`rq:${k}`), row, 'empty'));\n    parts.push(flowNode(`review:${k}`, 'review', gr, 5, 'Review', modelHead(repos, st.reviewer, st.reviewer ? 'approve: push, the PR' : 'straight to the PR'), items(`review:${k}`), row, 'idle'));\n    lo = hi + 1;\n  });\n  const span = `${off + 1} / ${off + n + 1}`;\n  const merges = [...new Set(repos.map((r) => r.merge))].join(', ');\n  parts.push(flowNode('ci', 'ci', span, 6, 'CI · merge', `<div class=\"ns\">merge ${esc(merges)} · red goes back +1, a conflict back as a rebase</div>`, items('ci'), row, 'no PRs in flight'));\n  const slugs = new Set(repos.map((r) => r.slug));\n  const landed = s.stats ? s.stats.finished.filter((f) => f.how === 'landed' && f.closed >= s.now - 86400 && slugs.has(f.slug)) : [];\n  parts.push(flowNode('landed', 'landed', span, 7, 'Landed', '<div class=\"ns\">the last 24h · merged, bead closed</div>', landed.slice(0, LANDED_SHOWN), (f) => landedRow(f, s.now), s.stats ? 'nothing in the last 24h' : 'counting…', landed.length));\n  const decisions = repos.reduce((k, r) => k + (r.decisions || []).length, 0);\n  parts.push(flowNode('parked', 'parked', off + n + 1, '2 / 6', 'Parked', `<div class=\"ns\">exhausted, BLOCKED, or its PR closed · yours, under <a href=\"#repo-${esc(r0.slug)}\">Needs you</a>${decisions ? ` · and ${decisions} decision${decisions > 1 ? 's' : ''}` : ''}</div>`, items('parked'), row, 'nothing parked'));\n  return `<div class=\"flow-wrap\" data-key=\"flow:${gi}\"><div class=\"flow\" data-stages=\"${n}\" data-after=\"${r0.stages.map((st) => st.failures).join(',')}\" data-park=\"${r0.on_exhaust === 'park' ? 1 : ''}\"><svg class=\"edges\" aria-hidden=\"true\"></svg>${parts.join('')}</div></div>`;\n}\n\n// The edges, drawn over the laid-out nodes: where each node landed is measured, and the\n// paths go between those boxes — the grid owns the layout, the edges only follow it. A\n// step to the next is a straight line at the nodes' heading; the send-back rail runs\n// under its band from CI's left edge to the band's ready; the way down leaves ready's\n// bottom for the next band's, or parked. Redrawn after every render and on every resize;\n// under the test stub there is nothing to measure and nothing is drawn.\nlet edgeFrame = 0;\nconst flowSeen = typeof ResizeObserver === 'function'\n  ? new ResizeObserver(() => { if (!edgeFrame) edgeFrame = requestAnimationFrame(() => { edgeFrame = 0; drawEdges(); }); }) : null;\nfunction drawEdges() {\n  if (typeof document.querySelectorAll !== 'function') return;\n  for (const g of document.querySelectorAll('.flow')) {\n    if (flowSeen) flowSeen.observe(g);\n    const svg = g.querySelector('svg.edges'), o = g.getBoundingClientRect();\n    const box = (sel) => { const e = g.querySelector(sel); if (!e) return null; const b = e.getBoundingClientRect(); return { l: b.left - o.left, r: b.right - o.left, t: b.top - o.top, b: b.bottom - o.top, w: b.width, y: b.top - o.top + 19 }; };\n    const at = (k) => box(`[data-node=\"${k}\"]`), band = (k) => box(`[data-band=\"${k}\"]`);\n    const head = (x, y, dir) => dir === 'r' ? `M${x},${y}l-9,-4.5v9z` : dir === 'd' ? `M${x},${y}l-4.5,-9h9z` : `M${x},${y}l-4.5,9h9z`;\n    const text = (x, y, t, anchor) => `<text x=\"${x}\" y=\"${y}\" text-anchor=\"${anchor || 'middle'}\">${esc(t)}</text>`;\n    const out = [];\n    const edge = (cls, d, heads, label) => out.push(`<g class=\"${cls}\"><path d=\"${d}\"/>${heads.map((h) => `<path class=\"head\" d=\"${h}\"/>`).join('')}${label || ''}</g>`);\n    const fwd = (a, b, label) => { if (a && b) edge('fwd', `M${a.r},${a.y}H${b.l - 1}`, [head(b.l - 1, a.y, 'r')], label ? text((a.r + b.l) / 2, a.y - 6, label) : ''); };\n    const n = Number(g.dataset.stages), after = g.dataset.after.split(',').map(Number), ci = at('ci');\n    for (let k = 1; k <= n; k++) {\n      const rd = at(`ready:${k}`), wk = at(`work:${k}`), rq = at(`rq:${k}`), rv = at(`review:${k}`), bd = band(k);\n      fwd(rd, wk); fwd(wk, rq, 'gate ✓'); fwd(rq, rv); fwd(rv, ci, 'PR');\n      if (!rd || !bd) continue;\n      if (ci) {\n        const y = bd.b - 24, x = rd.l + rd.w * 0.72;\n        edge('back', `M${ci.l},${y}H${x}V${rd.b + 1}`, [head(x, rd.b + 1, 'u')], text(rq ? rq.l + rq.w / 2 : (x + ci.l) / 2, y - 5, '↩ sent back · +1 failure'));\n        for (const m of [wk, rv]) if (m) edge('back', `M${m.l + m.w / 2},${m.b}V${y}`, []);\n      }\n      const next = k < n ? at(`ready:${k + 1}`) : at('parked'), x = rd.l + rd.w * 0.28, f = after[k - 1];\n      const label = `after ${f} failure${f === 1 ? '' : 's'}${k < n ? '' : g.dataset.park ? ': exhausted' : ''}`;\n      if (next) edge(k < n ? 'esc' : 'park', `M${x},${rd.b}V${next.t - 1}`, [head(x, next.t - 1, 'd')], text(x + 7, bd.b - 7, label, 'start'));\n    }\n    fwd(ci, at('landed'), 'merge');\n    const rs = at('research'), r1 = at('ready:1');\n    if (rs && r1) { const x = r1.l + r1.w / 2; edge('res', `M${x},${rs.b + 1}V${r1.t - 1}`, [head(x, r1.t - 1, 'd'), head(x, rs.b + 1, 'u')], text(x + 8, (rs.b + r1.t) / 2 + 4, 'no brief yet ⇄ brief written', 'start')); }\n    svg.innerHTML = out.join('');\n  }\n}\n\n// The bead you pressed, under the graph: where it is, the title, its failures and stage,\n// the rounds and a note behind their toggles, the session a lane has it in with the last\n// lines it said and Abort; the PR's state in CI; for a parked bead, its question — the\n// answer box is under Needs you. Gone from every node (landed, closed, blocked), it says so.\nfunction findIn(r, id) {\n  for (const [lane, l] of Object.entries(r.lanes)) if (l.id === id) return { b: l, lane };\n  let i;\n  if ((i = r.queues.dev.findIndex((b) => b.id === id)) >= 0) return { b: r.queues.dev[i], q: 'dev', pos: i + 1 };\n  if ((i = r.queues.review.findIndex((b) => b.id === id)) >= 0) return { b: r.queues.review[i], q: 'review', pos: i + 1 };\n  const one = (list, k) => { const b = (list || []).find((x) => x.id === id); return b && { b, [k]: true }; };\n  return one(r.queues.merge, 'pr') || one(r.ready_to_publish, 'publish') || one(r.parked, 'parked');\n}\nconst tailBlock = (l) => (l.tail || []).length ? `<pre class=\"tail\">${esc(l.tail.join('\\n'))}</pre>` : '';\nfunction inspector(s) {\n  if (!picked) return '';\n  const r = s.repos.find((x) => x.repo === picked.repo), x = r && findIn(r, picked.id);\n  const close = '<button class=\"x\" onclick=\"pick()\" title=\"close\">×</button>';\n  if (!x) return `<div class=\"insp\" data-key=\"insp\"><div class=\"ih\"><span class=\"bid\">${esc(picked.id)}</span><span class=\"muted\">in no node now — landed, closed, or waiting on a blocker</span>${close}</div></div>`;\n  const { b } = x, now = s.now;\n  const step = x.lane != null && stepOf(b);\n  const where = step === 'research' ? `Research · on the ${x.lane} lane, ${ago(b.since, now)}`\n    : step ? `${step === 'review' ? 'Review' : 'Work'} · stage ${stageOf(r, b)} · on the ${x.lane} lane, ${ago(b.since, now)}`\n    : x.q === 'dev' ? `Ready · stage ${stageOf(r, b)} · #${x.pos} in the dev queue`\n    : x.q === 'review' ? `Review queue · stage ${stageOf(r, b)} · #${x.pos}, waiting ${ago(b.since, now)}`\n    : x.pr ? 'CI · merge' : x.publish ? 'Ready to publish · yours' : 'Parked · yours';\n  const model = step === 'research' ? r.research_model : step === 'review' ? (b.stage && b.stage.reviewer) : (b.stage && b.stage.worker);\n  const session = !step ? '' : `<div class=\"row\">${roleChip(step === 'review' ? 'reviewer' : step)} <span class=\"mono\">${esc(model || '')}</span> <span>${(b.tail || []).length ? 'its last tool calls:' : 'no tool call yet'}</span> ${abortBtn(r, b.id, `the ${step} round on ${b.id}`)}</div>`;\n  const marks = x.pr ? `${failChip(b.failures)}${noteToggle(b)} ${prChips(b, now, r)}${b.url ? ` <a href=\"${esc(b.url)}\" target=\"_blank\" rel=\"noopener\">${esc(b.url.replace(/^https?:\\/\\/github\\.com\\/[^/]+\\//, ''))} ↗</a>` : ''}`\n    : `${failChip(b.failures)}${histToggle(b)}${x.parked ? '' : noteToggle(b)} ${stageChip(b.stage, r)}${researchChip(b)}${b.held ? ` ${word(['warn', 'held'], b.held.why)} <span>${esc(b.held.why)}</span>` : ''}`;\n  const levers = x.q ? claudeBtn(r, b) : '';\n  const parked = !x.parked ? '' : `<div class=\"ask\"><div class=\"head\">${b.parked ? esc(b.parked.reason) : 'stopped'}<span class=\"muted\">answer, reopen or work it with Claude under <a href=\"#repo-${esc(r.slug)}\">Needs you</a></span></div>${b.parked && b.parked.question ? `<pre class=\"text\">${esc(b.parked.question)}</pre>` : ''}</div>`;\n  return `<div class=\"insp\" data-key=\"insp\">\n    <div class=\"ih\"><span class=\"bid\">${esc(b.id)}</span>${s.repos.length > 1 ? `<span class=\"muted\">${esc(r.slug)}</span>` : ''}<span class=\"where\">${esc(where)}</span>${close}</div>\n    <div class=\"it\">${esc(b.title || '')}</div>\n    <div class=\"row\">${marks}${levers ? `<span class=\"levers\">${levers}</span>` : ''}</div>\n    ${session}${step ? tailBlock(b) : ''}${parked}${histList(b, r)}${x.parked ? '' : noteBox(b, r)}\n  </div>`;\n}\n\n// The lanes, once, under the graph: a lane is one thing for the whole loop (it walks every\n// repo), so its strip says which bead it is on, at which step, and what its session last\n// said — or why it is idle; Pause / Resume on each (paused is paused everywhere).\nfunction laneStrip(s) {\n  const ticking = s.service.available && (s.service.active === 'active' || s.service.active === 'activating');\n  const names = [...new Set(s.repos.flatMap((r) => r.lane_names || ['dev', 'review']))];\n  return `<div class=\"lanes\">${names.map((name) => {\n    const lane = laneOf(name);\n    const paused = false;\n    const pauseBtn = '';\n    const on = s.repos.find((r) => r.lanes && r.lanes[name]);\n    if (on) {\n      const l = on.lanes[name];\n      return `<div class=\"lane busy${paused ? ' paused' : ''}\" data-key=\"${esc(name)}\"><div class=\"lh\"><span class=\"dot busy\"></span><b>${esc(name)}</b>${paused ? '<span class=\"chip warn\" title=\"finishes this round, then starts no new one\">pausing</span>' : ''}<span class=\"act\">${abortBtn(on, l.id, `the ${stepOf(l)} round on ${l.id}`)}</span></div>\n        <div class=\"what\">${esc(stepOf(l))} · <button class=\"bref\" onclick=\"pick(${js(on.repo)},${js(l.id)})\" title=\"${esc(l.title || '')}\">${esc(l.id)}</button>${s.repos.length > 1 ? ` · ${esc(on.slug)}` : ''} · ${ago(l.since, s.now)}</div>${tailBlock(l)}</div>`;\n    }\n    const onLane = (b) => b.stage && [b.stage.worker, b.stage.reviewer].some((m) => m && providerOf(m) === lane);\n    const count = (pick) => s.repos.reduce((n, r) => n + r.queues.dev.filter(pick).length + r.queues.review.filter(pick).length, 0);\n    const queued = lane === 'dev' ? s.repos.reduce((n, r) => n + r.queues.dev.length, 0)\n      : lane === 'review' ? s.repos.reduce((n, r) => n + r.queues.review.length, 0)\n      : count(onLane);\n    const probeFail = s.repos.map((r) => r.probes && r.probes[lane]).find((p) => p && p.ok === false);\n    const why = paused ? 'paused — starts no new round until resumed'\n      : queued === 0 ? 'idle — nothing queued for it'\n      : probeFail ? `idle — ${queued} waiting — ${lane}: probe fails (${probeFail.why})`\n      : ticking ? `idle — ${queued} queued, starting…` : `idle — ${queued} queued; the loop is down`;\n    return `<div class=\"lane${paused ? ' paused' : ''}\" data-key=\"${esc(name)}\"><div class=\"lh\"><span class=\"dot\"></span><b>${esc(name)}</b>${paused ? '<span class=\"chip warn\">paused</span>' : ''}<span class=\"act\">${pauseBtn}</span></div><div class=\"what\">${esc(why)}</div></div>`;\n  }).join('')}</div>`;\n}\nfunction flowPane(s) {\n  const groups = new Map();\n  for (const r of s.repos) { const k = JSON.stringify(r.stages.map((st) => [st.worker, st.reviewer || '', st.failures])); if (!groups.has(k)) groups.set(k, []); groups.get(k).push(r); }\n  const many = groups.size > 1;\n  const graphs = [...groups.values()].map((repos, i) => `${many ? `<h3 data-key=\"fg:${i}\">${esc(repos.map((r) => r.slug).join(' · '))}</h3>` : ''}${flowGraph(s, repos, i)}`).join('');\n  return `<section class=\"card\" id=\"flow\"><h2>Flow <span class=\"cfg\">a band per stage · a bead moves right as it passes, back along the rail when it fails, down a band when its stage is spent · press one to open it${!many && s.repos.length > 1 ? ` · ${esc(s.repos.map((r) => r.slug).join(', '))}` : ''}</span></h2>${graphs}${inspector(s)}\n    <h3>Lanes<span class=\"note\">who runs the rounds · one each for the whole loop</span></h3>${laneStrip(s)}</section>`;\n}\n// Sessions the server is still running that are on no lane yet: a 'rejoin' the last\n// restart found and a lane has not picked up its bead for, a real 'orphan' (a killed\n// round nothing is coming back for), or a hand-run `work`. Only appears when there is\n// something to stop.\nfunction strays(r, now) {\n  const on = Object.values(r.lanes).map((l) => l.id);\n  const rows = r.worktrees.filter((x) => !on.includes(x.id)).flatMap((x) => x.sessions.filter((s) => s.state !== 'idle').map((s) => ({ ...s, wt: x })));\n  if (rows.length === 0) return '';\n  return `<h3>Also running<span class=\"n\">${rows.length}</span><span class=\"note\">on no lane — a pending rejoin, an older round, or a hand-run work</span></h3><table>${rows.map((s) => `\n    <tr data-key=\"${esc(s.id)}\"><td class=\"fit\">${stateChip(s.state)}</td><td class=\"fit\">${roleChip(s.agent)}</td><td class=\"id\">${esc(s.wt.id)}</td><td class=\"mono muted fit\">${esc(s.model)}</td>\n        <td class=\"muted fit\">${ago(s.updated, now)} ago</td>\n        <td class=\"title\"><span class=\"t\"><a href=\"${esc(s.url)}\" target=\"_blank\" rel=\"noopener\">${esc(titleOf(s, s.wt))} ↗</a></span></td>\n        <td class=\"act\">${abortBtn(r, s.wt.id, `${s.agent} on ${s.wt.id}`)}</td></tr>`).join('')}</table>`;\n}\n\n// The scoreboard: how well the workflow works, over a window you pick — 24h, 7d, 30d or\n// all. The server computes it (`bead-supervisor --json stats`) from what the beads and\n// the session logs already record, once a minute. Six tiles answer the questions in\n// order: is work landing, how much of it first time, how much without Claude, at what\n// cost in rounds and dollars, and how often it needed you. Under them: where rounds go\n// back, what each model landed and lost, the model cost — and the last beads finished.\nlet scoreWin = '7d';\ntry { scoreWin = localStorage.getItem('scoreWin') || '7d'; } catch { /* the default, every load */ }\nwindow.setWin = (w) => { scoreWin = w; try { localStorage.setItem('scoreWin', w); } catch { /* not remembered, still applied */ } render(); };\nlet scoreAll = false;  // the finished list shows a few; the toggle opens it for the session\nwindow.setScoreAll = (on) => { scoreAll = !!on; render(); };\nconst FINISHED_SHOWN = 8;\nconst dur = (s) => { if (s == null) return '–'; const m = Math.round(s / 60); return m < 60 ? `${m}m` : m < 60 * 48 ? `${Math.floor(m / 60)}h${String(m % 60).padStart(2, '0')}` : `${(m / 1440).toFixed(1)}d`; };\nconst hours = (s) => `${(s / 3600).toFixed(1)}h`;\nconst usd = (n) => `$${n.toFixed(2)}`;\nconst mtok = (n) => n >= 1e6 ? `${(n / 1e6).toFixed(1)}M` : n >= 1e3 ? `${Math.round(n / 1e3)}k` : `${n}`;\nconst price = (n) => String(Number(n.toFixed(3)));\nconst pct = (n, of) => of ? `${Math.round(n * 100 / of)}%` : '–';\nconst tile = (label, value, sub, cls) => `<div class=\"tile\" data-key=\"${esc(label)}\"><div class=\"label\">${label}</div><div class=\"value ${cls || ''}\">${value}</div><div class=\"sub\">${sub}</div></div>`;\n// Insights: what the loop's record says to change (/api/insights, rebuilt by the server at\n// most every five minutes, asked here once a minute). Each is a table with a level and a\n// hint; the page draws any of them the same way, so a new one needs no code here.\nlet insights = null;\nasync function pollInsights() {\n  try { const r = await fetch('/api/insights'); if (r.ok) { insights = await r.json(); render(); } } catch (e) { /* the next minute */ }\n}\nconst LEVEL = { ok: '', warn: 'warn', bad: 'bad' };\nfunction insightsPane() {\n  if (!insights) return '<section class=\"card\" id=\"insights\"><h2>Insights <span class=\"cfg\">what the loop\\u2019s record says to change</span></h2><div class=\"empty\">reading the traces\\u2026</div></section>';\n  const one = (x) => `<div class=\"insight\" data-key=\"${esc(x.key)}\"><h3>${esc(x.title)}${x.level !== 'ok' ? ` <span class=\"chip ${LEVEL[x.level] || ''}\">${esc(x.level)}</span>` : ''}<span class=\"note\">${esc(x.about)}</span></h3>`\n    + (x.rows.length === 0 ? '<div class=\"empty\">nothing yet</div>'\n      : `<table><tr>${x.columns.map((c) => `<th>${esc(c)}</th>`).join('')}</tr>${x.rows.map((r, i) => `<tr data-key=\"${i}\">${r.map((c) => `<td>${esc(c)}</td>`).join('')}</tr>`).join('')}</table>`)\n    + (x.hint ? `<div class=\"note\">${esc(x.hint)}</div>` : '') + '</div>';\n  return `<section class=\"card\" id=\"insights\"><h2>Insights <span class=\"cfg\">what the loop\\u2019s record says to change \\u00b7 as of ${clock(insights.at)}</span></h2>${insights.insights.map(one).join('')}</section>`;\n}\n\nfunction scoreboard(s) {\n  const st = s.stats;\n  const seg = `<span class=\"seg\">${['24h', '7d', '30d', 'all'].map((w) => `<button class=\"${w === scoreWin ? 'cur' : ''}\" onclick=\"setWin('${w}')\">${w}</button>`).join('')}</span>`;\n  if (!st) return `<section class=\"card\" id=\"score\"><h2>Scoreboard <span class=\"cfg\">what the loop landed and what it cost</span>${seg}</h2><div class=\"empty\">counting… (bead-supervisor stats, once a minute)</div></section>`;\n  const w = st.windows[scoreWin] || st.windows.all;\n  const days = Math.max(w.span_s, 3600) / 86400;\n  const landed = w.landed, sb = w.send_backs, mt = w.model_time;\n  const since = new Date(st.since * 1000).toLocaleDateString([], { month: 'short', day: 'numeric' });\n  const needed = w.answers + w.escalations;\n  const tiles = [\n    tile('Landed', `${landed}<small>${days >= 2 ? `${(landed / days).toFixed(1)} a day` : ''}</small>`, `merged and closed by the loop${w.closed_by_hand ? ` · ${w.closed_by_hand} finished by hand` : ''}${w.closed_unmerged ? ` · ${w.closed_unmerged} PR closed unmerged` : ''}`),\n    tile('First try', pct(w.landed_first_try, landed), `${w.landed_first_try} of ${landed} landed with no send-back`),\n    tile('Without metered models', pct(w.landed_local, landed), `${w.landed_local} of ${landed} landed by a local model`),\n    tile('Rounds per landing', `${w.rounds_per_landed.median == null ? '–' : w.rounds_per_landed.median.toFixed(1)}<small>median</small>`, `${w.rounds_per_landed.mean == null ? '–' : w.rounds_per_landed.mean.toFixed(1)} mean · ${sb.total} send-back${sb.total === 1 ? '' : 's'} in all`),\n    tile('Time to land', `${dur(w.time_to_land_s.median)}<small>median</small>`, `first claim → merge · ${dur(w.time_to_land_s.mean)} mean`),\n    tile('Needed you', `${needed}`, `${w.escalations} escalated · ${w.answers} answered · ${w.holds} held`, needed ? 'warn' : ''),\n  ].join('');\n  // where rounds go back: the reasons, most first, as bars against the biggest\n  const reasons = Object.entries(sb.by_reason).sort((a, b) => b[1] - a[1]);\n  const top = reasons.length ? reasons[0][1] : 1;\n  const bars = reasons.length === 0 ? '<div class=\"empty\">no send-backs</div>'\n    : `<div class=\"bars\">${reasons.map(([k, n]) => `<span class=\"k\">${esc(k)}</span><span class=\"bar\" title=\"${n} of ${sb.total}\"><i style=\"width:${Math.round(n * 100 / top)}%\"></i></span><span class=\"n\">${n}</span>`).join('')}</div>`;\n  // the pre-check's tally as `bead-supervisor stats` prints it: its send-backs are the\n  // precheck bar above, what it passed and skipped shows only here; no pre-check, no line\n  const pc = w.precheck;\n  const extra = [pc && pc.sent_back + pc.passed + pc.skipped ? `pre-check: ${pc.sent_back} sent back, ${pc.passed} passed, ${pc.skipped} skipped` : '', w.rebases ? `${w.rebases} rebase${w.rebases > 1 ? 's' : ''} (no failure)` : '', w.interrupted ? `${w.interrupted} round${w.interrupted > 1 ? 's' : ''} interrupted by a stop` : ''].filter(Boolean).join(' · ');\n  // by model: what each landed, what it lost and why\n  const models = [...new Set([...Object.keys(w.landed_by), ...Object.keys(sb.by_model)])].sort((a, b) => (w.landed_by[b] || 0) - (w.landed_by[a] || 0) || a.localeCompare(b));\n  const modelRows = models.length === 0 ? '<div class=\"empty\">no rounds yet</div>'\n    : `<table><tr><th>model</th><th class=\"num\">landed</th><th class=\"num\">sent back</th><th>why</th></tr>${models.map((m) => {\n      const lost = sb.by_model[m] || { total: 0, by_reason: {} };\n      const why = Object.entries(lost.by_reason).sort((a, b) => b[1] - a[1]).map(([k, n]) => `${esc(k)} ${n}`).join(' · ');\n      return `<tr data-key=\"${esc(m)}\"><td class=\"mono\">${esc(m)}</td><td class=\"num\">${w.landed_by[m] || 0}</td><td class=\"num\">${lost.total}</td><td class=\"reasons\">${why}</td></tr>`;\n    }).join('')}</table>`;\n  // model cost: what each role's sessions say they spent (Claude Code's total_cost_usd,\n  // opencode's per-step cost; $0 for a local model), the bar its share of the window's\n  // spend; empty rounds are a leak to see\n  const totalUsd = Math.max(mt.worker_usd + mt.review_usd, 0.01);\n  const time = `<div class=\"bars\">\n    <span class=\"k\">worker</span><span class=\"bar\" title=\"${usd(mt.worker_usd)} · ${hours(mt.worker_s)}\"><i style=\"width:${Math.min(100, Math.round(mt.worker_usd * 100 / totalUsd))}%\"></i></span><span class=\"n\">${usd(mt.worker_usd)}</span>\n    <span class=\"k\">reviewer</span><span class=\"bar\" title=\"${usd(mt.review_usd)} · ${hours(mt.review_s)}\"><i style=\"width:${Math.min(100, Math.round(mt.review_usd * 100 / totalUsd))}%\"></i></span><span class=\"n\">${usd(mt.review_usd)}</span>\n  </div><div class=\"note\">${mt.worker_rounds} worker round${mt.worker_rounds === 1 ? '' : 's'} (${hours(mt.worker_s)}), ${mt.review_rounds} review round${mt.review_rounds === 1 ? '' : 's'} (${hours(mt.review_s)}) · ${usd(mt.worker_usd + mt.review_usd)} this window${mt.empty_rounds ? ` · <span class=\"chip warn\" title=\"a session the harness or server never answered — Claude signed out, a model server down — retried by the loop\">${mt.empty_rounds} empty round${mt.empty_rounds > 1 ? 's' : ''}</span>` : ''}</div>`;\n  // avoided cost: an estimate, never a bill — the tokens the local models handled, priced at\n  // the reference rate in the global config (what a metered model would have charged for\n  // them). Without a rate the tokens are shown and nothing is priced.\n  const av = w.avoided || { input_tokens: 0, output_tokens: 0, cache_read_tokens: 0, usd: null };  // absent from a supervisor older than the page\n  const avTokens = `${mtok(av.input_tokens)} in · ${mtok(av.cache_read_tokens)} cached · ${mtok(av.output_tokens)} out`;\n  const avoided = av.input_tokens + av.cache_read_tokens + av.output_tokens === 0 ? '' : av.usd == null\n    ? `<div class=\"avoid\"><span class=\"k\">avoided</span><span class=\"chip\" title=\"no [reference_rate] in the global config\">not priced</span></div>\n       <div class=\"note\">local models handled ${avTokens}. Set <span class=\"mono\">[reference_rate]</span> in the global config to price them.</div>`\n    : `<div class=\"avoid\" title=\"what a metered model would have charged for the tokens local models handled — not a bill\"><span class=\"n\">≈ ${usd(av.usd)}</span><span class=\"k\">avoided</span><span class=\"chip\">estimate</span></div>\n       <div class=\"note\">local models handled ${avTokens}, priced at $${price(av.rate.input)} / $${price(av.rate.output)} / $${price(av.rate.cache_read)} per M tokens (in / out / cached), the reference rate in config</div>`;\n  // the beads finished in the window, newest first\n  const from = scoreWin === 'all' ? 0 : st.now - { '24h': 86400, '7d': 7 * 86400, '30d': 30 * 86400 }[scoreWin];\n  const fin = st.finished.filter((b) => b.closed >= from);\n  const shown = scoreAll ? fin : fin.slice(0, FINISHED_SHOWN);\n  const more = fin.length > FINISHED_SHOWN ? ` <button class=\"hist\" onclick=\"setScoreAll(${!scoreAll})\">${scoreAll ? '▾ the first ' + FINISHED_SHOWN : '▸ all ' + fin.length}</button>` : '';\n  const finished = fin.length === 0 ? '<div class=\"empty\">nothing finished in this window</div>'\n    : `<table><tr><th>bead</th><th>title</th><th></th><th class=\"num\">rounds</th><th>landed by</th><th class=\"num\">to land</th><th class=\"num\">closed</th></tr>${shown.map((b) => `\n    <tr data-key=\"${esc(b.id)}\"><td class=\"id\">${esc(b.id)}${st.repos.length > 1 ? ` <span class=\"muted\">${esc(b.slug)}</span>` : ''}</td><td class=\"title\"><span class=\"t\" title=\"${esc(b.title)}\">${b.url ? `<a href=\"${esc(b.url)}\" target=\"_blank\" rel=\"noopener\">${esc(b.title)} ↗</a>` : esc(b.title)}</span></td>\n        <td class=\"fit\">${b.how === 'landed' ? '<span class=\"chip ok\">landed</span>' : '<span class=\"chip hand\" title=\"closed by hand after the loop had worked it\">by hand</span>'}${b.escalated ? ' <span class=\"chip warn\" title=\"escalated to the last stage by hand\">escalated</span>' : ''}${b.answers ? ` <span class=\"chip\" title=\"answers you gave\">${b.answers} answer${b.answers > 1 ? 's' : ''}</span>` : ''}</td>\n        <td class=\"num\">${b.rounds}</td><td class=\"mono muted fit\">${b.how === 'landed' ? esc(b.worker) : ''}</td><td class=\"num\">${b.how === 'landed' ? dur(b.time_to_land_s) : ''}</td><td class=\"num muted\">${ago(b.closed, s.now)} ago</td></tr>`).join('')}</table>`;\n  const perRepo = st.repos.length > 1 ? ` · ${Object.entries(w.by_repo).map(([k, v]) => `${esc(k)} ${v.landed}`).join(', ')}` : '';\n  return `<section class=\"card\" id=\"score\">\n    <h2>Scoreboard <span class=\"cfg\">what the loop landed and what it cost · ${scoreWin === 'all' ? `since ${since}` : `the last ${scoreWin}`}${perRepo} · counted ${ago(st.now, s.now)} ago</span>${seg}</h2>\n    <div class=\"tiles\">${tiles}</div>\n    <div class=\"score-cols\">\n      <div><h3>Where rounds go back<span class=\"n\">${sb.total}</span></h3>${bars}${extra ? `<div class=\"note\">${extra}</div>` : ''}</div>\n      <div><h3>By model</h3>${modelRows}</div>\n      <div><h3>Model cost</h3>${time}${avoided}</div>\n    </div>\n    <h3>Finished<span class=\"n\">${fin.length}</span><span class=\"note\">newest first · rounds counts the one that landed</span>${more}</h3>${finished}\n  </section>`;\n}\n\nfunction repo(r, now, ticking) {\n  const stages = r.stages.map((s, i) => `<span title=\"stage ${i + 1}: takes the next ${s.failures} failure${s.failures > 1 ? 's' : ''}\"><span class=\"mono\">${esc(s.worker)}</span>${s.reviewer ? ` ⇢ <span class=\"mono\">${esc(s.reviewer)}</span>` : ''} ×${s.failures}</span>`).join(' &nbsp;→&nbsp; ');\n  // The human queue: each bead with the question it stopped on, first — the loop's\n  // brief asks it (what happened, why, what you have to decide), or, without a brief, the\n  // loop's own from the reason — then what happened (the brief), the rounds with their\n  // logs (the toggle by the count), the bead's notes, and the ways out: an answer (noted\n  // on the bead, back to the dev queue at the same stage), a Claude Code session in its\n  // worktree with you, the last stage, or a plain reopen.\n  const reasonChip = (b) => { const p = b.parked; return !p ? (b.question ? '<span class=\"chip warn\">question</span>' : b.stage ? '<span class=\"chip\" title=\"in_progress with no record from the loop: parked by hand, or a round a stop cut short\">stopped</span>' : '<span class=\"chip bad\">exhausted</span>')\n    : p.reason === 'blocked' ? '<span class=\"chip warn\" title=\"the last stage said BLOCKED: a claim in the bead is false, or a decision is yours\">question</span>' : p.reason === 'exhausted' ? '<span class=\"chip bad\" title=\"every stage has had its failures\">exhausted</span>' : p.reason === 'pr_closed' ? '<span class=\"chip warn\" title=\"its PR was closed on GitHub without merging\">PR closed</span>' : `<span class=\"chip\">${esc(p.reason)}</span>`; };\n  const askBlock = (b) => {\n    const p = b.parked;\n    if (!p) return `<div class=\"ask\"><div class=\"head\">Stopped on<span class=\"muted\">no record from the loop — parked by hand, or before it kept one</span></div><pre class=\"text\">${b.why ? `${b.why.when ? `${esc(b.why.when.replace('T', ' ').slice(0, 16))}${b.why.round ? ' ·' + esc(b.why.round) : ''} — ` : ''}${esc(b.why.what)}` : 'no note from the loop'}</pre></div>`;\n    const meta = [p.when ? `parked ${esc(String(p.when).replace('T', ' ').slice(0, 16))}` : '', p.stage ? `stopped on stage ${esc(p.stage.index)} (${esc(p.stage.worker)})` : '', p.brief_model ? `brief by ${esc(p.brief_model)}` : 'no brief: the loop\\'s own question'].filter(Boolean).join(' · ');\n    return `<div class=\"ask\"><div class=\"head\">The question<span class=\"muted\">${meta}</span></div><pre class=\"text\">${esc(p.question || '')}</pre></div>`\n      + (p.brief ? fold(`brief:${b.id}`, 'what happened, and why', `<pre class=\"text\">${esc(p.brief)}</pre>`) : '')\n      + (p.stopped_on && !p.brief ? fold(`stop:${b.id}`, 'what it stopped on', `<pre class=\"text\">${esc(p.stopped_on)}</pre>`) : '');\n  };\n  const human = r.parked.length === 0 ? '<div class=\"empty\">nothing waiting on you</div>' : `<table>${r.parked.map((b) => `\n    <tr data-key=\"${esc(b.id)}\"><td class=\"id\">${esc(b.id)}</td><td class=\"title\"><span class=\"t\" title=\"${esc(b.title || '')}\">${esc(b.title || '')}</span></td>\n        <td class=\"fit\">${reasonChip(b)} ${failChip(b.failures)}${histToggle(b)}</td>\n        <td class=\"act\">${b.has_work ? lever('Ready for PR', 'ready', { repo: r.repo, id: b.id }, { cls: 'primary', title: 'its branch holds work that passed the gate: push it, and open the PR yourself', ask: `Push ${b.id}'s branch and make it ready for PR?` }) + ' ' : ''}${claudeBtn(r, b)} ${lever('Reopen', 'reopen', { repo: r.repo, id: b.id }, { title: 'back in the dev queue as is' })}</td></tr>\n    <tr class=\"sub\" data-key=\"${esc(b.id)}:why\"><td></td><td colspan=\"3\" class=\"why\">${askBlock(b)}${histList(b, r)}${b.notes ? fold(`notes:${b.id}`, 'the bead\\'s notes', `<pre class=\"hist\">${esc(b.notes)}</pre>`) : ''}\n      <div class=\"reply\">\n        ${box(`ans-${b.id}`, 'Your answer, or the context it lacked — goes on the bead under the question; the next round reads both')}\n        <div class=\"actions\">${lever('Answer &amp; resume', 'answer', { repo: r.repo, id: b.id }, { cls: 'primary', send: `ans-${b.id}` })}<span class=\"hint\">Ctrl+Enter sends</span>\n          <span class=\"alt\">or work it with Claude yourself, in its worktree: <code class=\"cmd\">${esc(b.open_cmd)}</code> <button onclick=\"copy(${js(b.open_cmd)})\" title=\"copy the command\">Copy</button></span></div>\n        ${b.waiting && b.waiting.length > 0 ? `<div class=\"muted\">${b.waiting.length} bead${b.waiting.length === 1 ? '' : 's'} wait on it: ${b.waiting.map((id) => esc(id)).join(', ')}</div>` : ''}\n      </div></td></tr>`).join('')}</table>`;\n  // Held: still in its queue, waiting on something outside the loop — the reason, and\n  // where it sits. The loop keeps looking; the flag clears by itself when the world\n  // changes (a server back, CI reporting, a merge). Listed with parked, since both are\n  // yours to look at, but nothing here needs a Reopen.\n  const held = (r.held || []).length === 0 ? '' : `<table>${r.held.map((b) => `\n    <tr data-key=\"${esc(b.id)}\"><td class=\"id\">${esc(b.id)}</td><td class=\"title\"><span class=\"t\" title=\"${esc(b.title || '')}\">${esc(b.title || '')}</span></td>\n        <td class=\"fit\"><span class=\"chip warn\">held</span> <span class=\"muted\">in ${esc(b.where)} · ${ago(b.since, now)}</span></td>\n        <td class=\"act\">${b.where === 'merge' ? '' : claudeBtn(r, b)}</td></tr>\n    <tr class=\"sub\" data-key=\"${esc(b.id)}:why\"><td></td><td colspan=\"3\" class=\"why\">${esc(b.why)}</td></tr>`).join('')}</table>`;\n  // Decisions: a bead of type `decision` (or labelled needs-human) in this repo is a\n  // question for you, asked by the loop, an agent, or your own planning — the text in\n  // full, since it is what you decide on. Answer & close puts the answer on the bead as\n  // its close reason, where whoever asked reads it; beads that depended on it unblock.\n  const decisions = (r.decisions || []).length === 0 ? '' : `<table class=\"decisions\">${r.decisions.map((d) => `\n    <tr data-key=\"${esc(d.id)}\"><td class=\"id\">${esc(d.id)}</td><td class=\"title\"><b>${esc(d.title || '')}</b></td>\n        <td class=\"fit\"><span class=\"chip warn\">question</span></td><td class=\"act\"></td></tr>\n    <tr class=\"sub\" data-key=\"${esc(d.id)}:why\"><td></td><td colspan=\"3\" class=\"why\"><pre class=\"text\">${esc(d.description || '(no description)')}</pre>\n      <div class=\"reply\">\n        ${box(`dec-${d.id}`, 'Your decision — goes on the bead as its close reason; whoever asked reads it there')}\n        <div class=\"actions\">${lever('Answer &amp; close', 'decide', { repo: r.repo, id: d.id }, { cls: 'primary', send: `dec-${d.id}` })}<span class=\"hint\">Ctrl+Enter sends</span></div>\n      </div></td></tr>`).join('')}</table>`;\n  // Ready to publish: a proposal an `open_pr = \"ask\"` round left in proposed/ID, waiting\n  // on you. The compare_url to look the diff over, the title and body it would open the\n  // PR with — yours to edit, the input and textarea prefilled and (like every box here)\n  // patched in place, never rebuilt, so what you typed survives every push. Open PR posts\n  // {repo, id, title, body} straight from those two fields to /api/publish.\n  const publish = (r.ready_to_publish || []).length === 0 ? '' : `<table>${r.ready_to_publish.map((b) => {\n    const p = b.proposal || {}, t = `pub-title-${b.id}`, body = `pub-body-${b.id}`;\n    return `<tr data-key=\"${esc(b.id)}\"><td class=\"id\">${esc(b.id)}</td><td class=\"title\"><span class=\"t\" title=\"${esc(b.title || '')}\">${esc(b.title || '')}</span></td>\n        <td class=\"fit\"><span class=\"chip warn\">ready to publish</span></td><td class=\"act\"></td></tr>\n    <tr class=\"sub\" data-key=\"${esc(b.id)}:why\"><td></td><td colspan=\"3\" class=\"why\">${p.compare_url ? `<div><a href=\"${esc(p.compare_url)}\" target=\"_blank\" rel=\"noopener\">${esc(p.compare_url)} ↗</a></div>` : ''}\n      <div class=\"reply\">\n        <input id=\"${esc(t)}\" type=\"text\" value=\"${esc(p.title || '')}\">\n        <textarea id=\"${esc(body)}\" rows=\"4\">${esc(p.body || '')}</textarea>\n        <div class=\"actions\"><button class=\"primary\" onclick=\"act('publish',{repo:${js(r.repo)},id:${js(b.id)},title:document.getElementById(${js(t)}).value,body:document.getElementById(${js(body)}).value})\">Open PR</button></div>\n      </div></td></tr>`;\n  }).join('')}</table>`;\n  // The priority repo: the lanes look at it first on every pass; otherwise round-robin.\n  const prio = '';  // no priority repo in the BAML loop: every repo is looked at each tick\n  return `<section class=\"card\" id=\"repo-${esc(r.slug)}\">\n    <h2>${esc(r.slug)} ${prio} <span class=\"cfg\">${esc(r.label)} · ${esc(r.base)} · merge ${esc(r.merge)} · stages: ${stages} · then ${esc(r.on_exhaust)}${r.attach ? '' : ' · <b>no attach</b>: sessions not visible'}</span></h2>\n    ${strays(r, now)}\n    <h3 class=\"human\">Needs you<span class=\"n\">${(r.decisions || []).length + r.parked.length + (r.held || []).length + (r.ready_to_publish || []).length}</span><span class=\"note\">a decision asked of you · a bead parked on a question, exhausted, or its PR closed · a bead held in its queue by something outside the loop · a proposal ready to publish</span></h3>${decisions}${human}${held}${publish}\n  </section>`;\n}\n\n// One class per kind of line, so the eye can skim the log for the red and the green.\nfunction logClass(m) {\n  if (/stopped:|failed|BLOCKED|CI red|rejected|exhausted|parked/.test(m)) return 'bad';\n  if (/approved|opened https|pushed a new round|closed \\(|merged/.test(m)) return 'good';\n  if (/review: |→ review queue/.test(m)) return 'rev';\n  if (/dev: bead |→ dev queue/.test(m)) return 'pick';\n  if (/^(Starting|Finished|Stopped|Started) |\\.service:/.test(m)) return 'sys';\n  return '';\n}\n// systemd's own lines — Starting, Finished, Stopped, the unit's accounting — are the\n// journal's, not the loop's: hidden unless asked, and the asking is remembered per browser.\nlet showSys = false;\ntry { showSys = localStorage.getItem('showSys') === '1'; } catch { /* no storage: the default, every load */ }\nwindow.setSys = (on) => { showSys = !!on; try { localStorage.setItem('showSys', showSys ? '1' : '0'); } catch { /* not remembered, still applied */ } render(); };\n\n// The log follows its tail until you scroll up to read something, and again once you\n// scroll back down: known from the scrolling, not from where it is at render time.\nlet logTail = true;\ndocument.addEventListener('scroll', (e) => { const t = e.target; if (t && t.id === 'log') logTail = t.scrollHeight - t.scrollTop - t.clientHeight < 12; }, true);\n\nfunction render() {\n  if (!last) return;\n  header(last);\n  const lines = last.log.map((l) => { const m = l.msg.replace(/^\\d\\d:\\d\\d:\\d\\d /, ''); return { t: l.t, m, cls: logClass(m) }; }).filter((l) => showSys || l.cls !== 'sys');\n  const log = last.log.length === 0 ? '<div class=\"empty\">no journal (not running under systemd?)</div>'\n    : lines.length === 0 ? '<div class=\"empty\">only systemd’s own lines so far</div>'\n    : `<pre class=\"log\" id=\"log\">${lines.map((l) => `<span class=\"t\">${clock(l.t)}</span>  <span class=\"${l.cls}\">${esc(l.m)}</span>`).join(\"\\n\")}</pre>`;\n  const sysBox = `<label class=\"opt\" title=\"systemd’s Starting/Finished/Stopped lines for the unit\"><input type=\"checkbox\" ${showSys ? 'checked' : ''} onchange=\"setSys(this.checked)\">systemd lines</label>`;\n  patch($('main'), (last.error ? `<div class=\"banner\" data-key=\"error\">status failed: ${esc(last.error)}</div>` : '')\n    + (last.repos.length === 0 ? '<section class=\"card\" data-key=\"norepos\"><div class=\"empty\">no repos: set <span class=\"mono\">repos</span> in ~/.config/bead-loop/config.toml</div></section>' : flowPane(last) + scoreboard(last) + insightsPane())\n    + last.repos.map((r) => repo(r, last.now, last.service.available && (last.service.active === 'active' || last.service.active === 'activating'))).join(\"\")\n    + `<section class=\"card\" id=\"journal\"><h3 class=\"log\">Supervisor log${sysBox}</h3>${log}</section>`);\n  drawEdges();\n  const el = $('log'); if (el && logTail) el.scrollTop = el.scrollHeight;\n  $('foot').textContent = `state as of ${clock(last.now)} · read every 5 s`;\n  // The tab says how many things wait on you.\n  const waiting = last.repos.reduce((n, r) => n + (r.decisions || []).length + r.parked.length, 0);\n  document.title = waiting ? `(${waiting}) bead-loop` : 'bead-loop';\n}\n// Pushed, not polled: the server sends the whole state whenever anything in it changes.\n// EventSource reconnects by itself; the dot says which, and the page dims while the\n// stream is down — what it shows is as of the footer's time.\n// A hidden tab drops its stream and picks it up again when shown: a browser allows six\n// connections to one host, and a forgotten tab holding one is how the seventh \"hangs\".\n// It also means an unwatched page costs the server nothing.\nlet live = false, es = null;\nfunction setLive(on, text) {\n  live = on;\n  patch($('live'), on ? '<span class=\"dot on\"></span><span class=\"muted\">live</span>' : `<span class=\"dot ${text === 'paused' ? '' : 'bad'}\"></span><span class=\"muted\">${text || 'reconnecting…'}</span>`);\n  if (document.body && document.body.classList) document.body.classList.toggle('stale', !on && !!last && text !== 'paused');\n}\nasync function poll() {\n  try {\n    const r = await fetch('/api/status');\n    if (!r.ok) throw new Error(r.statusText);\n    last = await r.json(); setLive(true); render();\n  } catch (e) { setLive(false); }\n}\nfunction connect() {\n  if (es) return;\n  setLive(false, 'connecting…');\n  poll(); es = setInterval(poll, 5000);\n}\nfunction disconnect() { if (es) { clearInterval(es); es = null; } setLive(false, 'paused'); }\ndocument.addEventListener('visibilitychange', () => (document.hidden ? disconnect() : connect()));\nconnect();\npollInsights(); setInterval(pollInsights, 60000);\n// Between pushes the clock still moves: re-render the ages every 10 s from the last state.\nsetInterval(() => { if (last && live) { last.now = Math.floor(Date.now() / 1000); render(); } }, 10000);\n</script>\n</body>\n</html>\n";

const FAVICON_SVG: string = "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 32 32\">\n  <rect width=\"32\" height=\"32\" rx=\"7\" fill=\"#002b36\"/>\n  <circle cx=\"16\" cy=\"6.5\" r=\"4.3\" fill=\"#2aa198\"/>\n  <circle cx=\"24.3\" cy=\"11.25\" r=\"4.3\" fill=\"#6c71c4\"/>\n  <circle cx=\"24.3\" cy=\"20.75\" r=\"4.3\" fill=\"#2aa198\"/>\n  <circle cx=\"16\" cy=\"25.5\" r=\"4.3\" fill=\"#6c71c4\"/>\n  <circle cx=\"7.7\" cy=\"20.75\" r=\"4.3\" fill=\"#2aa198\"/>\n  <circle cx=\"7.7\" cy=\"11.25\" r=\"4.3\" fill=\"#6c71c4\"/>\n</svg>\n";
