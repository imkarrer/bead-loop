#!/usr/bin/env bash
# Stub claude (Claude Code, -p mode) for bead-loop tests. Same $TEST_CTRL contract as
# the opencode stub; the role comes from the tools allowed (Edit = worker).
set -euo pipefail
# auth status: signed in unless the test says otherwise ($TEST_CTRL/claude-signed-out);
# like the real thing, exit 1 when signed out, JSON on stdout either way.
if [ "${1:-}" = auth ] && [ "${2:-}" = status ]; then
  if [ -e "$TEST_CTRL/claude-signed-out" ]; then echo '{"loggedIn":false,"authMethod":"none"}'; exit 1; fi
  echo '{"loggedIn":true,"authMethod":"claude.ai"}'; exit 0
fi
prompt='' model='' tools='' sys=''
# Interactive (no -p): `open` execs claude with the prompt as its only argument; the stub
# records where it was opened and with what, and exits.
if [ $# -eq 1 ]; then printf '%s\n' "$PWD" >"$TEST_CTRL/opened"; printf '%s' "$1" >"$TEST_CTRL/opened.prompt"; exit 0; fi
while [ $# -gt 0 ]; do
  case $1 in
    -p) prompt=$2; shift;; --model) model=$2; shift;; --allowedTools) tools=$2; shift;;
    --append-system-prompt) sys=$2; shift;; --output-format) shift;; --no-session-persistence) ;;
  esac; shift
done
case $tools in *Edit*) agent=bead-worker;; *) agent=bead-reviewer;; esac
n=$(( $(wc -l <"$TEST_CTRL/calls" 2>/dev/null || echo 0) + 1 ))
printf '%s %s claude/%s claude\n' "$agent" "$PWD" "$model" >>"$TEST_CTRL/calls"
printf '%s' "$prompt" >"$TEST_CTRL/prompt.$n"
printf '%s' "$sys" >"$TEST_CTRL/system.$n"
# claude-api-error: what Claude Code prints when the sign-in expired mid-run — a JSON
# error, no token spent, exit 1 (the real thing, 20 Sep 2026: "OAuth session expired").
if [ -e "$TEST_CTRL/claude-api-error" ]; then
  jq -n '{type:"result", is_error:true, result:"Failed to authenticate: OAuth session expired and could not be refreshed", usage:{input_tokens:0, output_tokens:0}, terminal_reason:"api_error"}'
  exit 1
fi
say() { jq -n --arg t "$1" '{type:"result", result:$t}'; }
case $agent in
  bead-worker)
    round=$(grep -c '^bead-worker' "$TEST_CTRL/calls")
    echo "opus round $round" >>work.txt; git add -A && git commit -qm "work: opus round $round"
    say "DONE: acceptance check printed ok" ;;
  bead-reviewer) say "APPROVE: checked every criterion" ;;
esac
