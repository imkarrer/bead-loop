#!/usr/bin/env bash
# Stub gh for bead-loop tests. PR state in $TEST_CTRL/pr.json; actions logged to $TEST_CTRL/gh.log.
set -euo pipefail
echo "$*" >>"$TEST_CTRL/gh.log"
[ "$1" = pr ] || { echo "stub gh: only pr" >&2; exit 2; }
case $2 in
  create)
    head=; while [ $# -gt 0 ]; do [ "$1" = --head ] && head=$2; shift; done
    jq -n --arg h "$head" '{state:"OPEN", head:$h, mergeStateStatus:"CLEAN", statusCheckRollup:[], url:"https://github.com/example/repo/pull/7"}' >"$TEST_CTRL/pr.json"
    echo https://github.com/example/repo/pull/7 ;;
  list)
    # The stub's one PR (if any) plus any extra PRs the test planted in extra-prs.json.
    filter=.; head=; while [ $# -gt 0 ]; do case $1 in --jq) filter=$2; shift;; --head) head=$2; shift;; esac; shift; done
    { [ -e "$TEST_CTRL/pr.json" ] && jq 'select(.state=="OPEN") | {number:7, headRefName:.head, url}' "$TEST_CTRL/pr.json"; jq ".[]" "$TEST_CTRL/extra-prs.json" 2>/dev/null; } | jq -s . | jq --arg h "$head" 'if $h == "" then . else map(select(.headRefName == $h)) end' | jq -r "$filter"
    ;;
  view)
    if [ "$3" = 7 ]; then jq '{state, mergedAt: null, mergeable: (.mergeable // "MERGEABLE"), mergeStateStatus, statusCheckRollup, url}' "$TEST_CTRL/pr.json"
    else jq --argjson n "$3" '.[] | select(.number==$n) | {state, mergedAt: null, mergeStateStatus: "CLEAN", statusCheckRollup: .checks, url}' "$TEST_CTRL/extra-prs.json"; fi ;;
  edit)
    # --add-label L: labels land in pr.json (or labels-extra for planted PRs). A test plants
    # $TEST_CTRL/label-missing to have GitHub refuse, as it does for a label the repo lacks.
    n=$3 l=; while [ $# -gt 0 ]; do [ "$1" = --add-label ] && l=$2; shift; done
    [ -e "$TEST_CTRL/label-missing" ] && { echo "'$l' not found" >&2; exit 1; }
    if [ "$n" = 7 ]; then jq --arg l "$l" '.labels += [$l]' "$TEST_CTRL/pr.json" >"$TEST_CTRL/pr.json.tmp" && mv "$TEST_CTRL/pr.json.tmp" "$TEST_CTRL/pr.json"
    else echo "$n $l" >>"$TEST_CTRL/labels-extra"; fi ;;
  merge)
    # A test plants $TEST_CTRL/merge-refused to have GitHub refuse (branch protection).
    [ -e "$TEST_CTRL/merge-refused" ] && { echo "Pull request is not mergeable: protected branch" >&2; exit 1; }
    if [ "$3" = 7 ]; then jq '.state="MERGED"' "$TEST_CTRL/pr.json" >"$TEST_CTRL/pr.json.tmp" && mv "$TEST_CTRL/pr.json.tmp" "$TEST_CTRL/pr.json"
    else echo "$3" >>"$TEST_CTRL/merged-extra"; fi ;;
  update-branch) jq '.mergeStateStatus="CLEAN"' "$TEST_CTRL/pr.json" >"$TEST_CTRL/pr.json.tmp" && mv "$TEST_CTRL/pr.json.tmp" "$TEST_CTRL/pr.json" ;;
  *) echo "stub gh: unknown pr $2" >&2; exit 2 ;;
esac
