#!/usr/bin/env bash
# Stub opencode for bead-loop tests. `run` only. Behaviour from $TEST_CTRL:
#   worker      one line per round, the last line for the rest: done | blocked | nocommit | uncommitted |
#               hang | crash | server-error | stall   (what the implementor leaves behind; stall loops
#               tool_use/compaction events forever, no edit, until the watchdog or a stop kills it)
#   abort-delay seconds the server takes for the next abort, once (curl stub): the stop's race
#   review      one line per round: approve | reject | hang | crash | server-error
#   brief       shape (default: WHAT HAPPENED / WHY / QUESTION) | plain (no shape) | crash
#   postmortem  plain (three numbered lines, default) | crash | server-error
#   slow        seconds every run takes before it answers: a round in flight while the test pauses its lane
#   calls       appended: "<agent> <dir> <model> <attach>" per run, prompt saved to prompt.<n>
set -euo pipefail
[ "$1" = run ] || { echo "stub opencode: only run" >&2; exit 2; }
shift
dir=. agent='' model='' attach='' prompt=''
while [ $# -gt 0 ]; do
  case $1 in
    --dir) dir=$2; shift;; --agent) agent=$2; shift;; -m) model=$2; shift;; --attach) attach=$2; shift;;
    --format) shift;; --title) echo "$2" >>"$TEST_CTRL/titles"; shift;; *) prompt=$1;;
  esac; shift
done
n=$(( $(wc -l <"$TEST_CTRL/calls" 2>/dev/null || echo 0) + 1 ))
printf '%s %s %s %s\n' "$agent" "$dir" "${model:-none}" "${attach:-none}" >>"$TEST_CTRL/calls"
printf '%s' "$prompt" >"$TEST_CTRL/prompt.$n"
[ -e "$TEST_CTRL/slow" ] && sleep "$(cat "$TEST_CTRL/slow")"
say() { jq -cn --arg t "$1" '{type:"text", part:{text:$t}}'; }
# What opencode prints when the server errors before the model answers (21 Sep 2026: the
# reviewer model added to opencode.json without a server restart -- ProviderModelNotFoundError
# behind ref err_502a8619): one error event, no text, exit 1.
server_error() { jq -cn '{type:"error", timestamp:1789953019292, sessionID:"ses_f3e7c72bbffe8Z0a3YGAoGjCfQ", error:{name:"UnknownError", data:{message:"Unexpected server error. Check server logs for details.", ref:"err_502a8619"}}}'; exit 1; }
case $agent in
  bead-worker)
    round=$(grep -c '^bead-worker' "$TEST_CTRL/calls")
    mode=$(sed -n "${round}p" "$TEST_CTRL/worker"); [ -n "$mode" ] || mode=$(tail -1 "$TEST_CTRL/worker")
    case $mode in
      blocked) say "I looked."; say "BLOCKED: lib/x.ts:3 has no such flag" ;;
      nocommit) say "DONE: nothing to do" ;;
      hang) say "working on it"; sleep 30 ;;   # said something, then the clock or a stop ends it
      stall)   # an endless read/compaction loop, no edit: the watchdog trips well before worker_timeout
        while :; do
          jq -cn '{type:"tool_use", part:{type:"tool", tool:"read"}}'
          jq -cn '{type:"text", part:{type:"text", metadata:{compaction_continue:true}, text:"Continue"}}'
          sleep 0.05
        done ;;
      crash) echo "connection refused" >&2; exit 7 ;;   # the harness died before the model said a word
      server-error) server_error ;;   # the server answered an error before the model ran
      uncommitted) echo "work" >"$dir/work.txt"; say "DONE: wrote work.txt (forgot to commit)" ;;
      done)
        round=$(grep -c '^bead-worker' "$TEST_CTRL/calls")
        echo "work round $round" >>"$dir/work.txt"
        git -C "$dir" add -A && git -C "$dir" commit -qm "work: round $round"
        say "DONE: acceptance check printed ok" ;;
    esac ;;
  bead-reviewer)
    round=$(grep -c '^bead-reviewer' "$TEST_CTRL/calls")
    v=$(sed -n "${round}p" "$TEST_CTRL/review")
    case $v in
      approve) say "APPROVE: checked every criterion" ;;
      hang) say "reading the diff"; sleep 30 ;;   # a stop or the clock ends it
      crash) echo "connection refused" >&2; exit 7 ;;   # the reviewer's server is down
      server-error) server_error ;;   # the server answered an error before the reviewer ran
      *) say "REJECT: work.txt:1 wrong, fix it"; say "$(printf "For the worker:\n- What is wrong: work.txt:1 says round 1\n- What to do: append the word fixed\n- How to check: grep -c fixed work.txt prints 1")" ;;
    esac ;;
  bead-briefer)
    # The brief of a parked bead: the model reads the rounds and asks the owner. The
    # prompt it got is on file for the test (prompt.N); what it answers is the control's.
    case $(cat "$TEST_CTRL/brief" 2>/dev/null || echo shape) in
      plain) say "I read the rounds; it looks like the flag is missing." ;;
      crash) echo "connection refused" >&2; exit 7 ;;
      *) say "$(printf "WHAT HAPPENED:\nround 1 tried the flag and stopped.\nWHY:\nlib/x.ts has no such flag: the bead is wrong.\nQUESTION:\nIs the flag called --dry-run (add it to the bead), or should the criterion go?")" ;;
    esac ;;
  bead-postmortem)
    case $(cat "$TEST_CTRL/postmortem" 2>/dev/null || echo plain) in
      crash) echo "connection refused" >&2; exit 7 ;;
      server-error) server_error ;;
      *) say "$(printf "1. Tried to edit work.txt.\n2. Stopped without a commit.\n3. Run git status in the worktree first.")" ;;
    esac ;;
esac
