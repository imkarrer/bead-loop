#!/usr/bin/env bash
# Stub bd for bead-loop tests. Issues live in $BD_STATE/issues.json (array).
set -euo pipefail
F=$BD_STATE/issues.json
# A temp file of its own per write: two lanes update beads at the same time, and one
# shared .tmp name let one writer truncate the other's file mid-mv (a flaky abort).
save() { local tmp; tmp=$(mktemp "$F.XXXXXX"); jq "$1" --arg id "${2:-}" --arg t "${3:-}" "$F" >"$tmp" && mv "$tmp" "$F"; }
cmd=$1; shift
case $cmd in
  ready)
    # slow-ready: seconds to take, for the tests of what the lanes do while dev has not claimed yet.
    [ -e "$TEST_CTRL/slow-ready" ] && sleep "$(cat "$TEST_CTRL/slow-ready")"
    label=; n=100
    while [ $# -gt 0 ]; do case $1 in -l) label=$2; shift;; -n) n=$2; shift;; esac; shift; done
    [ "$n" = 0 ] && n=1000
    jq --arg l "$label" --argjson n "$n" '[.[] | select(.status=="open" and (.labels|index($l)))] | .[0:$n]' "$F" ;;
  show)  jq --arg id "$1" '[.[] | select(.id==$id)]' "$F" ;;
  list)
    status=; label=
    while [ $# -gt 0 ]; do case $1 in --status) status=$2; shift;; -l) label=$2; shift;; -n) shift;; esac; shift; done
    jq --arg s "$status" --arg l "$label" '[.[] | select(($s=="" or .status==$s) and ($l=="" or (.labels|index($l))))]' "$F" ;;
  update)
    id=$1; shift
    case $1 in
      --claim)
        # bd refuses a claim when someone else holds the assignee, even on an open bead.
        a=$(jq -r --arg id "$id" '.[] | select(.id==$id) | .assignee // ""' "$F"); actor=${BEADS_ACTOR:-$USER}
        if [ -n "$a" ] && [ "$a" != "$actor" ]; then echo "Error claiming $id: issue already claimed by $a" >&2; exit 1; fi
        save '(.[] | select(.id==$id)) |= (.status="in_progress" | .assignee=$t)' "$id" "$actor" ;;
      --append-notes) save '(.[] | select(.id==$id)) |= (.notes=((.notes // "") + "\n" + $t))' "$id" "$2" ;;
      --status) save '(.[] | select(.id==$id)) |= (.status=$t)' "$id" "$2" ;;
    esac ;;
  comment) save '(.[] | select(.id==$id)) |= (.comments=((.comments // []) + [$t]))' "$1" "$2" ;;
  close)
    id=$1; shift; reason=; while [ $# -gt 0 ]; do [ "$1" = --reason ] && reason=$2 && shift; shift; done
    save '(.[] | select(.id==$id)) |= (.status="closed" | .close_reason=$t)' "$id" "$reason" ;;
  *) echo "stub bd: unknown $cmd" >&2; exit 2 ;;
esac
