#!/bin/sh
# bead-loop-ui: the page, served by the supervisor binary itself (`page` in
# baml_src/ns_page/page.baml): every repo's beads folded from their logs, and the
# Answer / Reopen / Escalate levers on a parked bead.
#
#   bead-loop-ui      serve http://127.0.0.1:4097 (BEAD_LOOP_UI_HOST, BEAD_LOOP_UI_PORT)
#
# BEAD_SUPERVISOR picks the binary (the units set it to ~/.local/bin/bead-supervisor);
# BEAD_LOOP_CONFIG the directory of the global config.toml.
exec "${BEAD_SUPERVISOR:-bead-supervisor}" page \
  --config_file "${BEAD_LOOP_CONFIG:-$HOME/.config/bead-loop}/config.toml" \
  --addr "${BEAD_LOOP_UI_HOST:-127.0.0.1}:${BEAD_LOOP_UI_PORT:-4097}"
