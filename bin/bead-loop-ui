#!/usr/bin/env node
// bead-loop-ui: the loop on one page, and the few levers that are worth a button.
//
//   bead-loop-ui                 serve http://127.0.0.1:4097 (BEAD_LOOP_UI_PORT, BEAD_LOOP_UI_HOST)
//
// Reads: `bead-supervisor --json status` (the one description of a repo's state),
// journalctl for the supervisor's log, systemctl for the timer and the running tick.
// Levers, each one command the operator would otherwise type:
//   abort a session on the opencode server, run a tick now, stop the running tick
//   (the supervisor's TERM handler aborts its session), pause/resume the timer,
//   reopen a parked bead, gpu-mode game/work where the box has that command.
// The page holds an EventSource on /api/events and is pushed every change; nobody
// presses refresh. No dependencies beyond node; the page is ui/index.html.
'use strict';
const http = require('node:http');
const fs = require('node:fs');
const path = require('node:path');
const { execFile } = require('node:child_process');

const HOME = path.resolve(__dirname, '..');
const SUPERVISOR = path.join(HOME, 'bin', 'bead-supervisor');
const PAGE = path.join(HOME, 'ui', 'index.html');
const PORT = Number(process.env.BEAD_LOOP_UI_PORT || 4097);
const HOST = process.env.BEAD_LOOP_UI_HOST || '127.0.0.1';
const UNIT = 'bead-supervisor';

const run = (cmd, args, opts = {}) => new Promise((resolve) => {
  execFile(cmd, args, { maxBuffer: 16 << 20, ...opts }, (err, stdout, stderr) =>
    resolve({ ok: !err, code: err ? err.code : 0, stdout: String(stdout || ''), stderr: String(stderr || '') }));
});
const jsonLines = (s) => s.split('\n').filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);

// ---- what the page reads -------------------------------------------------------------
async function unitState(name) {
  const r = await run('systemctl', ['--user', 'show', name, '-p', 'ActiveState,SubState,ExecMainStartTimestamp,LastTriggerUSec,NextElapseUSecRealtime,Result']);
  if (!r.ok) return { available: false };
  const p = Object.fromEntries(r.stdout.split('\n').filter(Boolean).map((l) => l.split(/=(.*)/s).slice(0, 2)));
  return { available: true, active: p.ActiveState, sub: p.SubState, next: p.NextElapseUSecRealtime || null,
           since: p.ExecMainStartTimestamp || p.LastTriggerUSec || null, result: p.Result || null };
}
async function journal(n) {
  const r = await run('journalctl', ['--user', '-u', `${UNIT}.service`, '-o', 'json', '-n', String(n), '--no-pager']);
  if (!r.ok) return [];
  return jsonLines(r.stdout).map((e) => ({ t: Math.floor(Number(e.__REALTIME_TIMESTAMP) / 1e6), msg: typeof e.MESSAGE === 'string' ? e.MESSAGE : '' }))
    .filter((e) => !/^bead-supervisor\.service: Consumed /.test(e.msg));  // systemd's accounting line, not the loop's
}
// gpu-mode, where the box has one (bead-loop's own workstation does: `gpu-mode game`
// stops the loop and the local model server to free the GPU for a game, `gpu-mode work`
// starts them again, and a guard flips it by itself while a game runs). It needs root;
// the page's buttons run `sudo -n gpu-mode ...`, which works once sudoers allows it
// without a password — the error says so otherwise. The mode itself is readable by all.
const GPU_MODE_STATE = process.env.GPU_MODE_STATE || '/run/gpu-mode';
async function gpuMode() {
  const have = await run('sh', ['-c', 'command -v gpu-mode']);
  if (!have.ok) return { available: false };
  const read = (f) => { try { return fs.readFileSync(path.join(GPU_MODE_STATE, f), 'utf8').trim(); } catch { return null; } };
  return { available: true, mode: read('mode') || 'work', by: read('by') || '-' };
}
// What GitHub says about a PR in flight, beside what the loop believes. The loop's
// inflight marker is refreshed only by reconcile, at the start of a tick, and one
// attempt can hold a tick for an hour — a PR merged a minute after adoption would sit
// on the page as "waiting on CI" until then. So the page asks gh itself, one call per
// PR per minute, and says "merged · the bead closes on the next tick" when it has.
const PR_TTL_MS = Number(process.env.BEAD_LOOP_UI_PR_TTL_MS || 60000);
// Refreshed off the request path: gh is a network call, and a slow one would hold up
// every page. state() reads the cache; a miss shows as the loop's own marker until the
// next refresh, a few seconds later.
const prCache = new Map();  // url -> { at, pr, repo }
async function refreshPrs() {
  for (const [url, hit] of prCache) {
    if (Date.now() - hit.at < PR_TTL_MS && hit.pr !== undefined) continue;
    hit.at = Date.now(); hit.pr = await fetchPr(hit.repo, url);
  }
}
async function fetchPr(repo, url) {
  const r = await run('gh', ['pr', 'view', url, '--json', 'state,mergedAt,statusCheckRollup'], { cwd: repo, timeout: 20000 });
  let pr = null;
  if (r.ok) {
    try {
      const j = JSON.parse(r.stdout);
      const checks = (j.statusCheckRollup || []).map((c) => ({ name: c.context || c.name || '?', state: c.conclusion || c.state || c.status || '?' }));
      pr = { state: j.state, mergedAt: j.mergedAt ? Math.floor(Date.parse(j.mergedAt) / 1000) : null, checks };
    } catch { pr = null; }
  }
  return pr;
}
function withPrs(repos) {
  const seen = new Set();
  for (const r of repos) for (const p of r.inflight) {
    seen.add(p.url);
    if (!prCache.has(p.url)) prCache.set(p.url, { at: 0, pr: undefined, repo: r.repo });
    p.pr = prCache.get(p.url).pr ?? null;
  }
  for (const url of prCache.keys()) if (!seen.has(url)) prCache.delete(url);
  if ([...prCache.values()].some((h) => h.pr === undefined || Date.now() - h.at >= PR_TTL_MS)) setImmediate(() => refreshPrs().then(() => broadcast()).catch(() => {}));
  return repos;
}
const timed = (label, p, into) => { const t0 = Date.now(); return p.finally(() => { into[label] = Date.now() - t0; }); };
async function state() {
  const t = {}, t0 = Date.now();
  const [status, timer, service, log, gpu] = await Promise.all([
    timed('status', run(SUPERVISOR, ['--json', 'status'], { timeout: 60000 }), t), timed('timer', unitState(`${UNIT}.timer`), t),
    timed('service', unitState(`${UNIT}.service`), t), timed('journal', journal(80), t), timed('gpu', gpuMode(), t),
  ]);
  if (Date.now() - t0 > 3000) console.error(`slow state: ${Date.now() - t0}ms`, JSON.stringify(t));
  return {
    now: Math.floor(Date.now() / 1000),
    repos: withPrs(jsonLines(status.stdout)),
    error: status.ok ? null : status.stderr.trim().split('\n').pop(),
    timer, service, log, gpu,
  };
}

// ---- live: one state, pushed to every open page when it changes ------------------------
// The page holds an EventSource on /api/events. The server recomputes the state every
// POLL_MS, and at once when the opencode server reports activity (its own /event stream)
// or a lever was pulled, and sends it only when something differs — so a page that is
// open shows a stage transition within a second or two of it happening, and an idle
// loop costs one `status` every few seconds, not one per page.
// Cadence: a compute costs most of a second of CPU (bash, jq, bd, yq, curl), so never
// more than one per MIN_GAP_MS however many nudges arrive, and none at all while no page
// is open.
const POLL_MS = Number(process.env.BEAD_LOOP_UI_POLL_MS || 5000);
const MIN_GAP_MS = Number(process.env.BEAD_LOOP_UI_MIN_GAP_MS || 2500);
const clients = new Set();
let lastSent = '', lastState = null, lastAt = 0, computing = null, wanted = false;
async function broadcast() {
  if (computing) { wanted = true; return computing; }
  const wait = lastAt + MIN_GAP_MS - Date.now();
  if (wait > 0) { if (!wanted) { wanted = true; setTimeout(() => { wanted = false; broadcast(); }, wait); } return null; }
  computing = (async () => {
    lastAt = Date.now();
    const s = await state();
    lastState = s;
    const body = JSON.stringify(s);
    // `now` alone changes every time; compare the rest.
    if (body.replace(/"now":\d+/, '') !== lastSent) {
      lastSent = body.replace(/"now":\d+/, '');
      for (const res of clients) res.write(`data: ${body}\n\n`);
    }
    return s;
  })().finally(() => { computing = null; if (wanted) { wanted = false; setImmediate(broadcast); } });
  return computing;
}
setInterval(() => { if (clients.size) broadcast(); }, POLL_MS);
setInterval(() => { for (const res of clients) res.write(': keepalive\n\n'); }, 20000);
function subscribe(res) {
  res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-store', connection: 'keep-alive' });
  clients.add(res);
  res.on('close', () => clients.delete(res));
  if (lastSent) res.write(`data: ${lastSent.replace(/^\{/, `{"now":${Math.floor(Date.now() / 1000)},`)}\n\n`);
  broadcast();
}
// Nudge from the opencode server: every event on its stream (a token, a tool call, a
// session finishing) is a reason to look again, debounced. Reconnects on its own.
async function followOpencode() {
  const repos = jsonLines((await run(SUPERVISOR, ['--json', 'status'])).stdout);
  const attach = repos.map((r) => r.attach).find(Boolean);
  if (!attach) return;
  let nudge = null;
  for (;;) {
    try {
      const res = await fetch(`${attach}/event`, { headers: { accept: 'text/event-stream' } });
      for await (const chunk of res.body) {
        if (clients.size && !nudge) nudge = setTimeout(() => { nudge = null; broadcast(); }, 2000);
        void chunk;
      }
    } catch { /* server down or restarting: try again below */ }
    await new Promise((r) => setTimeout(r, 5000));
  }
}
followOpencode();

// ---- the levers ------------------------------------------------------------------------
const ID = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;
async function knownRepos() {
  if (lastState) return lastState.repos;
  const r = await run(SUPERVISOR, ['--json', 'status']);
  return jsonLines(r.stdout);
}
const actions = {
  // abort {attach, session}: the server keeps a session running after its client is
  // gone; this is the same POST the supervisor makes when it notices.
  async abort({ attach, session }) {
    if (!ID.test(String(session || ''))) throw new Error('bad session id');
    const repos = await knownRepos();
    if (!repos.some((r) => r.attach && r.attach === attach)) throw new Error('unknown server');
    const res = await fetch(`${attach}/session/${session}/abort`, { method: 'POST' });
    if (!res.ok) throw new Error(`server said ${res.status}`);
    return { aborted: session };
  },
  async tick() { return systemctl('start', '--no-block', `${UNIT}.service`); },
  async stop() { return systemctl('stop', `${UNIT}.service`); },
  async timer({ on }) { return systemctl(on ? 'start' : 'stop', `${UNIT}.timer`); },
  // gpu {mode}: game | work. `sudo -n`: no password prompt, a clear error instead.
  async gpu({ mode }) {
    if (mode !== 'game' && mode !== 'work') throw new Error('mode is game or work');
    const r = await run('sudo', ['-n', 'gpu-mode', mode]);
    if (!r.ok) throw new Error((r.stderr.trim() || `gpu-mode exited ${r.code}`) + ' — allow it in sudoers: NOPASSWD for gpu-mode');
    return { mode };
  },
  // reopen {repo, id}: a parked bead back in the queue, `bd update ID --status open`.
  async reopen({ repo, id }) {
    if (!ID.test(String(id || ''))) throw new Error('bad bead id');
    const repos = await knownRepos();
    if (!repos.some((r) => r.repo === repo)) throw new Error('unknown repo');
    const r = await run('bd', ['update', id, '--status', 'open'], { cwd: repo });
    if (!r.ok) throw new Error(r.stderr.trim() || `bd exited ${r.code}`);
    return { reopened: id };
  },
};
async function systemctl(...args) {
  const r = await run('systemctl', ['--user', ...args]);
  if (!r.ok) throw new Error(r.stderr.trim() || `systemctl exited ${r.code}`);
  return { ran: `systemctl --user ${args.join(' ')}` };
}

// ---- http -------------------------------------------------------------------------------
const send = (res, code, body, type = 'application/json') => {
  res.writeHead(code, { 'content-type': type + '; charset=utf-8', 'cache-control': 'no-store' });
  res.end(type === 'application/json' ? JSON.stringify(body) : body);
};
const readBody = (req) => new Promise((resolve, reject) => {
  let s = ''; req.on('data', (c) => { s += c; if (s.length > 1e5) reject(new Error('body too large')); });
  req.on('end', () => { try { resolve(s ? JSON.parse(s) : {}); } catch (e) { reject(e); } });
});

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
  try {
    if (req.method === 'GET' && url.pathname === '/') return send(res, 200, fs.readFileSync(PAGE, 'utf8'), 'text/html');
    if (req.method === 'GET' && url.pathname === '/api/state') return send(res, 200, await state());
    if (req.method === 'GET' && url.pathname === '/api/events') return subscribe(res);
    if (req.method === 'POST' && url.pathname.startsWith('/api/')) {
      // Only the page itself may pull a lever: a browser sends Sec-Fetch-Site on every
      // request, and anything cross-site (another tab, another origin) is refused.
      const site = req.headers['sec-fetch-site'];
      if (site && site !== 'same-origin' && site !== 'none') return send(res, 403, { error: 'same-origin only' });
      const name = url.pathname.slice('/api/'.length);
      if (!actions[name]) return send(res, 404, { error: 'no such action' });
      const out = await actions[name](await readBody(req));
      setTimeout(broadcast, 300); setTimeout(broadcast, 2500);  // the lever's effect, once systemd/bd have acted
      return send(res, 200, out);
    }
    send(res, 404, { error: 'not found' });
  } catch (e) {
    send(res, 500, { error: e.message });
  }
});
server.listen(PORT, HOST, () => console.log(`bead-loop-ui: http://${HOST}:${PORT}  (supervisor: ${SUPERVISOR})`));
