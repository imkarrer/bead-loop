#!/usr/bin/env node
// bead-loop-ui: the loop on one page, and the few levers that are worth a button.
//
//   bead-loop-ui                 serve http://127.0.0.1:4097 (BEAD_LOOP_UI_PORT, BEAD_LOOP_UI_HOST)
//
// Reads: `bead-supervisor --json status` (the one description of a repo's state),
// `--json stats` (the scoreboard, once a minute), journalctl for the supervisor's log,
// systemctl for the resident loop and its keeper timer. Levers, each one command the operator would otherwise type:
//   abort a session on the opencode server, ring the bell (wake), stop the loop (its
//   TERM handler aborts the sessions it is on), start/stop the keeper timer, reopen a
//   parked bead, pause/resume one lane, make a repo the priority, gpu-mode game/work
//   where the box has it.
// The page holds an EventSource on /api/events and is pushed every change; nobody
// presses refresh. No dependencies beyond node; the page is ui/index.html.
'use strict';
const http = require('node:http');
const fs = require('node:fs');
const path = require('node:path');
const { execFile, spawn } = require('node:child_process');

const HOME = path.resolve(__dirname, '..');
// The supervisor: BEAD_SUPERVISOR, else this checkout's release or debug build, else PATH.
const SUPERVISOR = process.env.BEAD_SUPERVISOR
  || [path.join(HOME, 'target', 'release', 'bead-supervisor'), path.join(HOME, 'target', 'debug', 'bead-supervisor')].find((p) => fs.existsSync(p))
  || 'bead-supervisor';
const PAGE = path.join(HOME, 'ui', 'index.html');
const PORT = Number(process.env.BEAD_LOOP_UI_PORT || 4097);
const HOST = process.env.BEAD_LOOP_UI_HOST || '127.0.0.1';
const UNIT = 'bead-supervisor';

const run = (cmd, args, opts = {}) => new Promise((resolve) => {
  execFile(cmd, args, { maxBuffer: 16 << 20, ...opts }, (err, stdout, stderr) =>
    resolve({ ok: !err, code: err ? err.code : 0, stdout: String(stdout || ''), stderr: String(stderr || '') }));
});
const jsonLines = (s) => s.split('\n').filter(Boolean).map((l) => { try { return JSON.parse(l); } catch { return null; } }).filter(Boolean);

// ---- what the page reads -------------------------------------------------------------
async function unitState(name) {
  const r = await run('systemctl', ['--user', 'show', name, '-p', 'ActiveState,SubState,ExecMainStartTimestamp,LastTriggerUSec,NextElapseUSecRealtime,Result,TimersMonotonic']);
  if (!r.ok) return { available: false };
  const p = Object.fromEntries(r.stdout.split('\n').filter(Boolean).map((l) => l.split(/=(.*)/s).slice(0, 2)));
  const gap = (r.stdout.match(/OnUnitInactiveUSec=([^ ;]+)/) || [])[1] || null;
  return { available: true, active: p.ActiveState, sub: p.SubState, next: p.NextElapseUSecRealtime || null,
           since: p.ExecMainStartTimestamp || p.LastTriggerUSec || null, result: p.Result || null, gap };
}
async function journal(n) {
  const r = await run('journalctl', ['--user', '-u', `${UNIT}.service`, '-o', 'json', '-n', String(n), '--no-pager']);
  if (!r.ok) return [];
  return jsonLines(r.stdout).map((e) => ({ t: Math.floor(Number(e.__REALTIME_TIMESTAMP) / 1e6), msg: typeof e.MESSAGE === 'string' ? e.MESSAGE : '' }))
    .filter((e) => !/^bead-supervisor\.service: Consumed /.test(e.msg));  // systemd's accounting line, not the loop's
}
// gpu-mode, where the box has one (bead-loop's own workstation does: `gpu-mode game`
// stops the loop and the local model server to free the GPU for a game, `gpu-mode work`
// starts them again, and a guard flips it by itself while a game runs). It needs root;
// the page's buttons run `sudo -n gpu-mode ...`, which works once sudoers allows it
// without a password — the error says so otherwise. The mode itself is readable by all.
const GPU_MODE_STATE = process.env.GPU_MODE_STATE || '/run/gpu-mode';
async function gpuMode() {
  const have = await run('sh', ['-c', 'command -v gpu-mode']);
  if (!have.ok) return { available: false };
  const read = (f) => { try { return fs.readFileSync(path.join(GPU_MODE_STATE, f), 'utf8').trim(); } catch { return null; } };
  return { available: true, mode: read('mode') || 'work', by: read('by') || '-' };
}
// What GitHub says about a PR in flight, beside what the loop believes. The loop's merge
// watcher asks every 30 s while a PR is open; the page asks once a minute on its own so
// a PR merged elsewhere shows as merged before the watcher's next look.
const PR_TTL_MS = Number(process.env.BEAD_LOOP_UI_PR_TTL_MS || 60000);
// Refreshed off the request path: gh is a network call, and a slow one would hold up
// every page. state() reads the cache; a miss shows as the loop's own marker until the
// next refresh, a few seconds later.
const prCache = new Map();  // url -> { at, pr, repo }
async function refreshPrs() {
  for (const [url, hit] of prCache) {
    if (Date.now() - hit.at < PR_TTL_MS && hit.pr !== undefined) continue;
    hit.at = Date.now(); hit.pr = await fetchPr(hit.repo, url);
  }
}
async function fetchPr(repo, url) {
  const r = await run('gh', ['pr', 'view', url, '--json', 'state,mergedAt,mergeable,statusCheckRollup'], { cwd: repo, timeout: 20000 });
  let pr = null;
  if (r.ok) {
    try {
      const j = JSON.parse(r.stdout);
      const checks = (j.statusCheckRollup || []).map((c) => ({ name: c.context || c.name || '?', state: c.conclusion || c.state || c.status || '?' }));
      pr = { state: j.state, mergedAt: j.mergedAt ? Math.floor(Date.parse(j.mergedAt) / 1000) : null, checks, mergeable: j.mergeable || null };
    } catch { pr = null; }
  }
  return pr;
}
function withPrs(repos) {
  const seen = new Set();
  for (const r of repos) for (const p of r.queues.merge) {
    seen.add(p.url);
    if (!prCache.has(p.url)) prCache.set(p.url, { at: 0, pr: undefined, repo: r.repo });
    p.pr = prCache.get(p.url).pr ?? null;
  }
  for (const url of prCache.keys()) if (!seen.has(url)) prCache.delete(url);
  if ([...prCache.values()].some((h) => h.pr === undefined || Date.now() - h.at >= PR_TTL_MS)) setImmediate(() => refreshPrs().then(() => broadcast()).catch(() => {}));
  return repos;
}
// The scoreboard: `bead-supervisor --json stats` reads every bead the loop touched and
// every session log, a few seconds of bd — so it is refreshed off the request path, once
// a minute (BEAD_LOOP_UI_STATS_TTL_MS), and the page gets the last one until then.
const STATS_TTL_MS = Number(process.env.BEAD_LOOP_UI_STATS_TTL_MS || 60000);
let stats = { at: 0, v: null, running: null };
function statsNow() {
  if (stats.running || Date.now() - stats.at < STATS_TTL_MS) return stats.v;
  stats.running = run(SUPERVISOR, ['--json', 'stats'], { timeout: 120000 }).then((r) => {
    stats.at = Date.now();
    if (r.ok) { try { stats.v = JSON.parse(r.stdout); } catch { /* keep the last one */ } }
  }).finally(() => { stats.running = null; if (clients.size) setImmediate(broadcast); });
  return stats.v;
}
const timed = (label, p, into) => { const t0 = Date.now(); return p.finally(() => { into[label] = Date.now() - t0; }); };
// Whether headless Claude Code can run: a claude/* stage fails on the spot when the
// login has lapsed, and nothing else on the page would say so. `claude auth status` is
// local and instant; asked once a minute, and only when a stage names claude/*.
let claudeAuth = { at: 0, v: null };
let login = null;  // the claude auth login in progress, if any
async function claudeStatus(repos) {
  if (!repos.some((r) => r.stages.some((st) => /^claude\//.test(st.worker) || /^claude\//.test(st.reviewer || '')))) return null;
  if (Date.now() - claudeAuth.at < 60000) return claudeAuth.v;
  // `claude auth status` exits 1 when signed out, with the JSON on stdout all the same:
  // read the JSON first, and treat a failure without JSON as claude missing.
  const r = await run('claude', ['auth', 'status'], { timeout: 10000 });
  let v;
  try { const j = JSON.parse(r.stdout); v = { available: true, loggedIn: !!j.loggedIn, method: j.authMethod || null }; }
  catch { v = { available: false, loggedIn: false, error: r.stderr.trim().split('\n').pop() || (r.code === 'ENOENT' ? 'claude not on PATH' : `claude auth status exited ${r.code}`) }; }
  claudeAuth = { at: Date.now(), v };
  return v;
}
async function state() {
  const t = {}, t0 = Date.now();
  const [status, timer, service, log, gpu] = await Promise.all([
    timed('status', run(SUPERVISOR, ['--json', 'status'], { timeout: 60000 }), t), timed('timer', unitState(`${UNIT}.timer`), t),
    timed('service', unitState(`${UNIT}.service`), t), timed('journal', journal(80), t), timed('gpu', gpuMode(), t),
  ]);
  if (Date.now() - t0 > 3000) console.error(`slow state: ${Date.now() - t0}ms`, JSON.stringify(t));
  const repos = withPrs(jsonLines(status.stdout));
  return {
    now: Math.floor(Date.now() / 1000),
    repos, claude: await claudeStatus(repos), stats: statsNow(),
    login: login && !login.done ? { url: login.url, started: Math.floor(login.at / 1000) } : null,
    error: status.ok ? null : status.stderr.trim().split('\n').pop(),
    timer, service, log, gpu,
  };
}

// ---- live: one state, pushed to every open page when it changes ------------------------
// The page holds an EventSource on /api/events. The server recomputes the state every
// POLL_MS, and at once when the opencode server reports activity (its own /event stream)
// or a lever was pulled, and sends it only when something differs — so a page that is
// open shows a stage transition within a second or two of it happening, and an idle
// loop costs one `status` every few seconds, not one per page.
// Cadence: never more than one compute per MIN_GAP_MS however many nudges arrive, and
// none at all while no page is open.
const POLL_MS = Number(process.env.BEAD_LOOP_UI_POLL_MS || 5000);
const MIN_GAP_MS = Number(process.env.BEAD_LOOP_UI_MIN_GAP_MS || 2500);
const clients = new Set();
let lastSent = '', lastState = null, lastAt = 0, computing = null, wanted = false;
async function broadcast() {
  if (computing) { wanted = true; return computing; }
  const wait = lastAt + MIN_GAP_MS - Date.now();
  if (wait > 0) { if (!wanted) { wanted = true; setTimeout(() => { wanted = false; broadcast(); }, wait); } return null; }
  computing = (async () => {
    lastAt = Date.now();
    const s = await state();
    lastState = s;
    const body = JSON.stringify(s);
    // `now` is the first key and changes every time; the rest is what is compared, and
    // what a new page is replayed (with a fresh `now` put back in front).
    const rest = body.replace(/^\{"now":\d+,/, '{');
    if (rest !== lastSent) {
      lastSent = rest;
      for (const res of clients) res.write(`data: ${body}\n\n`);
    }
    return s;
  })().finally(() => { computing = null; if (wanted) { wanted = false; setImmediate(broadcast); } });
  return computing;
}
setInterval(() => { if (clients.size) broadcast(); }, POLL_MS);
setInterval(() => { for (const res of clients) res.write(': keepalive\n\n'); }, 20000);
const withNow = (rest) => rest.replace(/^\{/, `{"now":${Math.floor(Date.now() / 1000)},`);
function subscribe(res) {
  res.writeHead(200, { 'content-type': 'text/event-stream', 'cache-control': 'no-store', connection: 'keep-alive' });
  clients.add(res);
  res.on('close', () => clients.delete(res));
  if (lastSent) res.write(`data: ${withNow(lastSent)}\n\n`);
  broadcast();
}
// Nudge from the opencode server: every event on its stream (a token, a tool call, a
// session finishing) is a reason to look again, debounced. Reconnects on its own.
async function followOpencode() {
  const repos = jsonLines((await run(SUPERVISOR, ['--json', 'status'])).stdout);
  const attach = repos.map((r) => r.attach).find(Boolean);
  if (!attach) return;
  let nudge = null;
  for (;;) {
    try {
      const res = await fetch(`${attach}/event`, { headers: { accept: 'text/event-stream' } });
      for await (const chunk of res.body) {
        if (clients.size && !nudge) nudge = setTimeout(() => { nudge = null; broadcast(); }, 2000);
        void chunk;
      }
    } catch { /* server down or restarting: try again below */ }
    await new Promise((r) => setTimeout(r, 5000));
  }
}
followOpencode();

// ---- the levers ------------------------------------------------------------------------
const ID = /^[A-Za-z0-9][A-Za-z0-9._-]*$/;
async function knownRepos() {
  if (lastState) return lastState.repos;
  const r = await run(SUPERVISOR, ['--json', 'status']);
  return jsonLines(r.stdout);
}
async function supervisor(args) {
  const r = await run(SUPERVISOR, args);
  if (!r.ok) throw new Error(r.stderr.trim().split('\n').pop() || `supervisor exited ${r.code}`);
  return r;
}
const actions = {
  // abort {attach, session}: the server keeps a session running after its client is
  // gone; this is the same POST the supervisor makes when it notices.
  async abort({ attach, session }) {
    if (!ID.test(String(session || ''))) throw new Error('bad session id');
    const repos = await knownRepos();
    if (!repos.some((r) => r.attach && r.attach === attach)) throw new Error('unknown server');
    const res = await fetch(`${attach}/session/${session}/abort`, { method: 'POST' });
    if (!res.ok) throw new Error(`server said ${res.status}`);
    return { aborted: session };
  },
  // wake: ring the bell — every lane looks at its queue now (it would within a second anyway).
  async wake() { await supervisor(['wake']); return { woke: true }; },
  // lane {name, paused}: the lane starts no new round until resumed; the other goes on.
  async lane({ name, paused }) {
    // A lane name from the page: one of the configured lanes ([[lanes]]), or the defaults.
    if (!/^[a-z][a-z0-9_-]{0,31}$/.test(String(name || ''))) throw new Error('bad lane name');
    const repos = await knownRepos();
    if (!repos.some((r) => (r.lane_names || ['dev', 'review']).includes(name))) throw new Error(`no lane named ${name}`);
    await supervisor([paused ? 'pause' : 'resume', name]);
    return { lane: name, paused: !!paused };
  },
  // stop: the loop's TERM handler aborts the sessions it is on; the keeper timer starts it
  // again in a minute unless the timer is stopped too (loop {on:false}).
  async stop() { return systemctl('stop', `${UNIT}.service`); },
  // loop {on}: the loop and its keeper together — off is a real stop, on brings it back now.
  async loop({ on }) {
    if (on) return systemctl('start', `${UNIT}.timer`);
    await systemctl('stop', `${UNIT}.timer`);
    return systemctl('stop', `${UNIT}.service`);
  },
  async timer({ on }) { return systemctl(on ? 'start' : 'stop', `${UNIT}.timer`); },
  // priority {repo}: the repo the lanes look at first on every pass; 'none' clears it.
  async priority({ repo }) {
    const repos = await knownRepos();
    if (repo !== 'none' && !repos.some((r) => r.repo === repo)) throw new Error('unknown repo');
    await supervisor(['priority', repo]);
    return { priority: repo };
  },
  // gpu {mode}: game | work. `sudo -n`: no password prompt, a clear error instead.
  async gpu({ mode }) {
    if (mode !== 'game' && mode !== 'work') throw new Error('mode is game or work');
    const r = await run('sudo', ['-n', 'gpu-mode', mode]);
    if (!r.ok) throw new Error((r.stderr.trim() || `gpu-mode exited ${r.code}`) + ' — allow it in sudoers: NOPASSWD for gpu-mode');
    return { mode };
  },
  // escalate {repo, id}: work this with Claude — the bead goes to the last stage and back
  // into the dev queue; the supervisor rings the bell itself.
  async escalate({ repo, id }) {
    if (!ID.test(String(id || ''))) throw new Error('bad bead id');
    const repos = await knownRepos();
    if (!repos.some((r) => r.repo === repo)) throw new Error('unknown repo');
    await supervisor(['escalate', repo, id]);
    return { escalated: id };
  },
  // Signing Claude in from the page. `claude auth login` prints a sign-in url and waits
  // on stdin for the code the browser shows at the end; the page shows the url, takes
  // the code, and hands it over. One login at a time; a stale one is dropped after 10 min.
  async claude_login() {
    if (login && !login.done) return { url: login.url, started: login.at };
    const child = spawn('claude', ['auth', 'login'], { stdio: ['pipe', 'pipe', 'pipe'] });
    login = { child, url: null, at: Date.now(), done: false, result: null, out: '' };
    const onData = (c) => { login.out += String(c); const m = login.out.replace(/\x1b\[[0-9;?]*[a-zA-Z]|\x1b\]8;;[^\x07\x1b]*\x07/g, '').match(/https:\/\/\S+/); if (m && !login.url) login.url = m[0]; };
    child.stdout.on('data', onData); child.stderr.on('data', onData);
    child.on('exit', (code) => { login.done = true; login.result = code === 0 ? 'ok' : (login.out.trim().split('\n').pop() || `exited ${code}`); claudeAuth.at = 0; });
    setTimeout(() => { if (login && !login.done && login.child === child) child.kill(); }, 600000).unref();
    await new Promise((r) => { const t = setInterval(() => { if (login.url || login.done) { clearInterval(t); r(); } }, 100); setTimeout(() => { clearInterval(t); r(); }, 8000); });
    if (!login.url) throw new Error(login.done ? `claude auth login: ${login.result}` : 'no sign-in url from claude auth login yet');
    return { url: login.url, started: login.at };
  },
  async claude_code({ code }) {
    if (!login || login.done) throw new Error('no sign-in in progress — start one first');
    if (!/^[A-Za-z0-9#_.-]{6,}$/.test(String(code || '').trim())) throw new Error('that does not look like the code');
    login.child.stdin.write(String(code).trim() + '\n');
    await new Promise((r) => { const t = setInterval(() => { if (login.done) { clearInterval(t); r(); } }, 200); setTimeout(() => { clearInterval(t); r(); }, 20000); });
    if (!login.done) throw new Error('claude did not finish signing in; try the code again or start over');
    if (login.result !== 'ok') throw new Error(login.result);
    // Signed in: the loop's beads waiting on Claude can go now.
    await run(SUPERVISOR, ['wake']);
    return { loggedIn: true };
  },
  async claude_cancel() { if (login && !login.done) login.child.kill(); login = null; return { cancelled: true }; },
  // answer {repo, id, text}: the reply to a bead in the human queue — noted on the bead,
  // back to the dev queue at the stage it stopped on; the supervisor rings the bell.
  async answer({ repo, id, text }) {
    if (!ID.test(String(id || ''))) throw new Error('bad bead id');
    if (!String(text || '').trim()) throw new Error('write the answer first');
    const repos = await knownRepos();
    if (!repos.some((r) => r.repo === repo)) throw new Error('unknown repo');
    await supervisor(['answer', repo, id, String(text).trim()]);
    return { answered: id };
  },
  // decide {repo, id, text}: your answer to a decision bead — `bd close ID --reason
  // "decided: TEXT"`, the reason being where whoever asked reads it; then the bell, since
  // beads that depended on the decision are ready now.
  async decide({ repo, id, text }) {
    if (!ID.test(String(id || ''))) throw new Error('bad bead id');
    if (!String(text || '').trim()) throw new Error('write the decision first');
    const repos = await knownRepos();
    const rp = repos.find((r) => r.repo === repo);
    if (!rp) throw new Error('unknown repo');
    if (!(rp.decisions || []).some((d) => d.id === id)) throw new Error(`${id} is not an open decision`);
    const r = await run('bd', ['close', id, '--reason', `decided: ${String(text).trim()}`], { cwd: repo });
    if (!r.ok) throw new Error(r.stderr.trim() || `bd exited ${r.code}`);
    await run(SUPERVISOR, ['wake']);
    return { decided: id };
  },
  // reopen {repo, id}: a parked bead back in the queue, `bd update ID --status open`,
  // then the bell. A bead under a PR is refused: the merge queue is what moves it.
  async reopen({ repo, id }) {
    if (!ID.test(String(id || ''))) throw new Error('bad bead id');
    const repos = await knownRepos();
    const rp = repos.find((r) => r.repo === repo);
    if (!rp) throw new Error('unknown repo');
    if (rp.queues.merge.some((p) => p.id === id)) throw new Error(`${id} is in the merge queue; close its PR first, or wait for it`);
    const r = await run('bd', ['update', id, '--status', 'open'], { cwd: repo });
    if (!r.ok) throw new Error(r.stderr.trim() || `bd exited ${r.code}`);
    await run(SUPERVISOR, ['wake']);
    return { reopened: id };
  },
};
async function systemctl(...args) {
  const r = await run('systemctl', ['--user', ...args]);
  if (!r.ok) throw new Error(r.stderr.trim() || `systemctl exited ${r.code}`);
  return { ran: `systemctl --user ${args.join(' ')}` };
}

// ---- http -------------------------------------------------------------------------------
const send = (res, code, body, type = 'application/json') => {
  res.writeHead(code, { 'content-type': type + '; charset=utf-8', 'cache-control': 'no-store' });
  res.end(type === 'application/json' ? JSON.stringify(body) : body);
};
const readBody = (req) => new Promise((resolve, reject) => {
  let s = ''; req.on('data', (c) => { s += c; if (s.length > 1e5) reject(new Error('body too large')); });
  req.on('end', () => { try { resolve(s ? JSON.parse(s) : {}); } catch (e) { reject(e); } });
});

const server = http.createServer(async (req, res) => {
  const url = new URL(req.url, `http://${req.headers.host || 'localhost'}`);
  try {
    if (req.method === 'GET' && url.pathname === '/') return send(res, 200, fs.readFileSync(PAGE, 'utf8'), 'text/html');
    if (req.method === 'GET' && url.pathname === '/api/state') return send(res, 200, await state());
    if (req.method === 'GET' && url.pathname === '/api/events') return subscribe(res);
    if (req.method === 'POST' && url.pathname.startsWith('/api/')) {
      // Only the page itself may pull a lever: a browser sends Sec-Fetch-Site on every
      // request, and anything cross-site (another tab, another origin) is refused.
      const site = req.headers['sec-fetch-site'];
      if (site && site !== 'same-origin' && site !== 'none') return send(res, 403, { error: 'same-origin only' });
      const name = url.pathname.slice('/api/'.length);
      if (!actions[name]) return send(res, 404, { error: 'no such action' });
      const out = await actions[name](await readBody(req));
      setTimeout(broadcast, 300); setTimeout(broadcast, 2500);  // the lever's effect, once systemd/bd have acted
      return send(res, 200, out);
    }
    send(res, 404, { error: 'not found' });
  } catch (e) {
    send(res, 500, { error: e.message });
  }
});
server.listen(PORT, HOST, () => console.log(`bead-loop-ui: http://${HOST}:${PORT}  (supervisor: ${SUPERVISOR})`));
