#!/usr/bin/env bash
# bead-supervisor: work labelled beads in any repo with local models, one at a
# time: implement, gate, review, PR, merge on green, close the bead.
#
#   bead-supervisor tick [REPO...]        reconcile the merge queue, then run the dev and review lanes
#                                         side by side until both queues are drained; the timer's job is the waits
#   bead-supervisor work REPO [BEAD_ID]   one bead through dev and review now (top of the dev queue, or the id given)
#   bead-supervisor lane dev|review       one lane by itself, until its queue is empty
#   bead-supervisor pause dev|review      the lane starts no new round until `resume` (the other lane goes on)
#   bead-supervisor resume dev|review
#   bead-supervisor escalate REPO ID      put the bead on the last stage (Claude, usually) and back in the dev
#                                         queue now, ahead of its failure count; the next tick works it there
#   bead-supervisor reconcile [REPO...]   only the merge queue: merge green, close beads, send red back to dev
#   bead-supervisor status [REPO...]      what is in flight: PRs, ready beads, worktrees and their sessions
#   bead-supervisor watch [REPO...]       status every 5 s (BEAD_LOOP_WATCH=N), the last log lines above it
#   bead-supervisor log REPO [BEAD_ID]    follow the newest worker/reviewer session: tool calls and text
#
#   --dry-run    pick the bead, print the prompt, change nothing
#   --once       tick: one pass of each lane, in turn, whether or not more is queued
#   --serial     tick: the lanes one after the other instead of side by side
#   --json       status as one JSON object per repo (what the web UI reads)
#   --local      implement, gate and review; keep the branch here, no push, no PR
#   --model M    opencode provider/model for the worker this run
#
# Config, TOML, every key optional. A key in the repo file wins over the global one:
#   ~/.config/bead-loop/config.toml   repos (list), model, review_model, stages (worker, reviewer, failures), on_exhaust, adopt,
#                                     max_inflight, worker_timeout, attach (an opencode server url:
#                                     sessions run there and stream in its web UI)
#   REPO/.bead-loop.toml              label, base, setup, gate, merge (auto|pipeline|manual), merge_label, plus any key above
# Defaults: label=delegate:local  base=origin's HEAD  max_inflight=1  adopt=true
#           merge=auto (a tick merges on green; pipeline: the loop labels the PR with merge_label,
#           default "automerge", and CI merges it; manual: PR only)
#           worker_timeout=3600 (seconds)  setup unset  gate unset (CI is the gate)
#           review_model unset (no review). Set it and a second model judges the diff
#           before the push; the worker gets one revision round on a REJECT.
#           stages unset = one stage with model/review_model, one failure, then park.
set -euo pipefail

BEAD_LOOP_HOME=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
CONFIG_DIR=${BEAD_LOOP_CONFIG:-$HOME/.config/bead-loop}
STATE_DIR=${BEAD_LOOP_STATE:-$HOME/.local/state/bead-loop}
mkdir -p "$STATE_DIR"

log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" >&2; }
die() { log "error: $*"; exit 1; }

need() { command -v "$1" >/dev/null || die "$1 is not installed"; }
need bd; need jq; need git; need opencode; need yq

# toml_json FILE: the file as one JSON object ({} when absent or empty).
toml_json() {
  [ -f "$1" ] || { printf '{}'; return; }
  yq -p toml -o json '. // {}' "$1" || die "cannot parse $1"
}
# cfg KEY [DEFAULT]: the repo file, then the global one, then DEFAULT. Scalars come
# back as text (booleans as true/false); arrays joined by spaces.
cfg() {
  local v
  v=$(jq -rn --argjson r "${R_JSON:-{\}}" --argjson g "$G_JSON" --arg k "$1" \
    '($r[$k] // $g[$k] // empty) | if type == "array" then map(tostring) | join(" ") else tostring end')
  printf '%s' "${v:-${2-}}"
}
# stages_words: the stages table as "worker:reviewer:failures:timeout" words, the
# form stage_for walks; empty when no file sets one. `attempts` is the older name
# for `failures` and still reads.
stages_words() {
  jq -rn --argjson r "${R_JSON:-{\}}" --argjson g "$G_JSON" '($r.stages // $g.stages // [])
    | map(if .worker == null then error("a stage needs a worker") else . end)
    | map([.worker, (.reviewer // ""), (.failures // .attempts // 1), (.timeout // "")] | map(tostring) | join(":")) | join(" ")'
}

DRY=0 LOCAL=0 JSON=0 ONCE=0 SERIAL=0 MODEL_FLAG=
S_MODEL='' S_REVIEW='' S_TIMEOUT='' S_LAST=0 LANE='' LAST_ID=''
ARGS=()
while [ $# -gt 0 ]; do
  case $1 in
    --dry-run) DRY=1 ;;
    --once) ONCE=1; SERIAL=1 ;;
    --serial) SERIAL=1 ;;
    --json) JSON=1 ;;
    --local) LOCAL=1 ;;
    --model) MODEL_FLAG=$2; shift ;;
    -h|--help) sed -n '2,30p' "$0"; exit 0 ;;
    *) ARGS+=("$1") ;;
  esac
  shift
done
CMD=${ARGS[0]:-tick}
REPOS=("${ARGS[@]:1}")
G_CONF=$CONFIG_DIR/config.toml
G_JSON=$(toml_json "$G_CONF")
case $CMD in lane|pause|resume) LANE_NAME=${REPOS[0]:-}; REPOS=("${REPOS[@]:1}") ;; esac
if [ ${#REPOS[@]} -eq 0 ] && [ "$CMD" != work ] && [ "$CMD" != log ]; then
  # repos = ["~/src/a", ...]; a leading ~ is the home directory.
  while IFS= read -r r; do [ -n "$r" ] && REPOS+=("${r/#\~/$HOME}"); done <<<"$(printf '%s' "$G_JSON" | jq -r '.repos // [] | .[]')"
fi
[ ${#REPOS[@]} -gt 0 ] || die "no repos: pass one or set repos in $G_CONF"

# ---- per-repo context -------------------------------------------------------
load_repo() {
  REPO=$(cd "$1" && pwd) || die "no such repo: $1"
  [ -d "$REPO/.beads" ] || die "$REPO has no .beads/"
  R_JSON=$(toml_json "$REPO/.bead-loop.toml")
  SLUG=$(basename "$REPO")
  LABEL=$(cfg label delegate:local)
  MERGE=$(cfg merge auto)
  MERGE_LABEL=$(cfg merge_label automerge)
  SETUP=$(cfg setup)
  GATE=$(cfg gate)
  MODEL=${MODEL_FLAG:-$(cfg model)}
  REVIEW_MODEL=$(cfg review_model)
  STAGES=$(stages_words); STAGES=${STAGES:-$MODEL:$REVIEW_MODEL:3}
  ON_EXHAUST=$(cfg on_exhaust park)
  ADOPT=$(cfg adopt true)
  case " $STAGES " in *" claude/"*|*":claude/"*) need claude ;; esac
  MAX_INFLIGHT=$(cfg max_inflight 1)
  WORKER_TIMEOUT=$(cfg worker_timeout 3600)
  ATTACH=$(cfg attach)
  BASE=$(cfg base)
  if [ -z "$BASE" ]; then
    BASE=$(git -C "$REPO" symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null | sed 's|^origin/||')
    [ -n "$BASE" ] || BASE=$(git -C "$REPO" remote show origin 2>/dev/null | sed -n 's/.*HEAD branch: //p')
  fi
  [ -n "$BASE" ] || die "$SLUG: cannot tell the base branch; set base in .bead-loop.toml"
  RS=$STATE_DIR/$SLUG
  mkdir -p "$RS/inflight" "$RS/logs" "$RS/wt" "$RS/review"
  # attempts/ was the older name for failures/: same counter, carried over file by file
  # (a status run may have made failures/ first), then the old directory goes.
  mkdir -p "$RS/failures"
  if [ -d "$RS/attempts" ]; then
    local old
    for old in "$RS"/attempts/*; do [ -e "$old" ] && [ ! -e "$RS/failures/$(basename "$old")" ] && mv "$old" "$RS/failures/"; done
    rm -rf "$RS/attempts"
  fi
}

# Every bd call the loop makes acts as the label, not as the git user, so the
# assignee and the audit trail say the model did it; a BEADS_ACTOR in the
# environment still wins (bd's own contract).
bdr() { (cd "$REPO" && BEADS_ACTOR=${BEADS_ACTOR:-$LABEL} bd "$@"); }
# claim ID: the bead is ours now. A bead in the dev queue is open, so an assignee left
# on it — a hand claim, a round under another actor name — is stale, and bd's --claim
# refusing it ("already claimed by X") is not a reason to fail the tick.
claim() {
  bdr update "$1" --claim >/dev/null 2>&1 || bdr update "$1" --status in_progress --assignee "${BEADS_ACTOR:-$LABEL}" >/dev/null
}
ghr() { (cd "$REPO" && gh "$@"); }
# Markers beside an inflight file are hidden (.ID.red, .ID.nocheck, .ID.adopted);
# bead ids carry dots themselves, so the marker is what starts with one.
mark() { printf '%s/inflight/.%s.%s' "$RS" "$1" "$2"; }
# PRs this loop opened and is waiting on: adopted ones cost CI, not the model.
inflight_count() {
  local f n=0
  for f in "$RS"/inflight/*; do
    [ -e "$f" ] || continue
    [ -e "$(mark "$(basename "$f")" adopted)" ] || n=$((n + 1))
  done
  echo "$n"
}

# ---- the models -------------------------------------------------------------
# run_agent AGENT MODEL DIR LOG PROMPT [TITLE]: one non-interactive session, in the harness
# the model name selects: "claude/<alias>" is Claude Code (claude -p, the agent file's
# body as its system prompt, tools by role); anything else is an opencode agent.
# Prints the last text the agent wrote; returns the harness's exit code.
run_agent() {
  local agent=$1 model=$2 dir=$3 logf=$4 prompt=$5 title=${6:-} rc=0
  case $model in
    claude/*)
      local tools sys
      case $agent in
        bead-reviewer) tools='Read,Glob,Grep,Bash(git *),Bash(cat *),Bash(ls *),Bash(rg *),Bash(grep *)' ;;
        *)             tools='Read,Edit,Write,Glob,Grep,Bash' ;;
      esac
      sys=$(awk 'c>=2{print} /^---$/{c++}' "$BEAD_LOOP_HOME/agents/$agent.md")
      (cd "$dir" && timeout --foreground "$WORKER_TIMEOUT" claude -p "$prompt" --model "${model#claude/}" \
          --output-format json --allowedTools "$tools" --append-system-prompt "$sys" \
          --no-session-persistence) >"$logf" 2>"$logf.err" || rc=$?
      jq -r '.result // empty' "$logf" 2>/dev/null | tail -20
      ;;
    *)
      # --title: the session's name in the web UI, said by us. Left to opencode, a model
      # call names it from the prompt, and on a busy box that call has come back as "????".
      OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1 \
      timeout --foreground "$WORKER_TIMEOUT" opencode run --dir "$dir" --agent "$agent" \
          ${ATTACH:+--attach "$ATTACH"} ${model:+-m "$model"} ${title:+--title "$title"} --format json "$prompt" >"$logf" 2>"$logf.err" || rc=$?
      # The client is gone (timeout, a kill); with attach the server would keep working
      # the session for nobody. Its log may still be empty, so ask the server by directory.
      [ $rc -eq 0 ] || abort_sessions "$dir"
      jq -r 'select(.type=="text") | .part.text' "$logf" 2>/dev/null | tail -20
      ;;
  esac
  return $rc
}

# abort_sessions DIR: stop every session the attached server is still running under DIR.
# One attempt owns a worktree, so anything busy there is this attempt's, or an orphan of
# an earlier one; either way nothing is waiting for it.
abort_sessions() {
  local sid
  [ -n "${ATTACH:-}" ] && command -v curl >/dev/null || return 0
  for sid in $(curl -sfG -m 5 "$ATTACH/session/status" --data-urlencode "directory=$1" 2>/dev/null | jq -r 'keys[]' 2>/dev/null); do
    log "${SLUG:-}: aborting session $sid on $ATTACH"
    curl -sf -m 5 -X POST "$ATTACH/session/$sid/abort" >/dev/null 2>&1 || true
  done
}
# systemd stops the unit by signalling the whole cgroup: the client dies with us, the
# server-side session would not. CUR_WT is the worktree this process is working, LANE
# the lane it is (each lane runs in its own subshell, and installs this trap itself).
CUR_WT=
on_signal() { [ -n "$CUR_WT" ] && abort_sessions "$CUR_WT"; [ -n "$LANE" ] && rm -f "${RS:-/nonexistent}/lane.$LANE"; exit 143; }
trap on_signal TERM INT

render_bead() {
  jq -r '.[0] | "id: \(.id)\ntitle: \(.title)\ntype: \(.issue_type // "task")   priority: P\(.priority)\n\nDESCRIPTION:\n\(.description // "")\n\nACCEPTANCE CRITERIA:\n\(.acceptance_criteria // "(none given: the description is the criterion)")" + (if (.design // "") != "" then "\n\nDESIGN:\n\(.design)" else "" end) + (if (.notes // "") != "" then "\n\nNOTES:\n\(.notes)" else "" end)'
}

# Commit whatever the worker left uncommitted (the gate, reviewer and CI judge it),
# with .beads/ restored. Returns 1 when the branch has no commits over base.
settle_worktree() {
  local wt=$1 msg=$2
  git -C "$wt" checkout -q -- .beads 2>/dev/null || true
  if [ -n "$(git -C "$wt" status --porcelain)" ]; then
    git -C "$wt" add -A && git -C "$wt" commit -q -m "$msg"
  fi
  [ -n "$(git -C "$wt" rev-list "origin/$BASE..HEAD")" ]
}

run_gate() {
  local wt=$1 logf=$2
  [ -n "$GATE" ] || return 0
  log "$SLUG: gate: $GATE"
  (cd "$wt" && bash -c "$GATE") >"$logf" 2>&1
}

# ---- failures and stages ----------------------------------------------------
# A bead's failure count is how many times it has been sent back to the dev queue:
# from dev itself (BLOCKED, no commit, the gate failing twice), from review (REJECT),
# from merge (CI red). failures/ID holds the count, failures/ID.notes the history the
# next worker reads. STAGES is "worker:reviewer:failures:timeout" words, one per
# [[stages]] table, in order: a stage takes the bead for the next N failures, so a
# bead with more failures lands on a later, stronger stage. stage_for N resolves a
# failure count into S_MODEL S_REVIEW S_TIMEOUT S_LAST, or returns 1 when exhausted.
failures_of() { cat "$RS/failures/$1" 2>/dev/null || echo 0; }
stage_for() {
  local n=$1 total=0 s a
  for s in $STAGES; do IFS=: read -r _ _ a _ <<<"$s"; total=$((total + ${a:-1})); done
  if [ "$n" -ge "$total" ]; then
    [ "$ON_EXHAUST" = repeat ] || return 1
    n=$((n % total))
  fi
  local i=0 count=0
  set -- $STAGES
  for s in "$@"; do
    i=$((i + 1)); IFS=: read -r S_MODEL S_REVIEW a S_TIMEOUT <<<"$s"
    count=$((count + ${a:-1}))
    if [ "$n" -lt "$count" ]; then
      S_TIMEOUT=${S_TIMEOUT:-$WORKER_TIMEOUT}; S_LAST=$([ "$i" = $# ] && echo 1 || echo 0)
      return 0
    fi
  done
}

# last_stage_start: the lowest failure count that lands on the last stage.
last_stage_start() {
  local total=0 s a n=0
  set -- $STAGES
  for s in "$@"; do IFS=: read -r _ _ a _ <<<"$s"; total=$((total + ${a:-1})); done
  IFS=: read -r _ _ a _ <<<"${*: -1}"
  echo $((total - ${a:-1}))
}
# escalate ID: "work this with Claude" — the failure count set to the first value that
# lands on the last stage, and the bead reopened so the dev queue hands it out there. A
# bead on a lane or waiting for review keeps its place; its next round is the escalated
# one. Noted on the bead, like every other change the loop makes.
escalate() {
  local id=$1 n
  n=$(last_stage_start); stage_for "$n" || die "$SLUG: no stage to escalate to"
  printf '%s\n' "$n" >"$RS/failures/$id"
  bdr update "$id" --append-notes "bead-loop $(date -Iminutes): escalated by hand to the last stage (worker $S_MODEL, reviewer ${S_REVIEW:-none})" >/dev/null
  if [ ! -e "$RS/review/$id" ] && [ "$(cat "$RS/lane.dev" 2>/dev/null)" != "$id" ] && [ "$(cat "$RS/lane.review" 2>/dev/null)" != "$id" ]; then
    bdr update "$id" --status open >/dev/null
  fi
  log "$SLUG: $id: escalated to the last stage — worker $S_MODEL, reviewer ${S_REVIEW:-none} — from its next round"
}

# ---- the three queues ---------------------------------------------------------
# dev:    bd ready -l LABEL — open beads, the label, unblocked. Fewest failures first,
#         then bd's own order: everything is tried once before anything is tried twice,
#         and a bead that keeps failing gets out of the way.
# review: review/ID — the worker committed and the gate passed; the worktree waits for
#         the reviewer. Same order; the file holds the worker's last words for the
#         reviewer's prompt.
# merge:  inflight/ID — the PR url; GitHub's CI is the queue's worker.
# lane.dev / lane.review hold the bead each lane is on right now.
dev_queue() {
  local id
  for id in $(bdr ready -l "$LABEL" --json -n 0 2>/dev/null | jq -r '.[].id'); do
    printf '%s %s\n' "$(failures_of "$id")" "$id"
  done | sort -s -n -k1,1 | cut -d' ' -f2
}
review_queue() {
  local f
  for f in "$RS"/review/*; do
    [ -e "$f" ] || continue
    printf '%s %s %s\n' "$(failures_of "$(basename "$f")")" "$(stat -c %Y "$f")" "$(basename "$f")"
  done | sort -n -k1,1 -k2,2 | cut -d' ' -f3
}
lane_set() { printf '%s\n' "$2" >"$RS/lane.$1"; }
lane_clear() { rm -f "$RS/lane.$1"; }
lane_busy() { [ -e "$RS/lane.$1" ]; }

# ---- the dev lane: one bead, worker + gate, into the review queue ---------------
# dev_one [ID]: returns 0 when a bead was attempted (the lane goes round again), 1
# when the dev queue had nothing for it — empty, or the merge queue is full.
dev_one() {
  local id=${1:-}
  if [ -z "$id" ]; then
    if [ "$(inflight_count)" -ge "$MAX_INFLIGHT" ]; then
      log "$SLUG: dev: $(inflight_count) in flight (max $MAX_INFLIGHT); waiting on CI"; return 1
    fi
    id=$(dev_queue | head -1)
    if [ -z "$id" ]; then log "$SLUG: dev: nothing ready with label $LABEL"; return 1; fi
  fi
  local json title branch wt stamp logf prompt final rc n history resumed=0
  n=$(failures_of "$id")
  if ! stage_for "$n"; then log "$SLUG: $id: stages exhausted ($n failures), parked"; bdr update "$id" --status in_progress >/dev/null; return 0; fi
  MODEL=${MODEL_FLAG:-$S_MODEL}; REVIEW_MODEL=$S_REVIEW; WORKER_TIMEOUT=$S_TIMEOUT
  history=$(tail -n 3 "$RS/failures/$id.notes" 2>/dev/null || true)
  json=$(bdr show "$id" --json)
  [ "$(printf '%s' "$json" | jq 'length')" -gt 0 ] || die "$SLUG: bd show $id returned nothing"
  title=$(printf '%s' "$json" | jq -r '.[0].title')
  branch=bead/$id
  wt=$RS/wt/$id
  stamp=$(date +%Y%m%dT%H%M%S)
  logf=$RS/logs/$id.$stamp
  # A branch left from an earlier round (sent back by review or CI) is resumed, not
  # restarted: the worker fixes its commit. A dev-side failure deleted the branch.
  if git -C "$REPO" show-ref -q "refs/heads/$branch" || git -C "$REPO" show-ref -q "refs/remotes/origin/$branch"; then resumed=1; fi

  prompt=$(cat <<PROMPT
Work the bead below in this repository, following the bead-workflow skill.

<bead>
$(printf '%s' "$json" | render_bead)
</bead>

You are on branch $branch$([ $resumed = 1 ] && printf ', which already carries your earlier commit(s) for this bead: fix them in place rather than starting over' || printf ", a fresh worktree of $BASE"). Commit your work on this branch and leave .beads/ untouched. End your turn with one line: DONE: <evidence> or BLOCKED: <note>.${history:+

Earlier rounds on this bead were sent back; their notes follow. Read them before you start and do not repeat them.

<previous-attempts>
$history
</previous-attempts>}
PROMPT
)
  log "$SLUG: dev: bead $id — $title ($n failures, worker $MODEL, reviewer ${REVIEW_MODEL:-none}$([ $resumed = 1 ] && echo ', resuming the branch'))"
  if [ "$DRY" = 1 ]; then
    printf '%s\n' "--- failures: $n  model: ${MODEL:-agent default}  base: $BASE  setup: ${SETUP:-none}  gate: ${GATE:-none}  review: ${REVIEW_MODEL:-none}  merge: $MERGE" "$prompt"
    return 1
  fi
  LAST_ID=$id
  if [ "$LOCAL" = 0 ]; then need gh; fi

  claim "$id"
  lane_set dev "$id"
  git -C "$REPO" fetch -q origin "$BASE"
  abort_sessions "$wt"  # a killed earlier round may have left one running here
  CUR_WT=$wt
  if [ -d "$wt" ] && [ $resumed = 1 ] && git -C "$wt" rev-parse -q --verify HEAD >/dev/null 2>&1; then
    : # the worktree from the round review sent back, node_modules and all
  else
    if [ -e "$wt" ]; then git -C "$REPO" worktree remove --force "$wt" 2>/dev/null || rm -rf "$wt"; fi
    if [ $resumed = 1 ]; then
      git -C "$REPO" show-ref -q "refs/heads/$branch" || git -C "$REPO" branch -q --track "$branch" "origin/$branch"
      git -C "$REPO" worktree add -q "$wt" "$branch"
    else
      git -C "$REPO" branch -D "$branch" >/dev/null 2>&1 || true
      git -C "$REPO" worktree add -q -b "$branch" "$wt" "origin/$BASE"
    fi
    if [ -n "$SETUP" ]; then
      log "$SLUG: setup: $SETUP"
      if ! (cd "$wt" && bash -c "$SETUP") >"$logf.setup" 2>&1; then
        send_back "$id" "$wt" fresh "setup failed: $SETUP
$(tail -15 "$logf.setup")"; return 0
      fi
    fi
  fi

  rc=0; final=$(run_agent bead-worker "$MODEL" "$wt" "$logf.worker.jsonl" "$prompt" "$id · worker · round $((n + 1))") || rc=$?
  if [ $rc -ne 0 ]; then send_back "$id" "$wt" fresh "worker exited $rc (timeout=$WORKER_TIMEOUT s). Log: $logf.worker.jsonl"; return 0; fi
  if printf '%s' "$final" | grep -q '^BLOCKED:'; then
    send_back "$id" "$wt" fresh "$(printf '%s' "$final" | grep '^BLOCKED:' | tail -1)"; return 0
  fi
  if ! settle_worktree "$wt" "$id: $title"; then
    send_back "$id" "$wt" fresh "worker made no commit. Last words: $(printf '%s' "$final" | tail -3)"; return 0
  fi
  # The gate gets one fix round inside the lane: a compiler message is the cheapest review there is.
  if ! run_gate "$wt" "$logf.gate"; then
    log "$SLUG: $id: gate failed, fix round"
    rc=0; final=$(run_agent bead-worker "$MODEL" "$wt" "$logf.worker-gate.jsonl" "$prompt

Your commit on this branch failed the repository's gate: \`$GATE\`. Fix exactly what it reports, run it again until it passes, commit, and end with DONE: or BLOCKED:.

<gate-output>
$(tail -40 "$logf.gate")
</gate-output>" "$id · worker · gate fix") || rc=$?
    if [ $rc -ne 0 ]; then send_back "$id" "$wt" fresh "worker exited $rc in gate fix round. Log: $logf.worker-gate.jsonl"; return 0; fi
    if printf '%s' "$final" | grep -q '^BLOCKED:'; then
      send_back "$id" "$wt" fresh "gate fix round: $(printf '%s' "$final" | grep '^BLOCKED:' | tail -1)"; return 0
    fi
    settle_worktree "$wt" "$id: fix the gate" || true
    if ! run_gate "$wt" "$logf.gate-2"; then
      send_back "$id" "$wt" fresh "gate failed twice: $GATE
$(tail -15 "$logf.gate-2")"; return 0
    fi
  fi

  # Into the review queue, with the worker's last words for the reviewer.
  printf '%s\n' "$final" | grep '^DONE:' | tail -1 >"$RS/review/$id"
  lane_clear dev; CUR_WT=
  log "$SLUG: $id: gate passed → review queue (${REVIEW_MODEL:-no reviewer: straight to PR})"
}

# ---- the review lane: one bead, the reviewer's verdict, into the merge queue -------
# review_one [ID]: returns 0 when a bead was reviewed, 1 when the queue was empty.
review_one() {
  local id=${1:-}
  if [ -z "$id" ]; then
    id=$(review_queue | head -1)
    [ -n "$id" ] || return 1
  fi
  local json title branch wt stamp logf final verdict rc n
  n=$(failures_of "$id")
  stage_for "$n" || { S_REVIEW=$REVIEW_MODEL; S_MODEL=$MODEL; }
  REVIEW_MODEL=$S_REVIEW; MODEL=${MODEL_FLAG:-$S_MODEL}; WORKER_TIMEOUT=${S_TIMEOUT:-$WORKER_TIMEOUT}
  branch=bead/$id; wt=$RS/wt/$id
  stamp=$(date +%Y%m%dT%H%M%S); logf=$RS/logs/$id.$stamp
  final=$(cat "$RS/review/$id" 2>/dev/null || true)
  json=$(bdr show "$id" --json)
  title=$(printf '%s' "$json" | jq -r '.[0].title')
  lane_set review "$id"; CUR_WT=$wt
  if [ -n "$REVIEW_MODEL" ]; then
    log "$SLUG: review: $id by $REVIEW_MODEL ($n failures)"
    rc=0; verdict=$(run_agent bead-reviewer "$REVIEW_MODEL" "$wt" "$logf.review.jsonl" "Review the commit(s) on this branch for the bead below. The diff against $BASE is under <diff>; read any file you need for context.

<bead>
$(printf '%s' "$json" | render_bead)
</bead>

<worker-report>
$final
</worker-report>

<diff>
$(git -C "$wt" diff "origin/$BASE...HEAD" --stat; git -C "$wt" diff "origin/$BASE...HEAD" | head -c 60000)
</diff>

End with one line: APPROVE: <what you checked> or REJECT: <file:line, what is wrong, what would fix it>." "$id · reviewer · round $((n + 1))") || rc=$?
    if [ $rc -ne 0 ]; then
      rm -f "$RS/review/$id"; send_back "$id" "$wt" keep "reviewer exited $rc. Log: $logf.review.jsonl"; return 0
    fi
    if ! printf '%s' "$verdict" | grep -q '^APPROVE:'; then
      rm -f "$RS/review/$id"
      send_back "$id" "$wt" keep "review ($REVIEW_MODEL) rejected: $(printf '%s' "$verdict" | grep '^REJECT:' | tail -1 | cut -c1-600)"; return 0
    fi
    log "$SLUG: $id: review approved"
  else
    verdict=''
  fi
  rm -f "$RS/review/$id"

  if [ "$LOCAL" = 1 ]; then
    log "$SLUG: --local: branch $branch is ready in $wt; nothing pushed"
    bdr update "$id" --append-notes "bead-loop: worked locally on $branch (not pushed)" >/dev/null
    lane_clear review; CUR_WT=; return 0
  fi

  git -C "$wt" push -q -u origin "$branch" --force-with-lease
  local body url num
  body=$(cat <<BODY
Bead \`$id\`: $title

$(printf '%s' "$json" | jq -r '.[0].acceptance_criteria // ""' | sed 's/^/> /')

Worker: $(printf '%s' "$final" | tail -1 | cut -c1-500)
${REVIEW_MODEL:+Reviewer ($REVIEW_MODEL): $(printf '%s' "${verdict:-}" | grep '^APPROVE:' | tail -1 | cut -c1-500)}

Opened by bead-loop; the bead closes when this merges.
BODY
)
  # A branch sent back by CI already has its PR: the push updated it.
  url=$(ghr pr list --state open --head "$branch" --json url --jq '.[0].url // empty' 2>/dev/null || true)
  if [ -n "$url" ]; then
    log "$SLUG: $id: pushed a new round to $url"
    bdr comment "$id" "bead-loop: pushed round $((n + 1)) to $url" >/dev/null
  else
    url=$(ghr pr create --base "$BASE" --head "$branch" --title "$id: $title" --body "$body")
    bdr comment "$id" "bead-loop: opened $url" >/dev/null
    log "$SLUG: opened $url"
  fi
  num=${url##*/}
  printf '%s\n' "$url" >"$RS/inflight/$id"
  rm -f "$(mark "$id" red)" "$(mark "$id" fixing)"
  if [ "$MERGE" = pipeline ]; then hand_to_pipeline "$id" "$num" "$url"; fi
  git -C "$REPO" worktree remove --force "$wt"
  lane_clear review; CUR_WT=
}

# send_back ID WT fresh|keep NOTE: a round failed. The failure count goes up, the note
# goes on the bead and into the history the next worker reads, and the bead goes back
# to the dev queue (bd open) — on a later stage once this one's failures are spent —
# or is parked (in_progress) when the stages are exhausted, or when the last stage said
# BLOCKED: a claim in the bead is false, and no model fixes that. `keep` leaves the
# branch and worktree for the worker to fix (review and CI send-backs); `fresh` removes
# them (dev-side failures start over).
send_back() {
  local id=$1 wt=$2 mode=$3 note=$4 n
  n=$(( $(failures_of "$id") + 1 ))
  log "$SLUG: $id round $n stopped: $(printf '%s' "$note" | head -1)"
  bdr update "$id" --append-notes "bead-loop round $n ($MODEL) $(date -Iminutes): $note" >/dev/null
  printf '%s\n' "$n" >"$RS/failures/$id"
  printf 'round %s (%s): %s\n' "$n" "$MODEL" "$(printf '%s' "$note" | tr '\n' ' ' | cut -c1-600)" >>"$RS/failures/$id.notes"
  lane_clear dev; lane_clear review; CUR_WT=
  if [ "$mode" = fresh ]; then
    git -C "$REPO" worktree remove --force "$wt" 2>/dev/null || true
    git -C "$REPO" branch -D "bead/$id" >/dev/null 2>&1 || true
  fi
  if [ "$S_LAST" = 1 ] && printf '%s' "$note" | grep -q 'BLOCKED:'; then
    log "$SLUG: $id: BLOCKED at the last stage, parked for you"; park_cleanup "$id" "$wt"; return 0
  fi
  if stage_for "$n"; then
    bdr update "$id" --status open >/dev/null
    log "$SLUG: $id: → dev queue ($n failures; next: worker $S_MODEL, reviewer ${S_REVIEW:-none})"
  else
    log "$SLUG: $id: stages exhausted ($n failures), parked for you"; park_cleanup "$id" "$wt"
  fi
}
park_cleanup() { git -C "$REPO" worktree remove --force "$2" 2>/dev/null || true; }

# ---- the merge queue: reconcile open PRs ---------------------------------------
# close_merged ID INFLIGHT_FILE URL PR_JSON: the bead is done; say what CI said at the merge.
close_merged() {
  local checks
  checks=$(printf '%s' "$4" | jq -r '[.statusCheckRollup[]? | "\(.context // .name)=\(.conclusion // .state)"] | join(" ") | if . == "" then "none reported" else . end')
  # An adopted bead may already be closed by whoever wrote the PR; that is fine.
  bdr close "$1" --reason "bead-loop: $3 merged; checks at merge: $checks" >/dev/null 2>&1 || true
  rm -f "$2" "$(mark "$1" red)" "$(mark "$1" nocheck)" "$(mark "$1" adopted)"
  git -C "$REPO" branch -D "bead/$1" >/dev/null 2>&1 || true
  log "$SLUG: $1 closed ($3 merged; $checks)"
}

# hand_to_pipeline ID NUM URL: merge = "pipeline". The loop labels the PR and the CI
# pipeline merges it on its own terms; the tick only closes the bead once it is MERGED.
# A label the repo does not have cannot be added: noted, and the PR waits for you.
hand_to_pipeline() {
  if ghr pr edit "$2" --add-label "$MERGE_LABEL" >/dev/null 2>&1; then
    log "$SLUG: $1: labelled $MERGE_LABEL on $3; the pipeline merges it"
  else
    bdr update "$1" --append-notes "bead-loop: could not label $3 with $MERGE_LABEL (does the repo have that label?); the pipeline will not merge it, so it waits for you" >/dev/null
    log "$SLUG: $1: could not label $3 with $MERGE_LABEL; waiting for you"
  fi
}

# adopt: any open PR on a bead/<id>[-slug] branch this loop did not open (another
# session, a human) joins the merge queue, so green merges and the bead closes
# whoever wrote it. adopt = false in .bead-loop.toml turns it off.
adopt() {
  [ "$ADOPT" = true ] || return 0
  local num head url id
  while IFS=$'\t' read -r num head url; do
    [ -n "$num" ] || continue
    id=$(printf '%s' "$head" | sed -nE 's|^bead/([a-z]+-[a-z0-9]+(\.[0-9]+)?)(-.*)?$|\1|p')
    [ -n "$id" ] || continue
    [ -e "$RS/inflight/$id" ] && continue
    # A branch of ours sent back to dev is not adopted: dev is fixing it.
    [ -e "$(mark "$id" fixing)" ] && continue
    printf '%s\n' "$url" >"$RS/inflight/$id"; touch "$(mark "$id" adopted)"
    log "$SLUG: adopted $url ($head) as bead $id"
    if [ "$MERGE" = pipeline ]; then hand_to_pipeline "$id" "$num" "$url"; fi
  done < <(ghr pr list --state open --limit 100 --json number,headRefName,url \
             --jq '.[] | select(.headRefName | startswith("bead/")) | [.number, .headRefName, .url] | @tsv' 2>/dev/null || true)
}

reconcile() {
  local f id url num view state verdict checks
  adopt
  for f in "$RS"/inflight/*; do
    [ -e "$f" ] || continue
    id=$(basename "$f"); url=$(cat "$f"); num=${url##*/}
    need gh
    view=$(ghr pr view "$num" --json state,mergedAt,mergeStateStatus,statusCheckRollup,url) || { log "$SLUG: cannot read PR $num"; continue; }
    state=$(printf '%s' "$view" | jq -r .state)
    case $state in
      MERGED) close_merged "$id" "$f" "$url" "$view" ;;
      CLOSED)
        bdr update "$id" --append-notes "bead-loop: $url was closed without merging; left in_progress for you" >/dev/null
        rm -f "$f" "$(mark "$id" red)" "$(mark "$id" nocheck)" "$(mark "$id" adopted)"
        log "$SLUG: $id: PR closed unmerged, parked for you"
        ;;
      OPEN)
        verdict=$(printf '%s' "$view" | jq -r '
          [.statusCheckRollup[]? | (.conclusion // .state // .status)] as $c
          | if ($c | any(IN("FAILURE","ERROR","CANCELLED","TIMED_OUT","ACTION_REQUIRED","STARTUP_FAILURE"))) then "red"
            elif ($c | length) == 0 then "nocheck"
            elif ($c | all(IN("SUCCESS","NEUTRAL","SKIPPED"))) then "green"
            else "pending" end')
        case $verdict in
          green)
            if [ "$MERGE" = auto ]; then
              if [ "$(printf '%s' "$view" | jq -r .mergeStateStatus)" = BEHIND ]; then
                ghr pr update-branch "$num" >/dev/null 2>&1 && log "$SLUG: $id: updated branch, CI reruns" || log "$SLUG: $id: update-branch failed"
              elif ghr pr merge "$num" --squash --delete-branch >/dev/null 2>&1; then
                close_merged "$id" "$f" "$url" "$view"
              else
                log "$SLUG: $id: green but merge refused ($(printf '%s' "$view" | jq -r .mergeStateStatus))"
              fi
            else
              log "$SLUG: $id: green, merge is $MERGE, waiting for $([ "$MERGE" = pipeline ] && echo "the pipeline" || echo you): $url"
            fi
            ;;
          red)
            checks=$(printf '%s' "$view" | jq -r '[.statusCheckRollup[]? | select((.conclusion // .state // .status) | IN("FAILURE","ERROR","CANCELLED","TIMED_OUT","ACTION_REQUIRED","STARTUP_FAILURE")) | (.context // .name)] | join(", ")')
            if [ -e "$(mark "$id" adopted)" ]; then
              # Not our branch to fix: one note, the PR waits for whoever opened it.
              if [ ! -e "$(mark "$id" red)" ]; then
                bdr update "$id" --append-notes "bead-loop: CI red on $url ($checks); PR left open" >/dev/null
                touch "$(mark "$id" red)"; log "$SLUG: $id: CI red on adopted $url"
              fi
            else
              # Ours: back to the dev queue on the same branch; the next push updates this PR.
              rm -f "$f" "$(mark "$id" nocheck)"; touch "$(mark "$id" fixing)"
              stage_for "$(failures_of "$id")" || true; MODEL=${S_MODEL:-$MODEL}
              log "$SLUG: $id: CI red on $url ($checks)"
              send_back "$id" "$RS/wt/$id" keep "CI red on $url: $checks"
            fi
            ;;
          nocheck)
            if [ ! -e "$(mark "$id" nocheck)" ]; then
              bdr update "$id" --append-notes "bead-loop: $url reports no CI checks, so nothing proves it green; merge it yourself or set merge = \"manual\"" >/dev/null
              touch "$(mark "$id" nocheck)"; log "$SLUG: $id: no checks on $url"
            fi
            ;;
          *) log "$SLUG: $id: CI pending on $url" ;;
        esac
        ;;
    esac
  done
}

# ---- lanes -----------------------------------------------------------------------
# lane NAME: run one lane's passes over every repo until its queue is empty and the
# other lane is idle too (the other lane may still send something this way). Each
# lane has its own lock, so `work` by hand and a running tick do not collide.
lane() {
  local name=$1 other moved r idle=0
  other=$([ "$name" = dev ] && echo review || echo dev)
  LANE=$name; trap on_signal TERM INT
  exec 8>"$STATE_DIR/lock.$name"
  flock -n 8 || { log "another $name lane holds $STATE_DIR/lock.$name; skipping"; return 0; }
  while :; do
    # Paused by hand (pause NAME, or the UI): start nothing new; this lane is done for the
    # tick. The other lane goes on, and the next tick after resume picks up here.
    if [ -e "$STATE_DIR/pause.$name" ]; then log "$name lane paused; starting nothing"; return 0; fi
    moved=0
    for r in "${REPOS[@]}"; do
      load_repo "$r"
      if [ "$name" = dev ]; then dev_one && moved=1; else review_one && moved=1; fi
      [ "$moved" = 1 ] && [ "$ONCE" = 1 ] && return 0
    done
    [ "$moved" = 1 ] && { idle=0; continue; }
    [ "$ONCE" = 1 ] && return 0
    # Nothing for this lane now; the other may still hand something over. The other
    # lane looks idle between its rounds too — and at the very start, before it has
    # claimed anything — so this lane leaves only after seeing it idle three checks in a
    # row, LANE_WAIT apart.
    if other_busy "$other"; then idle=0; else idle=$((idle + 1)); fi
    [ "$idle" -ge 3 ] && return 0
    sleep "${LANE_WAIT:-10}"
  done
}
other_busy() { local r; for r in "${REPOS[@]}"; do load_repo "$r"; if lane_busy "$1"; then return 0; fi; done; return 1; }
# tick: reconcile, then both lanes at once — dev fills the review queue while review
# drains it — until neither has anything left; then reconcile once more, so a merge
# that happened meanwhile closes its bead now rather than next tick.
# queued_work: something a lane would take right now — the review queue with the review
# lane not paused, or the dev queue with the dev lane not paused and room in the merge
# queue. The lanes should never both exit while this is true, but a tick checks anyway.
queued_work() {
  local r
  for r in "${REPOS[@]}"; do
    load_repo "$r"
    [ ! -e "$STATE_DIR/pause.review" ] && [ -n "$(review_queue)" ] && return 0
    [ ! -e "$STATE_DIR/pause.dev" ] && [ "$(inflight_count)" -lt "$MAX_INFLIGHT" ] && [ -n "$(dev_queue)" ] && return 0
  done
  return 1
}
tick() {
  local r round=0
  for r in "${REPOS[@]}"; do load_repo "$r"; reconcile; done
  while :; do
    if [ "$SERIAL" = 1 ]; then
      lane dev; lane review
    else
      lane dev & local dp=$!
      lane review & local rp=$!
      wait "$dp" "$rp"
    fi
    round=$((round + 1))
    # Both lanes left. If one left work the other should have taken (a race at startup,
    # a hand-run lane holding a lock), go round once more rather than wait for the timer.
    [ "$ONCE" = 0 ] && [ "$round" -lt 3 ] && queued_work && { log "lanes done but work is queued; going round again"; continue; }
    break
  done
  for r in "${REPOS[@]}"; do load_repo "$r"; reconcile; done
}

# log_follow [ID]: stream the newest session log for the repo as one line per tool call or text.
log_follow() {
  local f
  f=$(ls -t "$RS"/logs/${1:-*}.*.jsonl 2>/dev/null | head -1)
  [ -n "$f" ] || die "$SLUG: no session logs${1:+ for $1}"
  log "$SLUG: following $f (ctrl-c to stop)"
  tail -n +1 -f "$f" | jq --unbuffered -r '
    if .type=="tool_use" then "[\(.part.tool)] \(.part.state.input | (.command // .filePath // .path // .pattern // .description // "") | tostring | .[0:160])"
    elif .type=="text" then "> \(.part.text | .[0:400])"
    elif .type=="step_finish" then "-- step: \(.part.reason)  tokens in=\(.part.tokens.input) out=\(.part.tokens.output)"
    else empty end'
}

# ---- status -------------------------------------------------------------------
# The one description of a repo's state, as JSON: config, PRs in flight, the ready
# queue, parked beads, and every worktree with what the attached opencode server has
# under it. `status` renders it as text; `status --json` prints it for the web UI.

# sessions_json DIR: the server's top-level sessions under DIR, newest first, with the
# state and web UI url worked out. The UI files sessions under the worktree's path,
# base64url-encoded; nobody should have to know that to find one. A session the server
# calls busy with no `opencode run` client left on this box is an orphan: a timeout or a
# kill took the client and the model is still working for nobody.
sessions_json() {
  local dir=$1 busy list clients
  { [ -n "$ATTACH" ] && command -v curl >/dev/null; } || { printf '[]'; return; }
  busy=$(curl -sfG -m 3 "$ATTACH/session/status" --data-urlencode "directory=$dir" 2>/dev/null || echo '{}')
  list=$(curl -sfG -m 3 "$ATTACH/session" --data-urlencode "directory=$dir" 2>/dev/null || echo '[]')
  clients=$(pgrep -fc -- "opencode run --dir $dir " 2>/dev/null || true)
  printf '%s' "$list" | jq -c --argjson busy "$busy" --arg clients "${clients:-0}" \
      --arg url "$ATTACH/$(printf '%s' "$dir" | base64 -w0 | tr '+/' '-_' | tr -d '=')" '
    [.[] | select(.parentID == null)] | sort_by(-.time.updated) | .[:4]
    | map({id, agent, model: "\(.model.providerID)/\(.model.id)", title: (.title // ""),
           updated: (.time.updated / 1000 | floor),
           state: (if $busy[.id] then (if ($clients | tonumber) > 0 then "busy" else "orphan" end) else "idle" end),
           url: "\($url)/session/\(.id)"})'
}

# status_json: this repo, one JSON object: the three queues in their order, the two
# lanes and what each is on, the parked beads, and every worktree with its sessions.
status_json() {
  local f id dir merge='[]' worktrees='[]' failures='{}' dev='[]' review='[]' lanes='{}' name
  for f in "$RS"/inflight/*; do
    [ -e "$f" ] || continue
    id=$(basename "$f")
    merge=$(printf '%s' "$merge" | jq -c --arg id "$id" --arg url "$(cat "$f")" \
      --argjson red "$([ -e "$(mark "$id" red)" ] && echo true || echo false)" \
      --argjson adopted "$([ -e "$(mark "$id" adopted)" ] && echo true || echo false)" \
      '. + [{id: $id, url: $url, red: $red, adopted: $adopted}]')
  done
  for f in "$RS"/failures/*; do
    [ -e "$f" ] || continue; case $f in *.notes) continue ;; esac
    failures=$(printf '%s' "$failures" | jq -c --arg id "$(basename "$f")" --arg n "$(cat "$f")" '. + {($id): ($n | tonumber)}')
  done
  for dir in "$RS"/wt/*/; do
    dir=${dir%/}; [ -d "$dir" ] || continue; id=$(basename "$dir")
    worktrees=$(printf '%s' "$worktrees" | jq -c --arg id "$id" --arg dir "$dir" --argjson n "$(failures_of "$id")" \
      --argjson s "$(sessions_json "$dir")" '. + [{id: $id, dir: $dir, failures: $n, sessions: $s}]')
  done
  # The queues in the order the lanes take them.
  dev=$(dev_queue | jq -R . | jq -sc .)
  for id in $(review_queue); do
    review=$(printf '%s' "$review" | jq -c --arg id "$id" --arg since "$(stat -c %Y "$RS/review/$id" 2>/dev/null || echo 0)" '. + [{id: $id, since: ($since | tonumber)}]')
  done
  for name in dev review; do
    if [ -e "$RS/lane.$name" ]; then
      lanes=$(printf '%s' "$lanes" | jq -c --arg n "$name" --arg id "$(cat "$RS/lane.$name")" --arg since "$(stat -c %Y "$RS/lane.$name")" '. + {($n): {id: $id, since: ($since | tonumber)}}')
    fi
  done
  jq -cn --arg slug "$SLUG" --arg repo "$REPO" --arg label "$LABEL" --arg base "$BASE" --arg merge_mode "$MERGE" \
    --arg stages "$STAGES" --arg attach "$ATTACH" --argjson max_inflight "$MAX_INFLIGHT" --arg on_exhaust "$ON_EXHAUST" \
    --argjson merge "$merge" --argjson failures "$failures" --argjson worktrees "$worktrees" \
    --argjson dev "$dev" --argjson review "$review" --argjson lanes "$lanes" \
    --argjson paused "{\"dev\": $([ -e "$STATE_DIR/pause.dev" ] && echo true || echo false), \"review\": $([ -e "$STATE_DIR/pause.review" ] && echo true || echo false)}" \
    --argjson open "$(bdr ready -l "$LABEL" --json -n 0 2>/dev/null | jq -c '. // []' 2>/dev/null || echo '[]')" \
    --argjson inprog "$(bdr list --status in_progress -l "$LABEL" --json -n 0 2>/dev/null | jq -c '. // []' 2>/dev/null || echo '[]')" '
    ($stages | split(" ") | map(split(":") | {worker: .[0], reviewer: .[1], failures: (.[2] | tonumber)})) as $st
    # stage_for, in jq: the stage a failure count lands on (null when exhausted and on_exhaust = park).
    | def stage_of($n): ($st | map(.failures) | add) as $total
        | (if $n >= $total then (if $on_exhaust == "repeat" then ($n % $total) else null end) else $n end) as $k
        | if $k == null then null else (reduce $st[] as $s ({i: 0, count: 0, hit: null}; if .hit == null then (.count += $s.failures | .i += 1 | if $k < .count then .hit = ($s + {index: .i}) else . end) else . end) | .hit) end;
    def bead($b): {id: $b.id, title: $b.title, priority: $b.priority, failures: ($failures[$b.id] // 0), stage: stage_of($failures[$b.id] // 0)};
    # why: the last note the loop left on the bead — every send-back and every parking writes one,
    # "bead-loop [round N (model)] <date>: <what happened>" — split into when and what.
    def why($b): ($b.notes // "" | split("\n") | map(select(startswith("bead-loop"))) | last // null)
      | if . == null then null else (capture("^bead-loop(?<round> round [0-9]+ \\([^)]*\\))? (?<when>[0-9T:+-]+): (?<what>.*)$") // {when: null, what: .}) end;
    ($open + $inprog | map({(.id): .}) | add // {}) as $byid
    | ($lanes | [.[]?.id]) as $laneids
    | {slug: $slug, repo: $repo, label: $label, base: $base, merge: $merge_mode, attach: $attach, max_inflight: $max_inflight,
       stages: $st, on_exhaust: $on_exhaust,
       lanes: ($lanes | with_entries(.value += (bead($byid[.value.id] // {id: .value.id})))), paused: $paused,
       queues: {
         dev:    ($dev | map(select(. as $i | $laneids + ($merge | map(.id)) + ($review | map(.id)) | index($i) | not) | bead($byid[.] // {id: .}))),
         review: ($review | map(select(.id as $i | $laneids | index($i) | not) | . + bead($byid[.id] // {id: .id}))),
         merge:  ($merge | map(. + {failures: ($failures[.id] // 0), title: ($byid[.id].title // "")}))
       },
       parked: ($inprog | map(select(.id as $i | ($merge | map(.id)) + $laneids + ($review | map(.id)) | index($i) | not) | bead(.) + {why: why(.)})),
       worktrees: $worktrees}'
}

# status_one: status_json as text.
status_one() {
  status_json | jq -r '
    def pad(n): .[0:n] | . + " " * (n - length);
    def age: (now - .) | if . < 90 then "\(.|floor)s" elif . < 5400 then "\(. / 60 | floor)m" else "\(. / 3600 | floor)h" end;
    def q($name; $list): "  \($name) queue (\($list | length)):" + (if ($list | length) == 0 then "  —" else "" end),
      ($list | to_entries[] | "    \(.key + 1 | tostring | pad(3)) \(.value.id | pad(14)) \(.value.failures)× \(.value.stage.worker // "—" | pad(14)) \(.value.title // "" | pad(60))");
    "\(.slug)  label=\(.label) base=\(.base) merge=\(.merge) stages=\(.stages | map("\(.worker)⇢\(.reviewer | if . == "" then "none" else . end)×\(.failures)") | join(" → "))",
    "  dev lane:    \(.lanes.dev // {} | if .id then "\(.id) \(.title // "") (\(.since | age))" else "idle" end)\(if .paused.dev then "  [paused]" else "" end)",
    "  review lane: \(.lanes.review // {} | if .id then "\(.id) \(.title // "") (\(.since | age))" else "idle" end)\(if .paused.review then "  [paused]" else "" end)",
    q("dev"; .queues.dev), q("review"; .queues.review),
    "  merge queue (\(.queues.merge | length)):" + (if (.queues.merge | length) == 0 then "  —" else "" end),
    (.queues.merge[] | "    \(.id | pad(14)) \(.url)\(if .red then "  [red]" else "" end)\(if .adopted then "  [adopted]" else "" end)"),
    (if (.parked | length) > 0 then "  parked:", (.parked[] | "    \(.id | pad(14)) \(.why.what // "(no note from the loop)" | .[0:140])") else empty end),
    (.attach as $attach | .worktrees[] |
      (.sessions[] | select(.state != "idle") |
        "  \(.state | ascii_upcase | if . == "ORPHAN" then . else ascii_downcase | pad(6) end)  \(.agent // "?" | pad(13))  \(.model | pad(18))  \("\(.updated | age) ago" | pad(7))  \(.title | pad(40))  \(.url)"
        + (if .state == "orphan" then "\n          no client on this box; stop it:  curl -X POST \($attach)/session/\(.id)/abort" else "" end)))'
}

# watch: status every few seconds, with the last supervisor log lines above it.
watch_loop() {
  local r
  while :; do
    printf '\033[H\033[J%s   bead-supervisor watch (every %ss, ctrl-c to stop)\n\n' "$(date +%H:%M:%S)" "$WATCH_INTERVAL"
    if command -v journalctl >/dev/null; then
      journalctl --user -u bead-supervisor.service -o cat -n 8 --no-pager 2>/dev/null | cut -c1-"${COLUMNS:-200}"
      printf '\n'
    fi
    for r in "${REPOS[@]}"; do load_repo "$r"; status_one; done
    sleep "$WATCH_INTERVAL"
  done
}

# ---- main --------------------------------------------------------------------
exec 9>"$STATE_DIR/lock"
case $CMD in status|log|watch|lane|pause|resume|escalate) ;; *)
  flock -n 9 || { log "another bead-supervisor holds $STATE_DIR/lock; skipping this tick"; exit 0; } ;;
esac
case $CMD in
  tick)      tick ;;  # reconcile, both lanes side by side until drained, reconcile
  # work: one bead through both lanes, in this process, in order: what --local and a
  # hand-run check want. A bead the dev lane sends back stops there.
  work)      load_repo "${REPOS[0]}"
             if dev_one "${REPOS[1]:-}" && [ -e "$RS/review/$LAST_ID" ]; then review_one "$LAST_ID"; fi ;;
  lane)      case ${LANE_NAME:-} in dev|review) lane "$LANE_NAME" ;; *) die "lane dev or lane review" ;; esac ;;
  pause)     case ${LANE_NAME:-} in dev|review) touch "$STATE_DIR/pause.$LANE_NAME"; log "$LANE_NAME lane paused: it starts no new round until resume" ;; *) die "pause dev or pause review" ;; esac ;;
  escalate)  load_repo "${REPOS[0]}"; [ -n "${REPOS[1]:-}" ] || die "escalate REPO ID"; escalate "${REPOS[1]}" ;;
  resume)    case ${LANE_NAME:-} in dev|review) rm -f "$STATE_DIR/pause.$LANE_NAME"; log "$LANE_NAME lane resumed; the next tick picks it up" ;; *) die "resume dev or resume review" ;; esac ;;
  reconcile) for r in "${REPOS[@]}"; do load_repo "$r"; reconcile; done ;;
  status)    for r in "${REPOS[@]}"; do load_repo "$r"; if [ "$JSON" = 1 ]; then status_json; else status_one; fi; done ;;
  watch)     WATCH_INTERVAL=${BEAD_LOOP_WATCH:-5}; watch_loop ;;
  log)       load_repo "${REPOS[0]}"; log_follow "${REPOS[1]:-}" ;;
  *) die "unknown command $CMD" ;;
esac
