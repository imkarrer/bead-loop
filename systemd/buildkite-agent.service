[Unit]
Description=Buildkite agent on this box (queue devbox): deploys bead-loop here after every merge to main
After=network-online.target

[Service]
# The agent from this checkout's flox env, as this user, so `systemctl --user` in a
# deploy step reaches the loop's units. The token and the rest of the config live in
# ~/.config/buildkite-agent/buildkite-agent.cfg (systemd/buildkite-agent.cfg.example;
# the token is the org's agent token from buildkite.com/organizations/<org>/agents).
ExecStart=/run/current-system/sw/bin/flox activate -d %h/src/bead-loop -- buildkite-agent start --config %h/.config/buildkite-agent/buildkite-agent.cfg
Restart=always
RestartSec=10
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
