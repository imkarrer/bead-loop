[Unit]
Description=bead-loop: deploy origin/main to this box when it has moved (pull, build, install, recycle the stack)

[Service]
# The pipeline merges on the shared agent (ac-box); this box pulls. scripts/deploy.sh
# exits at once when origin/main is what the live checkout already runs, so the timer's
# usual firing costs one git fetch. cargo, flox and git come from the login profile.
Type=oneshot
ExecStart=%h/src/bead-loop/scripts/deploy.sh
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin
