# ~/.config/buildkite-agent/buildkite-agent.cfg — the deploy agent on the box the loop
# runs on. Copy this file there, put the org's agent token in, then:
#   systemctl --user enable --now buildkite-agent.service
# The pipeline's deploy step targets queue=devbox; nothing else is ever sent here.
token="xxx"
name="devbox"
tags="queue=devbox"
build-path="/home/nixos/.cache/buildkite/builds"
plugins-path="/home/nixos/.cache/buildkite/plugins"
hooks-path="/home/nixos/.config/buildkite-agent/hooks"
# One job at a time: a deploy restarts the loop, two at once would race.
spawn=1
