[Unit]
Description=bead-loop web UI: the loop on one page at http://127.0.0.1:4097, with abort / tick / pause / reopen
After=network.target

[Service]
# node for the server; bead-supervisor (and through it bd, jq, yq, gh, curl) come from
# @HERE@/.flox/env/manifest.toml, the same way on every box; systemctl and
# journalctl, for what it shows, are on the system PATH flox activate inherits.
ExecStart=/run/current-system/sw/bin/flox activate -d @HERE@ -- bead-loop-ui
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
