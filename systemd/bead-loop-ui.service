[Unit]
Description=bead-loop web UI: the loop on one page at http://127.0.0.1:4097, with abort / tick / pause / reopen
After=network.target

[Service]
ExecStart=%h/src/bead-loop/bin/bead-loop-ui
# node for the server; bead-supervisor (and through it bd, jq, yq, gh, curl), systemctl, journalctl for what it shows.
Environment=PATH=%h/.local/bin:%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
