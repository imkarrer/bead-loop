[Unit]
Description=bead-loop: work one labelled bead per repo, merge green PRs, close beads
After=network-online.target

[Service]
Type=oneshot
ExecStart=%h/src/bead-loop/bin/bead-supervisor tick
# opencode, bd, gh, jq, git come from the login profile.
Environment=PATH=%h/.nix-profile/bin:/run/current-system/sw/bin:/usr/bin:/bin
