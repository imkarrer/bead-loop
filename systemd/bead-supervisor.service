[Unit]
Description=bead-loop: the resident loop — work labelled beads, merge green PRs, close beads
After=network-online.target

[Service]
# The loop stays up: lanes block on the bell when their queues are empty, the merge
# watcher polls GitHub while a PR is in flight. `systemctl stop` aborts the model
# sessions the lanes are on (the TERM handler) and the next start recovers the rounds
# it cut short, with no failure charged.
Type=simple
# flox activate resolves bd, gh, opencode, git, curl and the binary itself from
# @HERE@/.flox/env/manifest.toml, the same way on every box; only flox's own
# path (a NixOS system fact, not a login profile) is hardcoded.
ExecStart=/run/current-system/sw/bin/flox activate -d @HERE@ -- bead-supervisor run
Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
